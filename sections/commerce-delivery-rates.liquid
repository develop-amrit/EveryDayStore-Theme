<section class="page-width dc-section dc-rates" aria-labelledby="Rates-{{ section.id }}">
  <div><h2 id="Rates-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p class="dc-rates__intro">{{ section.settings.intro | escape }}</p></div>
  <div class="dc-rates__layout">
    {% render 'qc-delivery-tiers' %}
    <div class="dc-rates__note"><h3>{{ section.settings.note_heading | escape }}</h3><p>{{ section.settings.note | escape }}</p></div>
  </div>
</section>
{% schema %}
{"name":"Commerce delivery fees","settings":[{"type":"text","id":"heading","label":"Heading","default":"A clear view of delivery fees."},{"type":"textarea","id":"intro","label":"Introduction","default":"Planned launch fees for eligible Dubai addresses. No minimum order value is planned."},{"type":"text","id":"basket_label","label":"Basket column","default":"Order value"},{"type":"text","id":"fee_label","label":"Fee column","default":"Planned delivery fee"},{"type":"text","id":"note_heading","label":"Note heading","default":"Before orders open"},{"type":"textarea","id":"note","label":"Note","default":"These are proposed fees, not a checkout quote. Service areas and how discounts and tax affect the thresholds still need confirmation. Next-day delivery depends on the final cutoff and operating schedule."}],"blocks":[{"type":"rate","name":"Fee tier","settings":[{"type":"text","id":"range","label":"Order value range"},{"type":"text","id":"fee","label":"Delivery fee"}]}],"max_blocks":5,"presets":[{"name":"Commerce delivery fees"}]}
{% endschema %}

