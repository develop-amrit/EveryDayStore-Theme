<ep-announcement class="qc-announcement" data-announcement><div class="qc-wrap">{% for block in section.blocks %}<span data-ep-message{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{{ block.settings.text | escape }}{% if block.settings.threshold %} {% assign threshold = settings.qc_free_delivery | times: 100 %}{% render 'ep-money', value: threshold %}{% endif %}{% if block.settings.link != blank %}</a>{% endif %}</span>{% endfor %}<button type="button" data-dismiss aria-label="{{ 'qc.close' | t }}">×</button></div></ep-announcement>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Order today. Delivered next day."
        },
        {
          "type": "checkbox",
          "id": "threshold",
          "label": "Append free delivery threshold",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "fees",
          "label": "Show all delivery fee tiers",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Dubai essentials, delivered next day."
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free delivery on orders from",
            "threshold": true
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "One useful basket. So many everyday favourites."
          }
        }
      ]
    }
  ]
}
{% endschema %}
