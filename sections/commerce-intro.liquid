<section class="page-width dc-section{% if section.settings.compact %} dc-shopping-intro{% endif %}"><div class="dc-intro"><div><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p></div><span class="dc-intro__label">{{ 'commerce.launch_preview' | t }}</span></div>
{% if section.blocks.size > 0 %}<div class="dc-hero-slides" id="DcHero-{{ section.id }}" data-hero-slides>{% for block in section.blocks %}<article class="dc-hero-slide dc-promo" id="DcSlide-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}><div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="button dc-button-light" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>{% endif %}</div>{% if block.settings.image != blank %}{% if forloop.first %}{{ block.settings.image | image_url: width: 960 | image_tag: widths: '360,640,960', sizes: '(max-width: 749px) 90vw, 480px', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ block.settings.image | image_url: width: 960 | image_tag: widths: '360,640,960', sizes: '(max-width: 749px) 90vw, 480px', loading: 'lazy' }}{% endif %}{% endif %}</article>{% endfor %}</div><div class="dc-hero-dots" role="group" aria-label="{{ 'commerce_experience.hero_slides' | t }}">{% for block in section.blocks %}<button type="button" data-hero-target="DcSlide-{{ section.id }}-{{ forloop.index }}" aria-label="{{ block.settings.heading | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">●</button>{% endfor %}</div>{% endif %}</section>
{% schema %}{"name": "Commerce introduction", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Everyday, sorted."}, {"type": "text", "id": "text", "label": "Description", "default": "For your home, your day and everything in between."}, {"type": "checkbox", "id": "compact", "label": "Compact shopping layout", "default": false}], "blocks": [{"type": "slide", "name": "Banner slide", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Your everyday essentials"}, {"type": "text", "id": "text", "label": "Text", "default": "Next-day delivery in Dubai."}, {"type": "image_picker", "id": "image", "label": "Banner image"}, {"type": "url", "id": "link", "label": "Link"}, {"type": "text", "id": "label", "label": "Link label", "default": "Explore"}]}], "max_blocks": 5, "presets": [{"name": "Commerce introduction"}]}{% endschema %}
