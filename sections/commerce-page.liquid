<section class="page-width dc-content"><nav class="dc-breadcrumb" aria-label="{{ 'commerce.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'commerce.home' | t }}</a><span>/</span><span>{{ page.title | escape }}</span></nav><div class="dc-content__layout"><aside class="dc-help-nav"><h2>{{ 'commerce.here_to_help' | t }}</h2>{% assign handles = 'about,delivery,faq,contact,track-order' | split: ',' %}{% for handle in handles %}{% if pages[handle] != blank %}<a href="{{ pages[handle].url }}"{% if page.handle == handle %} aria-current="page"{% endif %}>{% if handle == 'delivery' %}Delivery &amp; Returns{% else %}{{ pages[handle].title | escape }}{% endif %}</a>{% endif %}{% endfor %}</aside><article class="dc-prose"><h1>{{ page.title | escape }}</h1>{{ page.content }}</article></div></section>
{% schema %}{"name":"Commerce content","settings":[]}{% endschema %}