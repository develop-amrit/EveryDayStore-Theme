<section id="ep-home-faq" class="qc-section qc-wrap" aria-labelledby="ep-faq-{{ section.id }}"><div class="qc-faq-layout"><div><span class="qc-eyebrow">{% render 'ep-money-copy', text: section.settings.eyebrow %}</span><h2 id="ep-faq-{{ section.id }}">{% render 'ep-money-copy', text: section.settings.heading %}</h2><p>{% render 'ep-money-copy', text: section.settings.text %}</p></div><div>{% for block in section.blocks %}<details class="qc-faq" {{ block.shopify_attributes }}><summary>{% render 'ep-money-copy', text: block.settings.question %}<span class="ep-faq-chevron" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary><div>{{ block.settings.answer }}{% if block.settings.refund_link and shop.refund_policy.body != blank %}<p><a href="{{ shop.refund_policy.url }}">{{ 'ep4.refund_policy' | t }}</a></p>{% endif %}</div>{% if block.settings.show_fees %}{% render 'qc-delivery-tiers' %}{% endif %}</details>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Delivery and payment FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A few useful answers."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BEFORE YOUR FIRST BASKET"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Introduction",
      "default": "A little clarity for a smoother shop."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "show_fees",
          "label": "Show current delivery fee tiers",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "refund_link",
          "label": "t:ep6.refund_link",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Delivery and payment FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Order today for next-day delivery in supported Dubai areas. Your available delivery date is confirmed during checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is the order cut-off time?",
            "answer": "<p>Check the delivery information shown at checkout for the current cut-off. Orders received after the applicable cut-off move to the next available delivery day.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Which areas of Dubai do you deliver to?",
            "answer": "<p>Choose your area in the header. Final service availability is confirmed using your full delivery address at checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Cash on Delivery is available only when it is offered as a payment method at checkout. Otherwise, choose one of the secure online payment methods shown there.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How much does delivery cost?",
            "answer": "<p>Your delivery fee and eligibility for free delivery are shown before payment. Any applicable delivery conditions are listed at checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if something is not right with my order?",
            "answer": "<p>Please contact our support team using the contact page with your order number and details. Our published returns policy explains eligibility and the next steps.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

