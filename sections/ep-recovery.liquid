<section class="ep-section ep-wrap" aria-labelledby="ep-recovery-title"><h2 id="ep-recovery-title">{{ section.settings.heading | escape }}</h2><form class="qc-search ep-recovery-search" action="{{ routes.search_url }}" role="search"><label class="visually-hidden" for="ep-recovery-query">{{ 'ep.search_products' | t }}</label>{% render 'qc-icon', name: 'search' %}<input type="search" id="ep-recovery-query" name="q" placeholder="{{ 'ep.search_products' | t }}"><button type="submit" aria-label="{{ 'qc.search' | t }}">{% render 'qc-icon', name: 'search' %}</button></form>{% assign used_handles = "," %}<div class="ep-panel-categories ep-recovery-grid">{% for block in section.blocks %}<a class="ep-panel-category ep-tint-{{ block.settings.tint }}" href="{% render 'ep-stock-url', url: block.settings.collection.url %}" {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span class="ep-product-cluster">{% capture cluster %}{% render 'ep-product-cluster', used_handles: used_handles, selected_product: block.settings.product, collection: block.settings.collection, image: block.settings.image, count: 2, title: block.settings.title, icon: block.settings.icon %}{% endcapture %}{{ cluster }}{% assign parts = cluster | split: 'data-ep-cluster-product="' %}{% for part in parts offset: 1 %}{% assign handle = part | split: '"' | first %}{% assign used_handles = used_handles | append: handle | append: ',' %}{% endfor %}</span></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "t:eps.recovery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:ep.heading",
      "default": "Explore everyday essentials"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:ep.title",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "t:ep.icon"
        },
        {
          "type": "text",
          "id": "tint",
          "label": "t:ep.background"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:eps.product_for_image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:eps.recovery"
    }
  ]
}
{% endschema %}
