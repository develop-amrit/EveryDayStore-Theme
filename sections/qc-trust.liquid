<section class="qc-section qc-wrap qc-reveal"><div class="qc-trust">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render 'qc-icon', name: block.settings.icon %}<span><strong>{{ block.settings.heading | escape }}</strong><small>{{ block.settings.text | escape }}</small></span></div>{% endfor %}{% if settings.qc_cod %}<div>{% render 'qc-icon', name: 'check' %}<strong>{{ section.settings.cod_text | escape }}</strong></div>{% endif %}</div></section>
{% schema %}
{
  "name": "Trust strip",
  "settings": [
    {
      "type": "text",
      "id": "cod_text",
      "label": "Cash on Delivery label",
      "default": "Cash on Delivery available"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality guaranteed"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Care in every basket"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "leaf",
              "label": "Quality"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "Next-day delivery",
            "text": "Made for your Dubai routine",
            "icon": "truck"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Quality guaranteed",
            "text": "Carefully selected essentials",
            "icon": "leaf"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Easy returns",
            "text": "Support when you need it",
            "icon": "check"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Secure payments",
            "text": "Checkout with confidence",
            "icon": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}
