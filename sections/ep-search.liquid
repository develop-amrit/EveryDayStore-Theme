{% capture display_terms %}{% render 'ep-search-terms', terms: search.terms %}{% endcapture %}{% capture stock_count %}{% render 'ep-visible-product-count', collection: search, section: section %}{% endcapture %}{% assign stock_count = stock_count | plus: 0 %}
{% assign active_count = 0 %}{% for facet in search.filters %}{% unless facet.param_name == 'filter.v.availability' %}{% assign active_count = active_count | plus: facet.active_values.size %}{% if facet.type == 'price_range' %}{% if facet.min_value.value or facet.max_value.value %}{% assign active_count = active_count | plus: 1 %}{% endif %}{% endif %}{% endunless %}{% endfor %}
<ep-collection class="ep-collection ep-search-results" data-mode="search" data-section="{{ section.id }}" data-department="" data-url="{{ routes.search_url }}" data-page-title="{{ 'eps.search' | t | escape }}: {{ display_terms | escape }} – {{ shop.name | escape }}" data-loading="{{ 'epc.loading' | t }}">
<div class="ep-collection-heading ep-wrap" data-collection-head><h1 class="visually-hidden">{{ 'eps.search' | t }}</h1><p class="ep-search-count">{{ 'eps.results_for' | t: count: stock_count, query: display_terms }}</p></div>
<div class="ep-collection-layout ep-no-rail ep-wrap"><div class="ep-collection-content" data-collection-content tabindex="-1">
{% render 'ep-collection-filters', collection: search, active_count: active_count, id: section.id, count_override: stock_count %}
{% assign query = display_terms | downcase %}<nav class="ep-subcategory-chips" aria-label="{{ 'epc.categories' | t }}">{% for parent in section.settings.search_menu.links %}{% assign label = parent.title | downcase %}{% if query != blank and label contains query %}<a href="{% render 'ep-stock-url', url: parent.url %}">{{ parent.title | escape }}</a>{% endif %}{% for child in parent.links %}{% assign label = child.title | downcase %}{% if query != blank and label contains query %}{% capture allowed %}{% render 'ep-content-visible', item: child.object, kind: 'collection', title: child.title %}{% endcapture %}{% if allowed == '1' %}<a href="{% render 'ep-stock-url', url: child.url %}">{{ child.title | escape }}</a>{% endif %}{% endif %}{% endfor %}{% endfor %}</nav>
{% paginate search.results by 24 %}<nav class="ep-subcategory-chips" aria-label="{{ 'eps.pages' | t }}">{% for result in search.results %}{% unless result.object_type == 'product' %}<a href="{% render 'ep-stock-url', url: result.url %}">{{ result.title | escape }}</a>{% endunless %}{% endfor %}</nav>
<div class="ep-collection-products" data-collection-products>{% assign image_count = 0 %}{% for product in search.results %}{% unless product.object_type == 'product' %}{% continue %}{% endunless %}{% unless product.available %}{% continue %}{% endunless %}{% capture allowed %}{% render 'ep-content-visible', item: product %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign eager = false %}{% if image_count < 6 %}{% assign eager = true %}{% endif %}{% render 'ep-card', product: product, variant: 'grid', eager: eager %}{% assign image_count = image_count | plus: 1 %}{% endfor %}</div>
{% if stock_count == 0 %}<div class="ep-empty-category"><h2>{{ 'eps.no_results' | t: query: display_terms }}</h2>{% if active_count > 0 %}{% assign encoded_terms = search.terms | url_encode %}{% assign reset_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&type=product' %}<a data-ep-clear href="{% render 'ep-stock-url', url: reset_url %}">{{ 'epc.clear_filters' | t }}</a>{% endif %}<div class="ep-subcategory-chips">{% for link in section.settings.search_menu.links limit: 8 %}<a href="{% render 'ep-stock-url', url: link.url %}">{{ link.title | escape }}</a>{% endfor %}</div></div>{% capture cards %}{% render 'ep-stock-cards', collection: section.settings.bestsellers, limit: 8, variant: 'compact' %}{% endcapture %}{% if cards != blank %}<section class="ep-search-suggestions" data-ep-bestsellers="{{ section.settings.bestsellers.url }}"><h2>{{ 'eps.bestsellers' | t }}</h2><div class="ep-rail">{{ cards }}</div></section>{% endif %}{% endif %}
<div class="ep-collection-sentinel" data-collection-sentinel data-next="{{ paginate.next.url }}" data-page="{{ paginate.current_page }}" aria-live="polite">{% if paginate.next %}<a class="ep-load-more" data-ep-load-more href="{% render 'ep-stock-url', url: paginate.next.url %}">{{ 'epc.load_more' | t }}</a>{% elsif stock_count > 0 %}<span>{{ 'eps.search_end' | t }}</span><button type="button" data-ep-grid-top>{{ 'qc.top' | t }}</button>{% endif %}</div><noscript>{% if paginate.next %}<a href="{% render 'ep-stock-url', url: paginate.next.url %}">{{ 'epc.load_more' | t }}</a>{% endif %}</noscript>{% endpaginate %}
</div></div></ep-collection>
{% schema %}
{
  "name": "t:eps.search",
  "settings": [
    {
      "type": "link_list",
      "id": "search_menu",
      "label": "t:eps.popular_menu"
    },
    {
      "type": "collection",
      "id": "bestsellers",
      "label": "t:eps.bestsellers"
    }
  ],
  "presets": [
    {
      "name": "t:eps.search"
    }
  ],
  "enabled_on": {
    "templates": [
      "search"
    ]
  }
}
{% endschema %}
