{% assign active_count = 0 %}{% for facet in search.filters %}{% assign active_count = active_count | plus: facet.active_values.size %}{% endfor %}
<ep-collection class="ep-collection ep-search-results" data-mode="search" data-section="{{ section.id }}" data-department="" data-url="{{ routes.search_url }}" data-page-title="{{ 'eps.search' | t | escape }}: {{ search.terms | escape }} – {{ shop.name | escape }}" data-loading="{{ 'epc.loading' | t }}">
<div class="ep-collection-heading ep-wrap" data-collection-head><h1 class="visually-hidden">{{ 'eps.search' | t }}</h1><p class="ep-search-count">{{ 'eps.results_for' | t: count: search.results_count, query: search.terms }}</p></div>
<div class="ep-collection-layout ep-no-rail ep-wrap"><div class="ep-collection-content" data-collection-content tabindex="-1">
{% render 'ep-collection-filters', collection: search, active_count: active_count, id: section.id, count_override: search.results_count %}
{% assign query = search.terms | downcase %}<nav class="ep-subcategory-chips" aria-label="{{ 'epc.categories' | t }}">{% for parent in section.settings.search_menu.links %}{% assign label = parent.title | downcase %}{% if query != blank and label contains query %}<a href="{{ parent.url }}">{{ parent.title | escape }}</a>{% endif %}{% for child in parent.links %}{% assign label = child.title | downcase %}{% if query != blank and label contains query %}{% capture allowed %}{% render 'ep-content-visible', item: child.object, kind: 'collection', title: child.title %}{% endcapture %}{% if allowed == '1' %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% endif %}{% endif %}{% endfor %}{% endfor %}</nav>
{% paginate search.results by 24 %}<nav class="ep-subcategory-chips" aria-label="{{ 'eps.pages' | t }}">{% for result in search.results %}{% unless result.object_type == 'product' %}<a href="{{ result.url }}">{{ result.title | escape }}</a>{% endunless %}{% endfor %}</nav>
<div class="ep-collection-products" data-collection-products>{% for product in search.results %}{% unless product.object_type == 'product' %}{% continue %}{% endunless %}{% capture allowed %}{% render 'ep-content-visible', item: product %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign eager = false %}{% if forloop.index <= 6 %}{% assign eager = true %}{% endif %}{% render 'ep-card', product: product, variant: 'grid', eager: eager %}{% endfor %}</div>
{% if search.results_count == 0 %}<div class="ep-empty-category"><h2>{{ 'eps.no_results' | t: query: search.terms }}</h2><div class="ep-subcategory-chips">{% for link in section.settings.search_menu.links limit: 8 %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div></div>{% capture cards %}{% render 'ep-stock-cards', collection: section.settings.bestsellers, limit: 8, variant: 'compact' %}{% endcapture %}{% if cards != blank %}<section class="ep-search-suggestions"><h2>{{ 'eps.bestsellers' | t }}</h2><div class="ep-rail">{{ cards }}</div></section>{% endif %}{% endif %}
<div class="ep-collection-sentinel" data-collection-sentinel data-next="{{ paginate.next.url }}" data-page="{{ paginate.current_page }}" aria-live="polite">{% if paginate.next %}<a class="ep-load-more" data-ep-load-more href="{{ paginate.next.url }}">{{ 'epc.load_more' | t }}</a>{% elsif search.results_count > 0 %}<span>{{ 'eps.search_end' | t }}</span><button type="button" data-ep-grid-top>{{ 'qc.top' | t }}</button>{% endif %}</div><noscript>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'epc.load_more' | t }}</a>{% endif %}</noscript>{% endpaginate %}
</div></div></ep-collection>
{% schema %}
{"name":"t:eps.search","settings":[{"type":"link_list","id":"search_menu","label":"t:eps.popular_menu"},{"type":"collection","id":"bestsellers","label":"t:eps.bestsellers"}],"presets":[{"name":"t:eps.search"}]}
{% endschema %}
