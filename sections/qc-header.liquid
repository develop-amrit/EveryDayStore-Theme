{% if request.page_type == 'index' %}<script>window.theme=window.theme||{};window.theme.moneyFormat={{ localization.country.currency.iso_code | default: shop.currency | append: ' __AMOUNT__' | json }};</script>{% endif %}<script src="{{ 'ep-final.js' | asset_url }}" defer></script><ep-header class="qc-header ep-header color-{{ section.settings.color_scheme }}" style="padding-block:{{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px" data-terms="{{ section.settings.rotating_terms | escape }}">{% if request.page_type == 'collection' or request.page_type == 'list_collections' %}<div class="ep-slim-row"><button type="button" data-ep-back data-fallback="{% if request.page_type == 'collection' %}{{ routes.collections_url }}{% else %}{{ routes.root_url }}{% endif %}" aria-label="{{ 'epc.back' | t }}"><span aria-hidden="true">←</span></button><a class="qc-logo ep-slim-logo" href="{{ routes.root_url }}">{% render 'qc-logo', wordmark: section.settings.wordmark %}</a><button type="button" class="ep-slim-area" data-ep-slim-area data-empty="{{ 'epc.choose_area' | t }}"><span>{{ cart.attributes.delivery_zone | default: '' | escape }}</span>{{ 'icon-caret.svg' | inline_asset_content }}</button><button type="button" data-ep-search-toggle aria-controls="qc-search" aria-expanded="false" aria-label="{{ 'qc.search' | t }}">{% render 'qc-icon', name: 'search' %}</button></div>{% endif %}<div class="ep-header-sentinel" aria-hidden="true"></div><div class="ep-upper"><div class="qc-wrap qc-header-row"><a class="qc-logo" href="{{ routes.root_url }}">{% render 'qc-logo', wordmark: section.settings.wordmark %}</a><div class="qc-header-actions"><a href="{{ section.settings.wishlist_link }}" aria-label="{{ 'qc.wishlist' | t }}">{% render 'qc-icon', name: 'heart' %}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="{{ 'qc.account' | t }}">{% render 'qc-icon', name: 'account' %}</a>{% endif %}<a href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'qc.cart' | t }} {{ cart.item_count }}" data-ep-cart-label="{{ 'qc.cart' | t }}">{% render 'qc-icon', name: 'cart' %}<span data-cart-count>{{ cart.item_count }}</span></a></div></div><div class="ep-delivery qc-wrap">{% render 'ep-area-picker', areas: section.settings.areas, delivery_text: section.settings.delivery_text, picker_id: section.id %}</div></div><div class="ep-search-zone qc-wrap">{% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'list_collections' %}<predictive-search class="ep-native-search" data-loading-text="{{ 'ep.loading_products' | t }}">{% endif %}<form class="qc-search" action="{{ routes.search_url }}" role="search"><label class="visually-hidden" for="qc-search">{{ 'ep.search_products' | t }}</label>{% render 'qc-icon', name: 'search' %}<input type="search" id="qc-search" name="q" role="combobox" aria-autocomplete="list" placeholder=" " autocomplete="off" aria-expanded="false" aria-controls="qc-suggestions" {% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'list_collections' %}data-ep-search{% else %}data-search{% endif %}><span class="ep-search-placeholder" aria-hidden="true">{{ 'ep.search_products' | t }}</span><input type="hidden" name="type" value="product">{% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'list_collections' %}<button type="reset" class="ep-search-clear hidden" aria-label="{{ 'ep.clear_search' | t }}">×</button>{% endif %}<button type="submit" aria-label="{{ 'qc.search' | t }}">{% render 'qc-icon', name: 'search' %}</button>{% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'list_collections' %}<div class="ep-predictive-panel" data-predictive-search tabindex="-1"></div><div class="ep-search-skeleton" aria-hidden="true"><span></span><span></span><span></span></div><span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>{% else %}<div id="qc-suggestions" role="listbox" class="qc-suggestions" hidden></div>{% endif %}</form>{% if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'list_collections' %}</predictive-search>{% endif %}</div></ep-header>
{% schema %}
{
  "name": "t:ep.everyday_mobile_header",
  "tag": "div",
  "class": "ep-header-section",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "t:ep.existing_wordmark",
      "default": "everyday"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "t:ep.delivery_text",
      "default": "Delivery tomorrow"
    },
    {
      "type": "textarea",
      "id": "rotating_terms",
      "label": "t:ep.rotating_search_terms",
      "default": "Milk\nDiapers\nChocolates\nShampoo\nFlowers\nCoffee"
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "t:ep.wishlist_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "textarea",
      "id": "areas",
      "label": "t:ep.final_delivery_areas_one_per_line",
      "default": "Dubai Marina\nJLT\nDowntown\nBusiness Bay\nJumeirah\nAl Barsha\nDeira\nDubai Hills\nMirdif\nJVC"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:ep.everyday_mobile_header"
    }
  ]
}
{% endschema %}
