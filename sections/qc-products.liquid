<section class="qc-section qc-wrap qc-reveal{% if section.settings.collection.products_count == 1 %} qc-single-shelf{% endif %}"><div class="qc-section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.view_all | default: section.settings.collection.url }}">{{ 'qc.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% if section.settings.text != blank %}<p class="qc-section-intro">{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.end_time != blank %}<p class="qc-countdown" data-countdown="{{ section.settings.end_time | escape }}">{{ 'qc.ends' | t }} <span></span></p>{% endif %}<div class="qc-products qc-rail" tabindex="0" data-product-section>{% render 'qc-product-list', collection: section.settings.collection, limit: section.settings.limit %}</div><div class="qc-rail-controls"><button data-rail-prev aria-label="{{ 'qc.previous' | t }}">←</button><button data-rail-next aria-label="{{ 'qc.next' | t }}">→</button></div></section>
{% schema %}
{
  "name": "Collection carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The daily favourites"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "view_all",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "Offer end time (ISO 8601 with +04:00 offset)"
    }
  ],
  "presets": [
    {
      "name": "Collection carousel"
    }
  ]
}
{% endschema %}

