{% assign chosen = section.settings.collection %}{% assign limit = section.settings.limit %}{% assign limit = section.settings.rows | times: 6 %}{% assign dest = section.settings.see_all_link | default: chosen.url %}{% if chosen.products_count > 0 or request.design_mode %}{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section ep-product-grid color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, link_url: dest, heading_id: heading_id %}<div class="{% if section.settings.background == 'soft' %}ep-panel {% endif %}ep-products-grid" id="ep-rail-{{ section.id }}" data-rows="{{ section.settings.rows }}" data-columns="{{ section.settings.columns_mobile }}" style="--ep-columns:{{ section.settings.columns_mobile }};--ep-rows:{{ section.settings.rows }}">{% for product in chosen.products limit: limit %}{% render 'ep-card', product: product, variant: section.settings.card_variant %}{% else %}{% if request.design_mode %}{% for i in (1..4) %}<div class="ep-card"><div class="ep-image-well">{{ 'product-1' | placeholder_svg_tag }}</div></div>{% endfor %}{% endif %}{% endfor %}</div>{% if section.settings.show_button %}{% render 'ep-see-all-button', link_url: dest %}{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_product_grid",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:ep.collection"
    },
    {
      "type": "range",
      "id": "rows",
      "label": "t:ep.rows",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:ep.mobile_columns",
      "options": [
        {
          "value": "2",
          "label": "t:ep.2"
        },
        {
          "value": "3",
          "label": "t:ep.3"
        }
      ],
      "default": "3"
    },
    {
      "type": "url",
      "id": "see_all_link",
      "label": "t:ep.see_all_link"
    },
    {
      "type": "select",
      "id": "card_variant",
      "label": "t:ep.card_variant",
      "options": [
        {
          "value": "grid",
          "label": "t:ep.grid"
        },
        {
          "value": "rated",
          "label": "t:ep.rated"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:ep.show_see_all_button",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:ep.background",
      "options": [
        {
          "value": "none",
          "label": "t:ep.none"
        },
        {
          "value": "soft",
          "label": "t:ep.soft"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_product_grid"
    }
  ]
}
{% endschema %}
