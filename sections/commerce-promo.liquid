<section class="page-width dc-section"><div class="dc-promo"><div><p class="dc-promo__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="button dc-button-light" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a></div><div class="dc-promo__art">{% render 'commerce-art', kind:section.settings.illustration %}</div></div></section>
{% schema %}
{"name":"Commerce feature","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"The home reset"},{"type":"text","id":"title","label":"Heading","default":"Restock. Reset. Ready."},{"type":"text","id":"text","label":"Description","default":"The little things that keep your home running."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"label","label":"Button label","default":"Explore home care"},{"type":"select","id":"illustration","label":"Illustration","options":[{"value":"towels","label":"Home care"},{"value":"cable","label":"Tech"},{"value":"pouch","label":"On the go"}],"default":"towels"}],"presets":[{"name":"Commerce feature"}]}
{% endschema %}