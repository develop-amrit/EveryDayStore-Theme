<section class="qc-wrap qc-section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit=8&amp;intent={{ section.settings.intent }}"><div class="qc-section-heading"><h2>{{ section.settings.heading | escape }}</h2></div><div class="qc-products qc-rail" tabindex="0">{% assign shown = 0 %}{% if recommendations.performed and recommendations.products_count > 0 %}{% assign related = recommendations.products %}{% elsif section.settings.intent == 'complementary' %}{% assign related = product.metafields.custom.complementary_products.value %}{% else %}{% assign related = product.metafields.custom.related_products.value %}{% endif %}{% for item in related limit: 8 %}{% if item.id != product.id %}{% if item.available or item.metafields.custom.show_when_sold_out.value == true %}<div class="qc-bundle-card">{% render 'qc-product-card', product: item %}{% if section.settings.intent == 'complementary' and item.available %}<label class="qc-check"><input type="checkbox" data-bundle-id="{{ item.selected_or_first_available_variant.id }}">{{ item.title | escape }}</label>{% endif %}</div>{% assign shown = shown | plus: 1 %}{% endif %}{% endif %}{% endfor %}{% if shown == 0 %}<p class="qc-empty">{{ 'qc.empty_collection' | t }}</p>{% endif %}</div>{% if section.settings.intent == 'complementary' %}<button type="button" class="qc-button" data-bundle-add>{{ 'qc.bundle_add' | t }}</button><p role="status"></p>{% endif %}</section>
{% schema %}
{
  "name": "recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related / alternatives"
        },
        {
          "value": "complementary",
          "label": "Complementary / bought together"
        }
      ],
      "default": "related"
    }
  ],
  "presets": [
    {
      "name": "recommendations"
    }
  ]
}
{% endschema %}
