<section class="page-width dc-content dc-feature-page" data-feature-page="{{ section.settings.feature }}"><nav class="dc-breadcrumb" aria-label="{{ 'commerce.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'commerce.home' | t }}</a><span>/</span><span>{{ page.title | escape }}</span></nav><h1>{{ page.title | default: section.settings.heading | escape }}</h1><p>{{ section.settings.intro | escape }}</p><div>{% render 'qc-legacy-feature', feature: section.settings.feature %}</div><noscript><p>{{ 'commerce_experience.javascript_needed' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'commerce.shop_all' | t }}</a></noscript></section>
{% schema %}
{"name":"Commerce feature page","settings":[{"type":"text","id":"heading","label":"Heading","default":"Your everyday essentials"},{"type":"text","id":"intro","label":"Introduction","default":"Little essentials. One useful basket."},{"type":"select","id":"feature","label":"Feature","options":[{"value":"wishlist","label":"Wishlist"},{"value":"compare","label":"Compare"},{"value":"gifting","label":"Gifting"},{"value":"delivery","label":"Delivery selection"},{"value":"tracking","label":"Order tracking"},{"value":"account","label":"Buy Again"},{"value":"occasions","label":"Occasions"},{"value":"support","label":"Help"}],"default":"wishlist"}],"presets":[{"name":"Commerce feature page"}]}
{% endschema %}

