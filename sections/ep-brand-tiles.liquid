{% capture tiles %}{% for block in section.blocks %}{% assign vendor_stock = true %}{% if section.settings.in_stock_only %}{% assign vendor_stock = false %}{% if block.settings.product.available %}{% assign vendor_stock = true %}{% else %}{% paginate block.settings.collection.products by 250 %}{% for candidate in block.settings.collection.products %}{% if candidate.available and candidate.vendor == block.settings.vendor %}{% assign vendor_stock = true %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}{% endif %}{% if shop.vendors contains block.settings.vendor and vendor_stock %}<a class="ep-brand-tile" href="{{ routes.collections_url }}/vendors?q={{ block.settings.vendor | url_encode }}" {{ block.shopify_attributes }}><span class="ep-ad ep-auto-well">{% assign photo = block.settings.image %}{% if photo == blank and block.settings.product.vendor == block.settings.vendor %}{% assign photo = block.settings.product.featured_image %}{% endif %}{% if photo == blank %}{% paginate block.settings.collection.products by 250 %}{% for candidate in block.settings.collection.products %}{% if candidate.vendor == block.settings.vendor and candidate.featured_image %}{% assign photo = candidate.featured_image %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}{% if photo %}{% capture image_markup %}{{ photo | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '(min-width:750px) 180px, 40vw', alt: block.settings.vendor }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% endif %}{% if block.settings.ad %}<small>{{ 'ep.ad' | t }}</small>{% endif %}</span><strong>{% assign brand_label = block.settings.title | default: block.settings.vendor %}{% render 'ep-money-copy', text: brand_label %}</strong><span>{% render 'ep-money-copy', text: block.settings.caption %}</span></a>{% endif %}{% endfor %}{% endcapture %}{% assign tiles = tiles | strip %}{% if tiles != blank %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 class="ep-brand-heading{% if section.settings.title == blank %} visually-hidden{% endif %}" id="ep-heading-{{ section.id }}">{{ section.settings.title | default: section.settings.accessible_title | escape }}</h2></div><div class="ep-ads ep-rail ep-brand-rail">{{ tiles }}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_brand_tiles",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "accessible_title",
      "label": "t:ep.accessible_title",
      "default": "Featured brands"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    },
    {
      "type": "checkbox",
      "id": "in_stock_only",
      "label": "t:ep4.in_stock_brands",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:ep.brand_tile",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:ep.alternative_text"
        },
        {
          "type": "checkbox",
          "id": "ad",
          "label": "t:ep.show_ad_label",
          "default": false
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.final_auto_image_collection"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "t:ep.final_stocked_vendor_exact_name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:ep.final_caption"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:ep.final_vendor_product_for_auto_image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_brand_tiles"
    }
  ]
}
{% endschema %}
