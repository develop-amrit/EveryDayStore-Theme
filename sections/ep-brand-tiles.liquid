{% capture tiles %}{% for block in section.blocks %}{% if shop.vendors contains block.settings.vendor %}<a class="ep-brand-tile" href="{{ routes.collections_url }}/vendors?q={{ block.settings.vendor | url_encode }}" {{ block.shopify_attributes }}><span class="ep-ad ep-auto-well">{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, product: block.settings.product, vendor: block.settings.vendor, title: block.settings.vendor, exclude_tags: section.settings.exclude_tags %}{% if block.settings.ad %}<small>{{ 'ep.ad' | t }}</small>{% endif %}</span><strong>{{ block.settings.vendor | escape }}</strong><span>{{ block.settings.caption | escape }}</span></a>{% endif %}{% endfor %}{% endcapture %}{% assign tiles = tiles | strip %}{% if tiles != blank %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 id="ep-heading-{{ section.id }}"{% if section.settings.title == blank %} class="visually-hidden"{% endif %}>{{ section.settings.title | default: section.settings.accessible_title | escape }}</h2></div><div class="ep-ads ep-rail">{{ tiles }}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_brand_tiles",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "accessible_title",
      "label": "t:ep.accessible_title",
      "default": "Featured brands"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:ep.brand_tile",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:ep.alternative_text"
        },
        {
          "type": "checkbox",
          "id": "ad",
          "label": "t:ep.show_ad_label",
          "default": false
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.final_auto_image_collection"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "t:ep.final_stocked_vendor_exact_name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:ep.final_caption"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:ep.final_vendor_product_for_auto_image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_brand_tiles"
    }
  ]
}
{% endschema %}
