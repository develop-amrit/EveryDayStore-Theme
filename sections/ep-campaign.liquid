{% assign offers = section.blocks | where: 'type', 'offer_tile' %}{% assign visible = false %}{% for block in offers %}{% if block.settings.image != blank %}{% assign visible = true %}{% endif %}{% endfor %}{% if visible or request.design_mode %}{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><div class="ep-campaign" style="--ep-panel-bg:{{ section.settings.background }};{% if section.settings.background_image %}background-image:url({{ section.settings.background_image | image_url: width: 1200 }}){% endif %}">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}{% if section.settings.heading_image %}{% assign alt = section.settings.heading_image.alt | default: section.settings.title %}{{ section.settings.heading_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '60vw', class: 'ep-campaign-head', alt: alt }}{% endif %}{% if section.settings.powered_label != blank and section.settings.logo != blank %}<div class="ep-powered">{{ section.settings.powered_label | escape }}{{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: section.settings.logo.alt }}</div>{% endif %}<div class="ep-offers">{% for block in offers %}{% if block.settings.image != blank and block.settings.link != blank %}<a class="ep-offer" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% assign alt = block.settings.image.alt | default: block.settings.title %}{{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 240, 360', sizes: '30vw', alt: alt }}{% if block.settings.price_tag != blank %}<span>{{ block.settings.price_tag | escape }}</span>{% endif %}</a>{% endif %}{% endfor %}</div></div></div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_campaign",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "t:ep.heading_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:ep.background_image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ep.background",
      "default": "#FEFAE0"
    },
    {
      "type": "text",
      "id": "powered_label",
      "label": "t:ep.powered_by_label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:ep.partner_logo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "offer_tile",
      "name": "t:ep.offer_tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "text",
          "id": "price_tag",
          "label": "t:ep.price_tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_campaign",
      "blocks": [
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        }
      ]
    }
  ]
}
{% endschema %}
