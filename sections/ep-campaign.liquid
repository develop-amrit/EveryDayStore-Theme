{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><div class="ep-campaign" style="--ep-panel-bg:{{ section.settings.background }}">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}{% if section.settings.heading_image %}{{ section.settings.heading_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '90vw', alt: section.settings.title, class: 'ep-campaign-head' }}{% endif %}{% if section.settings.powered_label != blank and section.settings.logo %}<div class="ep-powered">{{ section.settings.powered_label | escape }}{{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: section.settings.logo.alt }}</div>{% endif %}<div class="ep-offers">{% for block in section.blocks %}<a class="ep-offer" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span class="ep-auto-well">{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, title: block.settings.title %}</span>{% render 'ep-from-price', collection: block.settings.collection %}{% if block.settings.collection.all_products_count == 0 %}<small class="ep-coming-soon">{{ 'ep.coming_soon' | t }}</small>{% endif %}</a>{% endfor %}</div></div></div></section>
{% schema %}
{
  "name": "t:ep.everyday_campaign",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "t:ep.heading_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:ep.background_image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ep.background",
      "default": "#FEFAE0"
    },
    {
      "type": "text",
      "id": "powered_label",
      "label": "t:ep.powered_by_label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:ep.partner_logo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "offer_tile",
      "name": "t:ep.offer_tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Auto image collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_campaign",
      "blocks": [
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        }
      ]
    }
  ]
}
{% endschema %}
