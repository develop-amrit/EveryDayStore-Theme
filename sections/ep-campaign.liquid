{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><div class="ep-campaign" style="--ep-panel-bg:{{ section.settings.background }}">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}{% if section.settings.heading_image %}{{ section.settings.heading_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '90vw', alt: section.settings.title, class: 'ep-campaign-head' }}{% endif %}{% if section.settings.powered_label != blank and section.settings.logo %}<div class="ep-powered">{% render 'ep-money-copy', text: section.settings.powered_label %}{{ section.settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: section.settings.logo.alt }}</div>{% endif %}<div class="ep-offers">{% for block in section.blocks %}{% assign lowest = nil %}{% assign photo = block.settings.image %}{% paginate block.settings.collection.products by 250 %}{% for candidate in block.settings.collection.products %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if candidate.available and allowed == '1' %}{% unless candidate.tags contains section.settings.exclude_tags %}{% for item in candidate.variants %}{% if item.available %}{% if lowest == nil or item.price < lowest %}{% assign lowest = item.price %}{% endif %}{% endif %}{% endfor %}{% if photo == blank and candidate.featured_image %}{% assign photo = candidate.featured_image %}{% endif %}{% endunless %}{% endif %}{% endfor %}{% endpaginate %}{% assign photo = photo | default: block.settings.collection.image %}<a class="ep-offer"{% if block.settings.collection.all_products_count > 250 %} data-ep-stock-prices="{{ block.settings.collection.url }}" data-exclude-tags="{{ section.settings.exclude_tags | default: 'homepage-hide' | escape }}" data-from="{{ 'qc.from' | t | escape }}"{% endif %} href="{% render 'ep-stock-url', url: block.settings.link %}" {{ block.shopify_attributes }}><strong>{% render 'ep-money-copy', text: block.settings.title %}</strong><span class="ep-auto-well">{% if photo %}{% capture image_markup %}{{ photo | image_url: width: 480 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480', sizes: '(min-width:990px) 300px, 27vw', alt: block.settings.title }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}{% render 'ep-icon', name: 'bottle' %}{% endif %}</span><span class="ep-offer-bottom">{% if lowest != nil and block.settings.collection.all_products_count <= 250 %}<small>{{ 'qc.from' | t }}</small>{% render 'ep-money', amount: lowest %}{% else %}<span>{{ 'ep3.shop_now' | t }}</span>{% endif %}</span></a>{% endfor %}</div></div></div></section>
{% schema %}
{
  "name": "t:ep.everyday_campaign",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "t:ep.heading_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:ep.background_image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ep.background",
      "default": "#FEFAE0"
    },
    {
      "type": "text",
      "id": "powered_label",
      "label": "t:ep.powered_by_label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:ep.partner_logo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "offer_tile",
      "name": "t:ep.offer_tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.final_auto_image_collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_campaign",
      "blocks": [
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        },
        {
          "type": "offer_tile"
        }
      ]
    }
  ]
}
{% endschema %}
