{% if section.blocks.size > 0 %}<section class="ep-section ep-search-links color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}{% for block in section.blocks %}{% if block.settings.menu.links != blank or block.settings.terms != blank %}<div {{ block.shopify_attributes }}><h3>{% render 'ep-money-copy', text: block.settings.heading %}</h3><div class="ep-search-terms">{% if block.settings.menu.links != blank %}{% for link in block.settings.menu.links %}{% assign ep_link_handle = link.url | split: '/' | last | split: '?' | first %}{% capture ep_visible %}{% render 'ep-content-visible', item: link.object, kind: 'collection', title: link.title, handle: ep_link_handle %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}<a href="{% render 'ep-stock-url', url: link.url %}">{{ link.title | escape }}</a>{% endfor %}{% else %}{% assign terms = block.settings.terms | newline_to_br | split: '<br />' %}{% for term in terms %}{% assign clean = term | strip %}{% if clean != blank %}<a href="{{ routes.search_url }}?q={{ clean | url_encode }}&amp;type=product">{{ clean | escape }}</a>{% endif %}{% endfor %}{% endif %}</div></div>{% endif %}{% endfor %}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_search_links",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:ep.search_group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.menu"
        },
        {
          "type": "textarea",
          "id": "terms",
          "label": "t:ep.search_terms_one_per_line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_search_links"
    }
  ],
  "max_blocks": 10
}
{% endschema %}
