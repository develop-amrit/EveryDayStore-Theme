<section class="qc-wrap qc-section"><h2>{{ section.settings.heading | escape }}</h2><div class="qc-products qc-grid">{% render 'qc-product-list', collection: section.settings.collection, limit: section.settings.limit %}</div></section>
{% schema %}
{
  "name": "commerce sample catalog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product count",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "commerce sample catalog"
    }
  ]
}
{% endschema %}
