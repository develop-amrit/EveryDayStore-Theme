<footer class="qc-footer"><div class="qc-wrap"><div class="qc-footer-top"><div><a class="qc-logo" href="{% render 'ep-stock-url', url: routes.root_url %}">{% render 'qc-logo', wordmark: section.settings.wordmark %}</a><p>{% render 'ep-money-copy', text: section.settings.text %}</p></div><div><h2>{{ 'qc.newsletter' | t }}</h2>{% form 'customer', id: 'qc-newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">{{ 'qc.subscribed' | t }}</p>{% else %}<label class="visually-hidden" for="qc-email">{{ 'qc.email' | t }}</label><div class="qc-newsletter"><input id="qc-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'qc.email' | t }}" required><button>{{ 'qc.subscribe' | t }} &#8599;</button></div>{{ form.errors | default_errors }}{% endif %}{% endform %}<small>{{ 'qc.newsletter_hint' | t }}</small></div></div><div class="qc-footer-links">{% for block in section.blocks %}{% if block.settings.menu.links != blank %}<details class="ep-footer-menu" {{ block.shopify_attributes }}><summary>{% render 'ep-money-copy', text: block.settings.heading %}{{ 'icon-caret.svg' | inline_asset_content }}</summary><div>{% for link in block.settings.menu.links %}{% assign ep_link_handle = link.url | split: '/' | last | split: '?' | first %}{% if block.settings.menu.handle == settings.qc_catalog_menu.handle and ep_link_handle == 'all' %}{% continue %}{% endif %}{% capture ep_visible %}{% render 'ep-content-visible', item: link.object, kind: 'collection', title: link.title, handle: ep_link_handle %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}<a href="{% render 'ep-stock-url', url: link.url %}">{{ link.title | escape }}</a>{% endfor %}</div></details>{% endif %}{% endfor %}{% if section.settings.help_menu.links != blank %}<details class="ep-footer-menu"><summary>{{ 'ep.help' | t }}{{ 'icon-caret.svg' | inline_asset_content }}</summary><div>{% for link in section.settings.help_menu.links %}<a href="{% render 'ep-stock-url', url: link.url %}">{{ link.title | escape }}</a>{% endfor %}</div></details>{% endif %}{% render 'ep-policy-help' %}{% capture social_markup %}{% render 'ep-social-icons' %}{% endcapture %}{% assign social_markup = social_markup | strip %}{% if social_markup != blank %}<div class="ep-social">{{ social_markup }}</div>{% endif %}</div><div class="qc-policy-links"><button type="button" data-cookie-manage>{{ 'qc.cookie_manage' | t }}</button></div><div class="qc-footer-base"><span>&#169; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><ul class="qc-payment" role="list" aria-label="{{ 'qc.payment' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% if request.page_type == 'index' %}<button type="button" data-ep-top>{{ 'qc.top' | t }} &#8593;</button>{% else %}<a href="#" data-top>{{ 'qc.top' | t }} &#8593;</a>{% endif %}</div></div></footer>

{% schema %}
{
  "name": "Quick commerce footer",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "t:ep.final_existing_wordmark",
      "default": "everyday"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:ep.final_description",
      "default": "Everyday essentials. Thoughtfully selected for life in Dubai."
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "t:ep.final_help_menu"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Footer menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.final_heading",
          "default": "Here to help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.final_footer_menu"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Quick commerce footer",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "heading": "Here to help"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "Good to know"
          }
        }
      ]
    }
  ]
}
{% endschema %}

