<section class="page-width dc-section"><h2>{{ 'commerce_experience.labels.reorder' | t }}</h2><p>{{ 'commerce_experience.labels.reorder_note' | t }}</p>
{% if customer %}{% paginate customer.orders by 10 %}{% for order in customer.orders %}<details class="dc-request"><summary>{{ order.name | escape }} · {{ order.created_at | date: format: 'date' }}</summary><a href="{{ order.customer_url }}">{{ 'commerce_experience.labels.view_orders' | t }}</a><ul>{% for item in order.line_items %}{% if item.product != blank %}<li><a href="{{ item.product.url }}?variant={{ item.variant_id }}">{{ item.title | escape }} · {{ item.quantity }} · {{ 'commerce_experience.labels.view_product' | t }}</a></li>{% endif %}{% endfor %}</ul></details>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}{% else %}<a href="{{ routes.account_url }}" class="button">{{ 'commerce_experience.labels.view_orders' | t }}</a>{% endif %}</section>
{% schema %}{"name":"Commerce Buy Again","settings":[],"presets":[{"name":"Commerce Buy Again"}]}{% endschema %}
