{% if section.blocks.size > 0 %}<section class="ep-section ep-seasonal color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px;--ep-panel-bg:{{ section.settings.background }}"><div class="ep-wrap"><div class="ep-panel">{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}{% if section.settings.artwork %}{{ section.settings.artwork | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 750, 1200', sizes: '100vw', alt: '', class: 'ep-seasonal-art' }}{% endif %}<div class="ep-seasonal-tiles">{% for block in section.blocks %}{% if block.type == 'tile' %}<a class="ep-seasonal-tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span class="ep-auto-well">{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, title: block.settings.title %}</span>{% if block.settings.collection.all_products_count == 0 %}<small class="ep-coming-soon">{{ 'ep.coming_soon' | t }}</small>{% endif %}</a>{% endif %}{% endfor %}</div>{% for block in section.blocks %}{% if block.type == 'strip' %}<a class="ep-strip" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span class="ep-strip-art ep-auto-well">{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, title: block.settings.title %}</span><span><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.subtitle | escape }}</small></span><i class="ep-arrow" aria-hidden="true">›</i></a>{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_themed_grid",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:ep.background",
      "default": "#FEFAE0"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:ep.background_image"
    },
    {
      "type": "image_picker",
      "id": "artwork",
      "label": "t:ep.decorative_artwork"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:ep.seasonal_tile",
      "limit": 9,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Auto image collection"
        }
      ]
    },
    {
      "type": "strip",
      "name": "t:ep.feature_strip",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:ep.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:ep.subtitle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Auto image collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_themed_grid"
    }
  ]
}
{% endschema %}
