<ep-cart-page class="ep-cart-page"><header class="ep-cart-header"><button type="button" data-ep-cart-back aria-label="{{ 'epc.back' | t }}">←</button><h1>{{ 'ep4.basket' | t }}</h1><span data-ep-cart-count>{{ 'ep4.items' | t: count: cart.item_count }}</span></header><div class="ep-cart-frame" data-ep-cart-page-host>{% render 'ep-cart-view' %}</div><script type="application/json" data-ep-cart-labels>{"items":{{ 'ep4.items' | t: count: '__COUNT__' | json }},"removed":{{ 'ep4.removed' | t | json }},"undo":{{ 'ep4.undo' | t | json }},"couponError":{{ 'ep4.coupon_error' | t | json }},"applied":{{ 'ep4.applied' | t | json }},"chooseArea":{{ 'ep4.choose_area' | t | json }},"checkout":{{ 'ep4.checkout' | t | json }},"unavailable":{{ 'ep4.remove_unavailable' | t | json }},"termsRequired":{{ 'ep4.terms_required' | t | json }}}</script></ep-cart-page>
{% schema %}
{
  "name": "cart page",
  "settings": [
    {
      "type": "collection",
      "id": "bestsellers",
      "label": "t:eps.bestsellers"
    }
  ],
  "presets": [
    {
      "name": "cart page"
    }
  ]
}
{% endschema %}
