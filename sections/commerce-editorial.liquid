<section class="page-width dc-section"><div class="dc-editorial dc-editorial--{{ section.settings.tone }}"><div class="dc-editorial__copy"><p class="dc-editorial__kicker">{{ section.settings.kicker | escape }}</p>{% if section.settings.primary %}<h1>{{ section.settings.heading | escape }}</h1>{% else %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}<div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="button dc-button-light" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}</div><div class="dc-editorial__art" aria-hidden="true">{% render 'commerce-art', kind: section.settings.art %}</div></div>{% if section.settings.note != blank %}<p class="dc-editorial__note">{{ section.settings.note | escape }}</p>{% endif %}</section>
{% stylesheet %}

.dc-editorial{display:grid;grid-template-columns:1.6fr 1fr;align-items:center;gap:3rem;background:var(--dc-forest);color:var(--dc-cream);border-radius:1.6rem;padding:4rem}.dc-editorial h1,.dc-editorial h2{font-size:clamp(3rem,4vw,5.4rem);line-height:1.05;color:inherit;max-width:16ch;margin:.8rem 0 1.8rem}.dc-editorial__copy .rte{max-width:52ch;font-size:1.6rem;line-height:1.7}.dc-editorial__kicker{font-size:1.3rem;margin:0;color:var(--dc-sand)}.dc-editorial__art{max-width:28rem;justify-self:center;width:100%;background:var(--dc-cream);border-radius:50%}.dc-editorial--cream{background:var(--dc-cream);color:var(--dc-forest)}.dc-editorial--cream .dc-editorial__kicker{color:var(--dc-muted)}.dc-editorial--cream .button{background:var(--dc-forest);color:var(--dc-cream)}.dc-editorial__note{font-size:1.2rem;color:var(--dc-muted);margin:1rem 0;line-height:1.6}@media(max-width:749px){.dc-editorial{padding:2.5rem;gap:1.5rem;grid-template-columns:1fr}.dc-editorial__art{width:12rem;justify-self:end;grid-row:2}.dc-editorial__copy .rte{font-size:1.4rem}.dc-editorial h1,.dc-editorial h2{font-size:3.4rem;max-width:19ch}}

{% endstylesheet %}
{% schema %}
{"name": "Commerce editorial", "settings": [{"type": "text", "id": "kicker", "label": "Small heading"}, {"type": "text", "id": "heading", "label": "Heading"}, {"type": "checkbox", "id": "primary", "label": "Use as page title", "default": false}, {"type": "richtext", "id": "text", "label": "Text"}, {"type": "text", "id": "note", "label": "Note"}, {"type": "url", "id": "link", "label": "Link"}, {"type": "text", "id": "label", "label": "Link label"}, {"type": "select", "id": "art", "label": "Illustration", "options": [{"value": "wipes", "label": "Baby care"}, {"value": "towels", "label": "Home care"}, {"value": "wash", "label": "Personal care"}, {"value": "cable", "label": "Tech"}, {"value": "oats", "label": "Pantry"}, {"value": "pouch", "label": "On the go"}, {"value": "gift", "label": "Gifting"}, {"value": "pet", "label": "Pet"}, {"value": "horeca", "label": "HORECA"}, {"value": "office", "label": "Office Supplies"}, {"value": "parcel", "label": "Delivery parcel"}], "default": "pouch"}, {"type": "select", "id": "tone", "label": "Background", "options": [{"value": "forest", "label": "Forest"}, {"value": "cream", "label": "Cream"}], "default": "forest"}], "presets": [{"name": "Commerce editorial"}]}
{% endschema %}
