<section class="page-width dc-section" aria-labelledby="Stories-{{ section.id }}">
{% if section.settings.heading != blank %}<div class="dc-section__heading"><h2 id="Stories-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>{% endif %}
<div class="dc-stories dc-stories--{{ section.settings.layout }}">
{% for block in section.blocks %}<article class="dc-story dc-story--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
<div class="dc-story__copy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p>{% if block.settings.link != blank and block.settings.label != blank %}<a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>{% endif %}</div>
<div class="dc-story__art">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '200, 400, 700', sizes: '(max-width: 749px) 140px, 300px' }}{% else %}{% render 'commerce-art', kind: block.settings.art %}{% endif %}</div>
</article>{% endfor %}</div></section>
{% stylesheet %}
.dc-stories{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.6rem}.dc-story{display:flex;align-items:center;min-width:0;padding:2.6rem;border-radius:1.4rem;overflow:hidden;background:#fefae0;gap:1rem}.dc-story--sand{background:#f4e4cc}.dc-story--olive{background:#e7ebdb}.dc-story__copy{flex:1;min-width:0}.dc-story h3{font-size:2.6rem;line-height:1.13;margin:0 0 1rem;max-width:17ch}.dc-story p{font-size:1.35rem;line-height:1.6;max-width:38ch;margin:0 0 1.2rem}.dc-story a{display:inline-flex;align-items:center;min-height:4.4rem;color:#283618;text-underline-offset:.5rem;font-size:1.3rem;font-weight:700}.dc-story__art{width:36%;flex-shrink:0}.dc-story__art img{width:100%;height:auto;object-fit:contain}.dc-stories--guides{grid-template-columns:repeat(3,minmax(0,1fr))}.dc-stories--guides .dc-story{flex-direction:column-reverse;align-items:stretch;padding:2.3rem}.dc-stories--guides .dc-story__art{width:12rem;align-self:flex-end}.dc-stories--guides h3{font-size:2.2rem}.dc-stories--guides .dc-story__copy{display:flex;flex-direction:column}.dc-stories--guides a{margin-top:auto}@media(max-width:749px){.dc-stories{grid-template-columns:1fr;gap:1.2rem}.dc-story{padding:2rem;min-height:18rem}.dc-story h3{font-size:2.4rem}.dc-story__art{width:32%}.dc-stories--guides .dc-story{flex-direction:row;align-items:center}.dc-stories--guides .dc-story__art{width:9rem;align-self:center}.dc-stories--guides h3{font-size:2.1rem}}
{% endstylesheet %}
{% schema %}
{"name": "Commerce stories", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "select", "id": "layout", "label": "Layout", "options": [{"value": "banners", "label": "Paired banners"}, {"value": "guides", "label": "Guide cards"}], "default": "banners"}], "max_blocks": 6, "blocks": [{"type": "story", "name": "Story", "settings": [{"type": "text", "id": "title", "label": "Heading"}, {"type": "textarea", "id": "copy", "label": "Description"}, {"type": "text", "id": "label", "label": "Link label"}, {"type": "url", "id": "link", "label": "Destination"}, {"type": "image_picker", "id": "image", "label": "Optional image"}, {"type": "select", "id": "art", "label": "Illustration", "options": [{"value": "wipes", "label": "Baby care"}, {"value": "towels", "label": "Home care"}, {"value": "wash", "label": "Personal care"}, {"value": "cable", "label": "Tech"}, {"value": "oats", "label": "Pantry"}, {"value": "pouch", "label": "On the go"}, {"value": "gift", "label": "Gifting"}, {"value": "pet", "label": "Pet"}, {"value": "horeca", "label": "HORECA"}, {"value": "office", "label": "Office Supplies"}, {"value": "parcel", "label": "Delivery parcel"}], "default": "pouch"}, {"type": "select", "id": "tone", "label": "Background", "options": [{"value": "cream", "label": "Cream"}, {"value": "sand", "label": "Sand"}, {"value": "olive", "label": "Olive"}], "default": "cream"}]}], "presets": [{"name": "Commerce stories", "blocks": [{"type": "story"}, {"type": "story"}]}]}
{% endschema %}