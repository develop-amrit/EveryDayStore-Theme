<section class="ep-policy-frame ep-wrap" aria-labelledby="ep-payment-title"><h1 id="ep-payment-title">{{ page.title | escape }}</h1><div class="ep-cart-card"><h2>{{ section.settings.title | escape }}</h2><ul class="ep-payment-methods" role="list">{% for payment in shop.enabled_payment_types %}<li>{{ payment | payment_type_svg_tag }}<span>{{ payment | replace: '_', ' ' | capitalize }}</span></li>{% endfor %}{% if settings.qc_cod %}<li>{{ 'ep4.cod' | t }}</li>{% endif %}</ul><h2>{{ 'ep4.secure' | t }}</h2><p>{{ section.settings.secure_text | escape }}</p><h2>{{ 'ep4.vat_title' | t }}</h2><p>{{ section.settings.prices_text | escape }} {% if shop.taxes_included %}{{ 'ep4.vat_included' | t }}{% else %}{{ 'ep4.vat_added' | t }}{% endif %}</p>{% if shop.refund_policy.body != blank %}<h2>{{ 'ep4.refunds' | t }}</h2><p><a href="{{ shop.refund_policy.url }}">{{ 'ep4.refund_policy' | t }}</a></p>{% endif %}{% if section.settings.contact_email != blank %}<h2>{{ 'ep4.help' | t }}</h2><p><a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a></p>{% endif %}</div></section>
{% schema %}
{"name":"t:ep4.payment_section","settings":[{"type":"text","id":"title","label":"t:ep.title","default":"Ways to pay"},{"type":"textarea","id":"secure_text","label":"t:ep4.secure_text","default":"Payments are processed by Shopify's secure checkout. We never see or store your full card details."},{"type":"text","id":"prices_text","label":"t:ep4.prices_text","default":"All prices are in AED."},{"type":"text","id":"contact_email","label":"t:ep4.contact_email"}],"presets":[{"name":"t:ep4.payment_section"}]}
{% endschema %}
