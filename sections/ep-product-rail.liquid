{% assign excluded_tags = section.settings.exclude_tags | default: 'homepage-hide' | split: ',' %}{% assign rendered = 0 %}{% capture cards %}{% for product in section.settings.collection.products limit: 50 %}{% capture ep_visible %}{% render 'ep-content-visible', item: product %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% unless product.available %}{% continue %}{% endunless %}{% capture ep_visible %}{% render 'ep-content-visible', item: product, hide_prefix: section.settings.hide_title_prefix, hidden_handles: section.settings.hidden_collection_handles %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% assign exclude_product = false %}{% if request.page_type == 'index' %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and product.tags contains cleaned_tag %}{% assign exclude_product = true %}{% endif %}{% endfor %}{% endif %}{% if exclude_product %}{% continue %}{% endif %}{% assign card_variant = product.selected_or_first_available_variant %}{% assign show_product = true %}{% if section.settings.discounted_only %}{% assign show_product = false %}{% if product.available and card_variant.compare_at_price > card_variant.price %}{% assign show_product = true %}{% endif %}{% endif %}{% if show_product %}{% render 'ep-card', product: product, variant: section.settings.card_variant %}{% assign rendered = rendered | plus: 1 %}{% if rendered >= section.settings.limit %}{% break %}{% endif %}{% endif %}{% endfor %}{% endcapture %}{% assign cards = cards | strip %}{% assign chosen = section.settings.collection %}{% assign dest = section.settings.see_all_link | default: chosen.url %}{% if cards != blank or request.design_mode %}{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, link_url: dest, heading_id: heading_id %}<div class="ep-rail-arrows"><button type="button" data-ep-arrow="prev" data-rail="ep-rail-{{ section.id }}" aria-label="{{ 'qc.previous' | t }}">‹</button><button type="button" data-ep-arrow="next" data-rail="ep-rail-{{ section.id }}" aria-label="{{ 'qc.next' | t }}">›</button></div><div class="{% if section.settings.background == 'soft' %}ep-panel {% endif %}ep-rail" id="ep-rail-{{ section.id }}" style="--ep-columns:{{ section.settings.columns_mobile }};--ep-rows:{{ section.settings.rows }}">{{ cards }}{% if cards == blank and request.design_mode %}{% for i in (1..4) %}<div class="ep-card"><div class="ep-image-well">{{ 'product-1' | placeholder_svg_tag }}</div></div>{% endfor %}{% endif %}</div>{% if section.settings.show_button %}{% render 'ep-see-all-button', link_url: dest %}{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_product_rail",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.subtitle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:ep.collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:ep.products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "url",
      "id": "see_all_link",
      "label": "t:ep.see_all_link"
    },
    {
      "type": "select",
      "id": "card_variant",
      "label": "t:ep.card_variant",
      "options": [
        {
          "value": "compact",
          "label": "t:ep.compact"
        },
        {
          "value": "rated",
          "label": "t:ep.rated"
        }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:ep.show_see_all_button",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:ep.background",
      "options": [
        {
          "value": "none",
          "label": "t:ep.none"
        },
        {
          "value": "soft",
          "label": "t:ep.soft"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "discounted_only",
      "label": "t:ep.discounted_only",
      "default": false
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    },
    {
      "type": "text",
      "id": "hide_title_prefix",
      "label": "t:epcf.hide_prefix",
      "default": "[TEST]"
    },
    {
      "type": "textarea",
      "id": "hidden_collection_handles",
      "label": "t:epcf.hidden_handles",
      "default": "frontpage, home-page, in-stock, all"
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_product_rail"
    },
    {
      "name": "t:ep.deals_rail",
      "settings": {
        "title": "Best deals",
        "card_variant": "compact",
        "show_button": true
      }
    }
  ]
}
{% endschema %}
