{% if section.blocks.size > 0 or request.design_mode %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<div{% if section.settings.title == blank %} class="visually-hidden"{% endif %}>{% assign carousel_title = section.settings.title | default: section.settings.accessible_title %}{% render 'ep-section-header', title: carousel_title, heading_id: heading_id %}</div></div><ep-carousel class="ep-carousel" data-autoplay="{{ section.settings.autoplay }}"><div class="ep-rail">{% for block in section.blocks %}{% if block.settings.image != blank or block.settings.heading != blank %}<a class="ep-slide ep-tint-{{ block.settings.tint | default: 'cream' }}"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}><span class="ep-slide-art ep-auto-well">{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, title: block.settings.heading, exclude_tags: section.settings.exclude_tags %}</span>{% if block.settings.heading != blank %}<div class="ep-slide-copy"><h3>{% render 'ep-money-copy', text: block.settings.heading %}</h3><p>{% render 'ep-money-copy', text: block.settings.text %}</p>{% if block.settings.button_label != blank %}<span class="ep-cta">{% render 'ep-money-copy', text: block.settings.button_label %}</span>{% endif %}</div>{% endif %}</a>{% endif %}{% endfor %}</div><div class="ep-dots">{% for block in section.blocks %}{% if block.settings.image != blank or block.settings.heading != blank %}<button type="button" data-ep-slide aria-label="{{ 'ep.go_slide' | t: number: forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endif %}{% endfor %}</div></ep-carousel></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_banner_carousel",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title"
    },
    {
      "type": "text",
      "id": "accessible_title",
      "label": "t:ep.accessible_title",
      "default": "Featured collections"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:ep.autoplay",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:ep.slide",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:ep.mobile_image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.fallback_collection_image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:ep.alternative_text",
          "info": "t:ep.add_alternative_text_describing_the_banner"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:ep.supporting_text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:ep.button_label"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "t:ep.final_card_tint",
          "options": [
            {
              "value": "blue",
              "label": "t:ep.final_blue"
            },
            {
              "value": "accent",
              "label": "t:ep.final_accent"
            },
            {
              "value": "green",
              "label": "t:ep.final_green"
            },
            {
              "value": "lilac",
              "label": "t:ep.final_lilac"
            },
            {
              "value": "cream",
              "label": "t:ep.final_cream"
            }
          ],
          "default": "cream"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_banner_carousel"
    }
  ]
}
{% endschema %}
