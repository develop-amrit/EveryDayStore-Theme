{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}<div class="ep-tiles ep-store-tiles">{% for block in section.blocks %}<a class="ep-store-tile ep-tint-{{ block.settings.tint | default: 'cream' }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span class="ep-auto-well">{% assign discounted = false %}{% if block.settings.tint == 'brand' %}{% assign discounted = true %}{% endif %}{% render 'ep-auto-image', image: block.settings.image, collection: block.settings.collection, title: block.settings.label, discounted: discounted %}</span><span>{{ block.settings.label | escape }}</span></a>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "t:ep.everyday_store_grid",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title",
      "default": "Shop by store"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "t:ep.store",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:ep.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "color",
          "id": "background",
          "label": "t:ep.tile_background",
          "default": "#FEFAE0"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Auto image collection"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "Tile tint",
          "options": [
            {
              "value": "blue",
              "label": "blue"
            },
            {
              "value": "accent",
              "label": "accent"
            },
            {
              "value": "green",
              "label": "green"
            },
            {
              "value": "lilac",
              "label": "lilac"
            },
            {
              "value": "pink",
              "label": "pink"
            },
            {
              "value": "peach",
              "label": "peach"
            },
            {
              "value": "cream",
              "label": "cream"
            },
            {
              "value": "brand",
              "label": "brand"
            }
          ],
          "default": "cream"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_store_grid"
    }
  ],
  "max_blocks": 12
}
{% endschema %}
