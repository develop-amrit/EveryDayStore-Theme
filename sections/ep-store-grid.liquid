{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap">{% render 'ep-section-header', title: section.settings.title, subtitle: section.settings.subtitle, heading_id: heading_id %}<div class="ep-tiles ep-store-tiles">{% for stock_pass in (1..2) %}{% for block in section.blocks %}{% capture in_stock %}{% render 'ep-has-stock', collection: block.settings.collection, exclude_tags: section.settings.exclude_tags %}{% endcapture %}{% if stock_pass == 1 and in_stock != '1' %}{% continue %}{% endif %}{% if stock_pass == 2 and in_stock == '1' %}{% continue %}{% endif %}<a class="ep-store-tile ep-tint-{{ block.settings.tint | default: 'cream' }}" href="{% render 'ep-stock-url', url: block.settings.link %}" {{ block.shopify_attributes }}><span class="ep-auto-well">{% assign discounted = false %}{% if block.settings.tint == 'brand' %}{% assign discounted = true %}{% endif %}{% render 'ep-auto-image', image_sizes: '(min-width:990px) 300px, 23vw', image: block.settings.image, collection: block.settings.collection, title: block.settings.label, discounted: discounted, exclude_tags: section.settings.exclude_tags %}</span><span>{% render 'ep-money-copy', text: block.settings.label %}</span></a>{% endfor %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "t:ep.everyday_store_grid",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title",
      "default": "Shop by store"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "t:ep.store",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:ep.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.link"
        },
        {
          "type": "color",
          "id": "background",
          "label": "t:ep.tile_background",
          "default": "#FEFAE0"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:ep.final_auto_image_collection"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "t:ep.final_tile_tint",
          "options": [
            {
              "value": "blue",
              "label": "t:ep.final_blue"
            },
            {
              "value": "accent",
              "label": "t:ep.final_accent"
            },
            {
              "value": "green",
              "label": "t:ep.final_green"
            },
            {
              "value": "lilac",
              "label": "t:ep.final_lilac"
            },
            {
              "value": "pink",
              "label": "t:ep.final_pink"
            },
            {
              "value": "peach",
              "label": "t:ep.final_peach"
            },
            {
              "value": "cream",
              "label": "t:ep.final_cream"
            },
            {
              "value": "brand",
              "label": "t:ep.final_brand"
            }
          ],
          "default": "cream"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_store_grid"
    }
  ],
  "max_blocks": 12
}
{% endschema %}
