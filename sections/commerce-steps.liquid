<section class="page-width dc-section"><div class="dc-section__heading"><h2>{{ section.settings.heading | escape }}</h2></div><p class="dc-steps__intro">{{ section.settings.intro | escape }}</p><ol class="dc-steps">{% for block in section.blocks %}<li class="dc-steps__item" {{ block.shopify_attributes }}><span class="dc-steps__number" aria-hidden="true">{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>{% endif %}</li>{% endfor %}</ol></section>
{% stylesheet %}

.dc-steps__intro{font-size:1.4rem;line-height:1.6;color:var(--dc-muted);max-width:65ch}.dc-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:0;gap:2.5rem;margin:2rem 0}.dc-steps__item{border-top:1px solid var(--dc-line);padding:2rem 0}.dc-steps__number{display:grid;place-items:center;width:3.4rem;height:3.4rem;border-radius:50%;background:var(--dc-forest);color:var(--dc-cream);font-weight:700}.dc-steps h3{font-size:2rem;margin:1.5rem 0 .8rem}.dc-steps p{font-size:1.4rem;line-height:1.7;max-width:45ch}.dc-steps a{color:var(--dc-forest);min-height:4.4rem;display:inline-flex;align-items:center;text-underline-offset:.4rem;font-weight:650}@media(max-width:749px){.dc-steps{grid-template-columns:1fr;gap:0}.dc-steps__item{padding:1.6rem 0}.dc-steps h3{margin:.8rem 0}.dc-steps p{margin:.6rem 0}}

{% endstylesheet %}
{% schema %}
{"name": "Commerce steps", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "textarea", "id": "intro", "label": "Introduction"}], "max_blocks": 6, "blocks": [{"type": "step", "name": "Step", "settings": [{"type": "text", "id": "title", "label": "Title"}, {"type": "textarea", "id": "text", "label": "Description"}, {"type": "url", "id": "link", "label": "Link"}, {"type": "text", "id": "label", "label": "Link label"}]}], "presets": [{"name": "Commerce steps"}]}
{% endschema %}
