{% assign item = product.selected_or_first_available_variant %}
<ep-product data-section="{{ section.id }}" data-main-product="{{ product.handle }}" data-url="{{ product.url }}" data-variant="{{ item.id }}" data-image="{{ item.featured_image.id }}">
<div class="ep-product-layout ep-wrap"><div class="ep-product-gallery"><div class="ep-gallery-track" data-gallery-track>{% for image in product.images %}<button type="button" class="ep-gallery-image ep-auto-well" data-gallery-zoom="{{ forloop.index0 }}" data-gallery-image="{{ image.id }}" aria-label="{{ 'eps.zoom_image' | t: number: forloop.index }}">{% assign alt = image.alt | default: product.title %}{% assign load = 'lazy' %}{% assign priority = 'auto' %}{% if forloop.first %}{% assign load = 'eager' %}{% assign priority = 'high' %}{% endif %}{{ image | image_url: width: 1000, format: 'webp' | image_tag: loading: load, fetchpriority: priority, widths: '360, 480, 750, 1000', sizes: '(min-width:990px) 550px, 100vw', alt: alt }}</button>{% else %}<div class="ep-gallery-image ep-no-photo">{{ product.title | escape }}</div>{% endfor %}</div><button class="ep-wish ep-gallery-wish" type="button" data-wishlist="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'ep.wishlist_product' | t: title: product.title | escape }}">{% render 'qc-icon', name: 'heart' %}</button><div class="ep-gallery-dots">{% for image in product.images %}<button type="button" data-gallery-dot="{{ forloop.index0 }}" aria-label="{{ 'eps.go_to_slide' | t: number: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div></div>
<div class="ep-product-info"><p class="ep-product-vendor">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p class="ep-product-pack">{% if product.metafields.custom.pack_size.value != blank %}{% render 'ep-pack-size', value: product.metafields.custom.pack_size.value %}{% unless product.has_only_default_variant %} · {% endunless %}{% endif %}{% unless product.has_only_default_variant %}{{ item.title | escape }}{% endunless %}</p>{% if item %}<div class="ep-product-price">{% render 'ep-price', item: item %}{% render 'ep-price', item: item, badge: true %}</div>{% endif %}
<p class="ep-product-delivery">{% render 'qc-icon', name: 'truck' %}<button type="button" data-product-area data-to="{{ 'eps.to' | t }}"><span>{{ 'eps.delivery_tomorrow' | t }}</span> <span data-product-area-name>{% if cart.attributes['Delivery area'] != blank %}{{ 'eps.to' | t }} {{ cart.attributes['Delivery area'] | escape }}{% endif %}</span><span data-product-area-empty{% if cart.attributes['Delivery area'] != blank %} hidden{% endif %}>{{ 'ep.choose_area' | t }}</span></button></p>
<div class="ep-product-fee"><span>{{ 'eps.delivery' | t }} {% assign fee = settings.qc_fee_low | default: '5.99' | times: 100 | round %}{% render 'ep-money', amount: fee %} · {{ 'eps.free_over' | t }} {% assign threshold = settings.qc_free_delivery | default: 99 | times: 100 %}{% render 'ep-money', amount: threshold %}</span><button type="button" data-ep-sheet="ep-product-fees-{{ section.id }}" aria-label="{{ 'eps.delivery_info' | t }}">i</button></div>
{% unless product.has_only_default_variant %}<div class="ep-product-options">{% for option in product.options_with_values %}<fieldset><legend>{{ option.name | escape }}</legend><div>{% for value in option.values %}<button type="button" data-ep-option="{{ value.id }}" data-option-product-url="{{ value.product_url }}" data-option-position="{{ option.position }}" aria-pressed="{{ value.selected }}">{{ value | escape }}</button>{% endfor %}</div></fieldset>{% endfor %}</div>{% endunless %}<p class="ep-error" role="status" data-product-error></p>
<section class="ep-about" aria-labelledby="ep-about-title"><h2 id="ep-about-title">{{ 'eps.about' | t }}</h2><div class="ep-about-copy" id="ep-about-copy-{{ section.id }}">{{ product.description }}</div><button type="button" data-product-read-more aria-controls="ep-about-copy-{{ section.id }}" aria-expanded="false" data-more="{{ 'eps.read_more' | t }}" data-less="{{ 'eps.read_less' | t }}">{{ 'eps.read_more' | t }}</button><dl class="ep-product-specs">{% for entry in product.metafields.custom.specifications.value %}<dt>{{ entry.first | escape }}</dt><dd>{{ entry.last | escape }}</dd>{% endfor %}</dl></section></div></div>
<div class="ep-product-bar"><div>{% if item %}{% render 'ep-money', amount: item.price %}{% endif %}</div>{% render 'ep-add-button', product: product, item: item, style: 'product', direct: true %}</div>
<dialog class="ep-browse-sheet" id="ep-product-fees-{{ section.id }}" aria-labelledby="ep-fees-title"><div class="ep-sheet-heading"><h2 id="ep-fees-title">{{ 'eps.delivery_info' | t }}</h2><button type="button" data-ep-sheet-close aria-label="{{ 'qc.close' | t }}">×</button></div>{% render 'qc-delivery-tiers' %}</dialog>
<dialog class="ep-zoom" aria-label="{{ 'eps.zoom_gallery' | t }}"><button type="button" data-zoom-close aria-label="{{ 'qc.close' | t }}">×</button><div class="ep-gallery-track" data-zoom-track>{% for image in product.images %}<div class="ep-zoom-image">{% assign alt = image.alt | default: product.title %}{{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1600', sizes: '100vw', alt: alt }}</div>{% endfor %}</div></dialog>
</ep-product>
{% schema %}
{
  "name": "t:eps.product_page",
  "settings": [],
  "presets": [
    {
      "name": "t:eps.product_page"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
