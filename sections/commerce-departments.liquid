<section class="page-width dc-section"><div class="dc-section__heading">{% if template.suffix == 'departments' %}<h1>{{ page.title | escape }}</h1>{% else %}<h2>{{ section.settings.title | escape }}</h2>{% endif %}<a href="{{ pages['departments'].url }}">{{ 'commerce.view_all' | t }}</a></div><div class="dc-departments">{% for block in section.blocks %}<a class="dc-department" href="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% else %}{{ block.settings.link }}{% endif %}" {{ block.shopify_attributes }}><span class="dc-department__art">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240' }}{% else %}{% if block.settings.illustration == 'category' %}<span class="dc-department__generic" aria-hidden="true">{% render 'commerce-icon', name:'shop' %}</span>{% else %}{% render 'commerce-art', kind:block.settings.illustration %}{% endif %}{% endif %}</span><strong>{{ block.settings.label | escape }}</strong></a>{% endfor %}</div></section>
{% schema %}
{"name": "Commerce departments", "settings": [{"type": "text", "id": "title", "label": "Heading", "default": "What’s on your list?"}], "blocks": [{"type": "department", "name": "Department", "settings": [{"type": "text", "id": "label", "label": "Name"}, {"type": "collection", "id": "collection", "label": "Collection"}, {"type": "url", "id": "link", "label": "Preview link"}, {"type": "image_picker", "id": "image", "label": "Image"}, {"type": "select", "id": "illustration", "label": "Preview illustration", "options": [{"value": "wipes", "label": "Wipes"}, {"value": "towels", "label": "Home"}, {"value": "wash", "label": "Personal care"}, {"value": "cable", "label": "Tech"}, {"value": "oats", "label": "Pantry"}, {"value": "pouch", "label": "On the go"}, {"value": "category", "label": "General department"}, {"value": "gift", "label": "Gifting"}, {"value": "pet", "label": "Pet"}, {"value": "horeca", "label": "HORECA"}, {"value": "office", "label": "Office Supplies"}, {"value": "parcel", "label": "Delivery parcel"}], "default": "wipes"}]}], "max_blocks": 12, "presets": [{"name": "Commerce departments"}]}
{% endschema %}