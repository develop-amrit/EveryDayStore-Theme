{% assign department = blank %}{% assign second = blank %}{% assign department_title = section.settings.title %}{% assign active_count = 0 %}{% for filter in collection.filters %}{% assign active_count = active_count | plus: filter.active_values.size %}{% endfor %}<ep-collection data-mode="deals" class="ep-collection color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}" data-department="" data-url="{{ collection.url }}" data-page-title="{{ section.settings.title | escape }} – {{ shop.name | escape }}" data-loading="{{ 'epc.loading' | t }}">
<div class="ep-collection-heading ep-wrap" data-collection-head><h1 tabindex="-1" title="{{ section.settings.title | escape }}">{{ section.settings.title | escape }}</h1><nav class="ep-breadcrumb" aria-label="{{ 'epc.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'epc.home' | t }}</a><span aria-hidden="true">›</span>{% if department != blank %}{% unless department.object.id == collection.id %}<a href="{{ department.url }}" data-ep-collection-link>{{ department.title | escape }}</a><span aria-hidden="true">›</span>{% endunless %}{% if second != blank and second.object.id != collection.id %}<a href="{{ second.url }}" data-ep-collection-link>{{ second.title | escape }}</a><span aria-hidden="true">›</span>{% endif %}{% endif %}<strong aria-current="page">{{ section.settings.title | escape }}</strong></nav></div>
<div class="ep-collection-layout ep-wrap{% if department == blank %} ep-no-rail{% endif %}">
{% if department != blank %}<aside class="ep-collection-rail" aria-label="{{ department.title | escape }}" data-collection-rail><span class="ep-rail-indicator" aria-hidden="true"></span>{% assign all_active = false %}{% if department.object.id == collection.id %}{% assign all_active = true %}{% endif %}{% assign all_label = 'epc.all' | t %}{% render 'ep-collection-rail-item', target: department.object, label: all_label, icon: department_icon, active: all_active %}{% for child in department.links %}{% assign active = false %}{% if child.object.id == second.object.id %}{% assign active = true %}{% endif %}{% render 'ep-collection-rail-item', target: child.object, label: child.title, icon: department_icon, active: active %}{% endfor %}</aside>{% endif %}
<div class="ep-collection-content" data-collection-content tabindex="-1">
{% if second.links != blank %}<nav class="ep-subcategory-chips" aria-label="{{ second.title | escape }}"><a href="{{ second.url }}" data-ep-collection-link{% if second.object.id == collection.id %} aria-current="page"{% endif %}>{{ 'epc.all' | t }}</a>{% for leaf in second.links %}{% capture ep_visible %}{% render 'ep-content-visible', item: leaf.object, kind: 'collection', hide_prefix: section.settings.hide_title_prefix, hidden_handles: section.settings.hidden_collection_handles %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}<a href="{{ leaf.url }}" data-ep-collection-link{% if leaf.object.id == collection.id %} aria-current="page"{% endif %}>{{ leaf.title | escape }}</a>{% endfor %}</nav>{% endif %}
{% if collection.all_products_count > 0 %}{% render 'ep-collection-filters', collection: collection, active_count: active_count, id: section.id %}{% endif %}
{% assign promo_image = collection.metafields.custom.promo_image.value %}{% assign promo_link = collection.metafields.custom.promo_link.value %}{% assign promo_alt = collection.metafields.custom.promo_alt.value %}{% if promo_image == blank %}{% for block in section.blocks %}{% if block.type == 'promo' and block.settings.collection.id == collection.id %}{% assign promo_image = block.settings.image %}{% assign promo_link = block.settings.link %}{% assign promo_alt = block.settings.alt %}{% break %}{% endif %}{% endfor %}{% endif %}
{% if promo_image %}{% assign promo_alt = promo_alt | default: promo_image.alt | default: collection.title %}{% if promo_link %}<a class="ep-collection-promo ep-auto-well" href="{{ promo_link }}">{% else %}<div class="ep-collection-promo ep-auto-well">{% endif %}{% capture image_markup %}{{ promo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(min-width:990px) 900px, 75vw', alt: promo_alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% if promo_link %}</a>{% else %}</div>{% endif %}{% endif %}
{% paginate collection.products by 24 %}
<div class="ep-collection-products" data-collection-products>{% for product in collection.products %}{% capture ep_visible %}{% render 'ep-content-visible', item: product, hide_prefix: section.settings.hide_title_prefix, hidden_handles: section.settings.hidden_collection_handles %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% assign item = product.selected_or_first_available_variant %}{% if item.compare_at_price > item.price %}{% assign card_eager = false %}{% if forloop.index <= 6 %}{% assign card_eager = true %}{% endif %}{% render 'ep-card', product: product, variant: 'grid', eager: card_eager %}{% endif %}{% endfor %}</div>
{% if collection.products_count == 0 %}<div class="ep-empty-category">{% if collection.all_products_count > 0 %}<h2>{{ 'epc.no_matches' | t }}</h2><a data-ep-clear href="{{ collection.url }}">{{ 'epc.clear_filters' | t }}</a>{% else %}<span class="ep-empty-icon">{% render 'ep-icon', name: department_icon %}</span><h2>{{ 'epc.coming_collection' | t: collection: collection.title }}</h2><p>{{ 'epc.empty_department' | t: department: department_title }}</p>{% endif %}</div>{% if collection.all_products_count == 0 %}<div class="ep-collection-products ep-recommendations" data-ep-recommendations data-parent="{{ department.url }}" data-fallback="{{ section.settings.deals_collection.url }}" aria-busy="true"></div>{% endif %}{% endif %}
<div class="ep-collection-sentinel" data-collection-sentinel data-next="{{ paginate.next.url }}" data-page="{{ paginate.current_page }}" aria-live="polite">{% if paginate.next %}<a class="ep-load-more" data-ep-load-more href="{{ paginate.next.url }}">{{ 'epc.load_more' | t }}</a>{% else %}{% if collection.products_count > 0 %}<span>{{ 'epc.everything' | t: collection: collection.title }}</span><button type="button" data-ep-grid-top>{{ 'qc.top' | t }}</button>{% endif %}{% endif %}</div>
<noscript>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'epc.load_more' | t }}</a>{% endif %}</noscript>
{% endpaginate %}
</div></div></ep-collection>

{% schema %}
{
  "name": "t:ep.deals_view",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title",
      "default": "Best deals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:ep.collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:ep.deals_view"
    }
  ]
}
{% endschema %}