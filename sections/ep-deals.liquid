{% assign active_count = 0 %}{% for facet in collection.filters %}{% unless facet.param_name == 'filter.v.availability' %}{% assign active_count = active_count | plus: facet.active_values.size %}{% endunless %}{% endfor %}
<ep-collection data-mode="deals" class="ep-collection color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}" data-department="" data-url="{{ collection.url }}" data-page-title="{{ section.settings.title | escape }} – {{ shop.name | escape }}" data-loading="{{ 'epc.loading' | t }}">
<div class="ep-collection-heading ep-wrap" data-collection-head><h1 tabindex="-1">{{ section.settings.title | escape }}</h1><nav class="ep-breadcrumb" aria-label="{{ 'epc.breadcrumb' | t }}"><a href="{% render 'ep-stock-url', url: routes.root_url %}">{{ 'epc.home' | t }}</a><span aria-hidden="true">›</span><strong>{{ section.settings.title | escape }}</strong></nav></div>
<div class="ep-collection-layout ep-no-rail ep-wrap"><div class="ep-collection-content" data-collection-content tabindex="-1">
{% render 'ep-collection-filters', collection: collection, active_count: active_count, id: section.id %}
{% paginate collection.products by 250 %}{% capture cards %}{% render 'ep-discount-cards', products: collection.products, limit: 250, variant: 'grid' %}{% endcapture %}{% assign cards = cards | strip %}
<div class="ep-collection-products" data-collection-products>{{ cards }}</div>
<div data-ep-deals-empty{% if cards != blank %} hidden{% endif %}><div class="ep-empty-category"><h2>{{ 'eps.no_deals' | t }}</h2></div>{% capture bestsellers %}{% render 'ep-stock-cards', collection: section.settings.collection, limit: 8, variant: 'compact' %}{% endcapture %}{% if bestsellers != blank %}<section class="ep-search-suggestions" data-ep-bestsellers="{{ section.settings.collection.url }}"><h2>{{ 'eps.bestsellers' | t }}</h2><div class="ep-rail">{{ bestsellers }}</div></section>{% endif %}</div>
<div class="ep-collection-sentinel" data-collection-sentinel data-next="{{ paginate.next.url }}" data-page="1" aria-live="polite">{% if paginate.next %}<a class="ep-load-more" data-ep-load-more href="{% render 'ep-stock-url', url: paginate.next.url %}">{{ 'epc.load_more' | t }}</a>{% elsif cards != blank %}<span>{{ 'epc.everything' | t: collection: section.settings.title }}</span>{% endif %}</div>
{% endpaginate %}</div></div></ep-collection>
{% schema %}
{
  "name": "t:ep.deals_view",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.title",
      "default": "Best deals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:ep.collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:ep.deals_view"
    }
  ]
}
{% endschema %}