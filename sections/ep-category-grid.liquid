{% assign configured = false %}{% for block in section.blocks %}{% if block.type == 'group' and block.settings.menu.links != blank %}{% assign configured = true %}{% endif %}{% endfor %}{% if configured or request.design_mode %}{% capture heading_id %}ep-heading-{{ section.id }}{% endcapture %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="{{ heading_id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 id="{{ heading_id }}" class="visually-hidden">{{ section.settings.title | escape }}</h2>{% for block in section.blocks %}{% if block.type == 'group' and block.settings.menu.links != blank %}<div class="ep-grid-group" {{ block.shopify_attributes }}>{% capture group_id %}ep-group-{{ block.id }}{% endcapture %}{% render 'ep-section-header', title: block.settings.heading, link_url: block.settings.link, heading_id: group_id %}<div class="ep-tiles">{% for link in block.settings.menu.links limit: block.settings.max_tiles %}{% assign tile_image = blank %}{% if link.type == 'collection_link' %}{% assign tile_image = link.object.featured_image %}{% endif %}{% for override in section.blocks %}{% if override.type == 'image_override' and override.settings.group_heading == block.settings.heading and override.settings.link == link.url %}{% assign tile_image = override.settings.image %}{% endif %}{% endfor %}{% assign wide = false %}{% if forloop.first and block.settings.first_wide %}{% assign wide = true %}{% endif %}{% render 'ep-tile', title: link.title, image: tile_image, link: link.url, wide: wide %}{% endfor %}</div></div>{% endif %}{% endfor %}</div></section>{% endif %}
{% schema %}
{
  "name": "t:ep.everyday_category_grids",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.accessible_title",
      "default": "Shop by category"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:ep.category_group",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.category_menu"
        },
        {
          "type": "range",
          "id": "max_tiles",
          "label": "t:ep.maximum_tiles",
          "min": 4,
          "max": 16,
          "step": 1,
          "default": 8
        },
        {
          "type": "checkbox",
          "id": "first_wide",
          "label": "t:ep.make_first_tile_wide",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.see_all_link"
        }
      ]
    },
    {
      "type": "image_override",
      "name": "t:ep.tile_image_override",
      "settings": [
        {
          "type": "text",
          "id": "group_heading",
          "label": "t:ep.target_group_heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.target_link_url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_category_grids"
    }
  ]
}
{% endschema %}
