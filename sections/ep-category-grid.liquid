<script src="{{ 'ep-polish.js' | asset_url }}" defer></script><section id="shop-by-category" class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 id="ep-heading-{{ section.id }}" tabindex="-1">{{ section.settings.title | escape }}</h2><p class="ep-category-subtitle">{{ section.settings.subtitle | escape }}</p>{% for block in section.blocks %}{% if block.type == 'group' %}{% assign group_links = block.settings.menu.links %}{% if block.settings.department != blank %}{% assign group_links = blank %}{% for parent_link in block.settings.menu.links %}{% if parent_link.object.id == block.settings.department.id %}{% assign group_links = parent_link.links %}{% break %}{% endif %}{% endfor %}{% endif %}{% if group_links != blank %}<ep-category-group class="ep-grid-group" data-ep-department="{{ block.settings.department.handle }}" {{ block.shopify_attributes }}>{% capture group_id %}ep-group-{{ block.id }}{% endcapture %}{% render 'ep-section-header', title: block.settings.heading, link_url: block.settings.link, heading_id: group_id %}<div class="ep-group-clip" id="ep-tiles-{{ block.id }}"><div class="ep-tiles">{% for pass in (1..2) %}{% for link in group_links %}{% assign has_products = false %}{% if link.object.all_products_count > 0 %}{% assign has_products = true %}{% endif %}{% if pass == 1 and has_products or pass == 2 and has_products == false %}{% render 'ep-category-menu-tile', link: link, section: section, group_heading: block.settings.heading, icon: block.settings.icon, tint: block.settings.tint %}{% endif %}{% endfor %}{% endfor %}</div></div><button class="ep-group-toggle" type="button" aria-expanded="false" aria-controls="ep-tiles-{{ block.id }}" data-less="{{ 'ep.show_less' | t }}" hidden>{{ 'ep.show_all_count' | t: count: group_links.size }}</button></ep-category-group>{% endif %}{% endif %}{% endfor %}</div></section>
{% schema %}
{
  "name": "t:ep.everyday_category_grids",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.accessible_title",
      "default": "Shop by category"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_coming_soon",
      "label": "t:ep.final_show_coming_soon_for_empty_collections",
      "default": true
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.final_subtitle"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:ep.category_group",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.category_menu"
        },
        {
          "type": "collection",
          "id": "department",
          "label": "t:ep.department_source"
        },
        {
          "type": "checkbox",
          "id": "first_wide",
          "label": "t:ep.make_first_tile_wide",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.see_all_link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Parent category icon",
          "options": [
            {
              "value": "basket",
              "label": "basket"
            },
            {
              "value": "bottle",
              "label": "bottle"
            },
            {
              "value": "gift",
              "label": "gift"
            },
            {
              "value": "soap",
              "label": "soap"
            },
            {
              "value": "home",
              "label": "home"
            },
            {
              "value": "paw",
              "label": "paw"
            },
            {
              "value": "pencil",
              "label": "pencil"
            }
          ],
          "default": "basket"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "Coming soon tint",
          "options": [
            {
              "value": "blue",
              "label": "blue"
            },
            {
              "value": "cream",
              "label": "cream"
            },
            {
              "value": "green",
              "label": "green"
            },
            {
              "value": "pink",
              "label": "pink"
            },
            {
              "value": "lilac",
              "label": "lilac"
            },
            {
              "value": "peach",
              "label": "peach"
            }
          ],
          "default": "cream"
        }
      ]
    },
    {
      "type": "image_override",
      "name": "t:ep.tile_image_override",
      "settings": [
        {
          "type": "text",
          "id": "group_heading",
          "label": "t:ep.target_group_heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.target_link_url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_category_grids"
    }
  ]
}
{% endschema %}
