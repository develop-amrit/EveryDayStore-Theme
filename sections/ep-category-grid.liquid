<section id="shop-by-category" class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 id="ep-heading-{{ section.id }}" tabindex="-1">{% render 'ep-money-copy', text: section.settings.title %}</h2><p class="ep-category-subtitle">{% render 'ep-money-copy', text: section.settings.subtitle %}</p><a class="ep-catalogue-button" href="{% render 'ep-stock-url', url: routes.collections_url %}">{{ 'ep.browse_catalogue' | t }} ›</a>{% for block in section.blocks %}{% if block.type == 'group' %}{% assign group_links = block.settings.menu.links %}{% if block.settings.department != blank %}{% assign group_links = blank %}{% for parent_link in block.settings.menu.links %}{% if parent_link.object.id == block.settings.department.id %}{% assign group_links = parent_link.links %}{% break %}{% endif %}{% endfor %}{% endif %}{% if group_links != blank %}<ep-category-group class="ep-grid-group" data-ep-department="{{ block.settings.department.handle }}" {{ block.shopify_attributes }}>{% capture group_id %}ep-group-{{ block.id }}{% endcapture %}{% render 'ep-section-header', title: block.settings.heading, link_url: block.settings.link, heading_id: group_id %}<div class="ep-group-clip" id="ep-tiles-{{ block.id }}"><div class="ep-tiles">{% for pass in (1..2) %}{% for link in group_links %}{% assign has_products = false %}{% if link.object.all_products_count > 0 %}{% assign has_products = true %}{% endif %}{% assign show_tile = false %}{% if pass == 1 %}{% if has_products %}{% assign show_tile = true %}{% endif %}{% else %}{% unless has_products %}{% assign show_tile = true %}{% endunless %}{% endif %}{% if show_tile %}{% render 'ep-category-menu-tile', link: link, section: section, group_heading: block.settings.heading, icon: block.settings.icon, tint: block.settings.tint %}{% endif %}{% endfor %}{% endfor %}</div></div><button class="ep-group-toggle" type="button" aria-expanded="false" aria-controls="ep-tiles-{{ block.id }}" data-less="{{ 'ep.show_less' | t }}" hidden>{{ 'ep.show_all_count' | t: count: group_links.size }}</button></ep-category-group>{% endif %}{% endif %}{% endfor %}</div></section>
{% schema %}
{
  "name": "t:ep.everyday_category_grids",
  "tag": "div",
  "class": "ep-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:ep.accessible_title",
      "default": "Shop by category"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_coming_soon",
      "label": "t:ep.final_show_coming_soon_for_empty_collections",
      "default": true
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:ep.final_subtitle"
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:ep.category_group",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.category_menu"
        },
        {
          "type": "collection",
          "id": "department",
          "label": "t:ep.department_source"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.see_all_link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:ep.polish_parent_category_icon",
          "options": [
            {
              "value": "basket",
              "label": "t:ep.polish_basket"
            },
            {
              "value": "bottle",
              "label": "t:ep.polish_bottle"
            },
            {
              "value": "gift",
              "label": "t:ep.polish_gift"
            },
            {
              "value": "soap",
              "label": "t:ep.polish_soap"
            },
            {
              "value": "home",
              "label": "t:ep.polish_home"
            },
            {
              "value": "paw",
              "label": "t:ep.polish_paw"
            },
            {
              "value": "pencil",
              "label": "t:ep.polish_pencil"
            }
          ],
          "default": "basket"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "t:ep.polish_coming_soon_tint",
          "options": [
            {
              "value": "blue",
              "label": "t:ep.polish_blue"
            },
            {
              "value": "cream",
              "label": "t:ep.polish_cream"
            },
            {
              "value": "green",
              "label": "t:ep.polish_green"
            },
            {
              "value": "pink",
              "label": "t:ep.polish_pink"
            },
            {
              "value": "lilac",
              "label": "t:ep.polish_lilac"
            },
            {
              "value": "peach",
              "label": "t:ep.polish_peach"
            }
          ],
          "default": "cream"
        }
      ]
    },
    {
      "type": "image_override",
      "name": "t:ep.tile_image_override",
      "settings": [
        {
          "type": "text",
          "id": "group_heading",
          "label": "t:ep.target_group_heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.target_link_url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:ep.everyday_category_grids"
    }
  ]
}
{% endschema %}
