<section class="ep-festive-hero ep-wrap" aria-labelledby="ep-festive-title"><div><h1 id="ep-festive-title">{{ section.settings.title | escape }}</h1><p>{{ section.settings.subtitle | escape }}</p>{% if section.settings.link != blank %}<a class="ep-cta" href="{% render 'ep-stock-url', url: section.settings.link %}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>{% if section.settings.image %}<div class="ep-festive-collage">{{ section.settings.image | image_url: width: 480 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '180, 240, 360, 480', sizes: '(min-width:990px) 400px, 45vw', alt: section.settings.title }}</div>{% else %}{% assign shown = 0 %}{% capture photos %}{% paginate section.settings.collection.products by 250 %}{% for candidate in section.settings.collection.products %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if allowed == '0' or candidate.featured_image == blank %}{% continue %}{% endif %}{{ candidate.featured_image | image_url: width: 240 | image_tag: loading: 'eager', widths: '120, 180, 240', sizes: '(min-width:990px) 160px, 25vw', alt: candidate.title }}{% assign shown = shown | plus: 1 %}{% if shown == 3 %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endcapture %}{% if shown > 0 %}<div class="ep-festive-collage">{{ photos }}</div>{% endif %}{% endif %}</section>
{% assign now = 'now' | date: '%s' | plus: 0 %}{% assign next_time = 0 %}{% assign next_name = blank %}{% for block in section.blocks %}{% assign event_time = block.settings.date | append: 'T00:00:00+04:00' | date: '%s' | plus: 0 %}{% if event_time > now %}{% if next_time == 0 or event_time < next_time %}{% assign next_time = event_time %}{% assign next_name = block.settings.name %}{% endif %}{% endif %}{% endfor %}{% if next_time > 0 and section.settings.show_countdown %}{% assign seconds = next_time | minus: now %}{% assign days = seconds | divided_by: 86400 %}{% assign hours = seconds | modulo: 86400 | divided_by: 3600 %}{% assign minutes = seconds | modulo: 3600 | divided_by: 60 %}{% capture event_data %}[{% for block in section.blocks %}{% assign event_time = block.settings.date | append: 'T00:00:00+04:00' | date: '%s' | plus: 0 %}{"name":{{ block.settings.name | json }},"time":{{ event_time }}}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}<div data-events="{{ event_data | escape }}" class="ep-festive-countdown ep-wrap" data-ep-countdown data-time="{{ next_time }}" data-event="{{ next_name | escape }}" data-label="{{ 'ep4.countdown' | t: event: '__EVENT__', days: '__DAYS__', hours: '__HOURS__' | escape }}"><strong data-countdown-event>{{ next_name | escape }}</strong><span class="ep-countdown-box"><b data-countdown-days>{{ days }}</b><small>{{ 'ep6.days' | t }}</small></span><span class="ep-countdown-box"><b data-countdown-hours>{{ hours }}</b><small>{{ 'ep6.hours' | t }}</small></span><span class="ep-countdown-box"><b data-countdown-minutes>{{ minutes }}</b><small>{{ 'ep6.minutes' | t }}</small></span></div>{% endif %}
{% schema %}
{"name":"t:ep4.festive_section","settings":[{"type":"text","id":"title","label":"t:ep.title","default":"Festive Store"},{"type":"text","id":"subtitle","label":"t:ep.subtitle","default":"Gifts, sweets and home décor for the season"},{"type":"text","id":"button_label","label":"t:ep.button_label","default":"Shop gifts"},{"type":"url","id":"link","label":"t:ep.link"},{"type":"collection","id":"collection","label":"t:ep.collection"},{"type":"image_picker","id":"image","label":"t:ep.image"},{"type":"checkbox","id":"show_countdown","label":"t:ep4.show_countdown","default":true}],"blocks":[{"type":"event","name":"t:ep4.event","limit":8,"settings":[{"type":"text","id":"name","label":"t:ep.title"},{"type":"text","id":"date","label":"t:ep4.event_date","info":"YYYY-MM-DD"}]}],"presets":[{"name":"t:ep4.festive_section"}]}
{% endschema %}
