<commerce-taxonomy><section class="page-width dc-section dc-taxonomy" aria-labelledby="Taxonomy-{{ section.id }}">
  <h2 id="Taxonomy-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  <p class="dc-taxonomy__intro">{{ section.settings.intro | escape }}</p>
  <span id="tech-essentials"></span>
  <div class="dc-directory__tools" hidden><label for="TaxonomySearch-{{ section.id }}">{{ 'commerce.find_department' | t }}</label><div class="dc-directory__search"><input type="search" id="TaxonomySearch-{{ section.id }}" name="department" aria-controls="TaxonomyGrid-{{ section.id }}"><button type="button">{{ 'general.search.reset' | t }}</button></div><p role="status" data-taxonomy-status data-label="{{ 'commerce.department_count' | t | escape }}"></p></div>
  <div class="dc-taxonomy__grid" id="TaxonomyGrid-{{ section.id }}">
    {% for block in section.blocks %}
      <article class="dc-taxonomy__card" id="{{ block.settings.anchor | escape }}" {{ block.shopify_attributes }}>
        {% case block.settings.anchor %}{% when 'baby-products' %}<span id="baby-care"></span>{% when 'grocery' %}<span id="pantry"></span>{% when 'bath-body' %}<span id="personal-care"></span>{% when 'home' %}<span id="home-care"></span><span id="on-the-go"></span>{% endcase %}
        <span class="dc-taxonomy__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.description | escape }}</p>
        <details><summary>Explore the planned range</summary>
          <ul>{% assign items = block.settings.items | split: '|' %}{% for item in items %}<li>{{ item | escape }}</li>{% endfor %}</ul>
        </details>
        {% if block.settings.future != blank %}<p class="dc-taxonomy__note">Outside the current launch plan: {{ block.settings.future | replace: '|', ', ' | escape }}.</p>{% endif %}
      </article>
    {% endfor %}
  </div>
<p data-taxonomy-empty hidden>{{ 'commerce.no_department' | t }}</p></section></commerce-taxonomy>
{% stylesheet %}
.dc-taxonomy{--taxonomy-gap:2rem;--taxonomy-padding:2.4rem}
.dc-taxonomy__intro{max-width:65ch;line-height:1.7;color:var(--dc-muted)}
.dc-taxonomy__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--taxonomy-gap)}
.dc-taxonomy__card{position:relative;min-width:0;padding:var(--taxonomy-padding);border:1px solid var(--dc-line);border-radius:var(--dc-radius);scroll-margin-block-start:var(--taxonomy-gap)}
.dc-taxonomy__number{display:inline-grid;place-items:center;width:3.6rem;height:3.6rem;border-radius:50%;background:var(--dc-cream);color:var(--dc-forest);font-weight:700}
.dc-taxonomy__card h3{font-size:2.6rem;margin-block:1.2rem}
.dc-taxonomy__card p,.dc-taxonomy__card li{font-size:1.4rem;line-height:1.7;overflow-wrap:anywhere}
.dc-taxonomy__card summary{cursor:pointer;min-height:4.4rem;padding-block:1rem;font-weight:650;font-size:1.4rem}
.dc-taxonomy__card ul{padding-inline-start:2rem}
.dc-taxonomy__note{color:var(--dc-muted);border-block-start:1px solid var(--dc-line);padding-block-start:1rem}
@media(max-width:749px){.dc-taxonomy__grid{grid-template-columns:1fr}.dc-taxonomy{--taxonomy-padding:1.8rem}}
.dc-taxonomy__card[hidden]{display:none}
.dc-taxonomy .dc-directory__tools{margin-block:2rem;max-width:55rem}
.dc-taxonomy .dc-directory__search{display:flex;gap:1rem}
.dc-taxonomy .dc-directory__search input{min-width:0;flex:1;padding:1rem;font:inherit;font-size:1.6rem;border:1px solid var(--dc-olive);border-radius:.6rem}
.dc-taxonomy .dc-directory__search button{min-height:4.4rem;border:1px solid var(--dc-olive);background:var(--dc-cream);color:var(--dc-forest);border-radius:.6rem;padding:1rem;cursor:pointer}
{% endstylesheet %}
{% javascript %}
if (!customElements.get('commerce-taxonomy')) customElements.define('commerce-taxonomy', class extends HTMLElement {
  connectedCallback() {
    this.controller?.abort(); this.controller = new AbortController();
    const opts = {signal:this.controller.signal};
    const input = this.querySelector('input');
    const cards = [...this.querySelectorAll('.dc-taxonomy__card')];
    const status = this.querySelector('[data-taxonomy-status]');
    const filter = () => {
      const term = input.value.trim().toLocaleLowerCase(); let count = 0;
      for (const card of cards) {card.hidden = !card.textContent.toLocaleLowerCase().includes(term); if (!card.hidden) count++;}
      status.textContent = status.dataset.label.replace('[count]',count).replace('[total]',cards.length);
      this.querySelector('[data-taxonomy-empty]').hidden = count > 0;
    };
    this.querySelector('.dc-directory__tools').hidden = false;
    input.addEventListener('input',filter,opts);
    this.querySelector('button').addEventListener('click',()=>{input.value='';filter();input.focus();},opts);
    window.addEventListener('hashchange',()=>{input.value='';filter();document.getElementById(location.hash.slice(1))?.scrollIntoView();},opts);
    filter();
  }
  disconnectedCallback(){this.controller?.abort();}
});
{% endjavascript %}
{% schema %}
{"name":"Commerce category map","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"intro","label":"Introduction"}],"blocks":[{"type":"category","name":"Department","settings":[{"type":"text","id":"title","label":"Department name"},{"type":"text","id":"anchor","label":"Navigation anchor"},{"type":"textarea","id":"description","label":"Description"},{"type":"textarea","id":"items","label":"Subcategories separated by |"},{"type":"textarea","id":"future","label":"Outside launch plan separated by |"}]}],"max_blocks":8,"presets":[{"name":"Commerce category map"}]}
{% endschema %}
