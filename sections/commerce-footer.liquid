<footer class="dc-footer"><div class="page-width dc-footer__grid"><div><a href="{{ routes.root_url }}" class="dc-wordmark">{{ section.settings.wordmark | escape }}<span></span></a><p>{{ section.settings.message | escape }}</p><p class="dc-footer__small">{{ section.settings.note | escape }}</p></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.title | escape }}</h2>{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}{{ block.settings.content }}{% endfor %}</div>{% endfor %}</div><div class="page-width dc-footer__base"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | escape }}</span><span>{{ 'commerce.currency_note' | t }}</span></div></footer>
<nav class="dc-mobile-nav" aria-label="{{ 'commerce.mobile_nav' | t }}">
<a href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}>{% render 'commerce-icon', name:'home' %}{{ 'commerce.home' | t }}</a>
<a href="{{ pages['departments'].url }}"{% if page.handle == 'departments' or template.name == 'collection' or template.name == 'product' or page.handle == 'product-preview' %} aria-current="location"{% endif %}>{% render 'commerce-icon', name:'shop' %}{{ 'commerce_experience.categories' | t }}</a>
<a data-search-overlay href="{{ routes.search_url }}"{% if template.name == 'search' %} aria-current="page"{% endif %}>{% render 'commerce-icon', name:'search' %}{{ 'general.search.search' | t }}</a>
<a href="{{ pages['wishlist'].url | default: routes.collections_url }}" data-feature="wishlist">{% render 'commerce-icon', name:'heart' %}{{ 'commerce_experience.wishlist' | t }}</a>
<a href="{{ routes.cart_url }}"{% if template.name == 'cart' %} aria-current="page"{% endif %}>{% render 'commerce-icon', name:'cart' %}{{ 'commerce.basket' | t }}</a>
</nav>
{% schema %}
{"name":"Commerce footer","settings":[{"type":"text","id":"wordmark","label":"Working wordmark","default":"everyday"},{"type":"text","id":"message","label":"Message","default":"Little essentials. One useful basket."},{"type":"text","id":"note","label":"Note","default":"A new everyday store for Dubai. Launch details coming soon."}],"blocks":[{"type":"links","name":"Link column","settings":[{"type":"text","id":"title","label":"Heading"},{"type":"link_list","id":"menu","label":"Menu"},{"type":"html","id":"content","label":"Links while menu is being set up"}]}],"max_blocks":3}
{% endschema %}
