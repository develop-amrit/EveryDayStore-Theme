<section class="qc-section qc-wrap qc-reveal"><div class="qc-section-heading"><h2>{% render 'ep-money-copy', text: section.settings.heading %}</h2>{% if section.settings.collection != blank %}<a href="{{ section.settings.view_all | default: section.settings.collection.url }}">{{ 'qc.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div><p class="qc-section-intro">{% render 'ep-money-copy', text: section.settings.text %}</p><div class="qc-products qc-grid" data-product-section>{% render 'qc-product-list', collection: section.settings.collection, limit: section.settings.limit %}</div></section>
{% schema %}
{
  "name": "Dubai essentials grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For whatever the day needs"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Cupboard keepers, home helpers and the things you reach for daily."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "view_all",
      "label": "View all link"
    }
  ],
  "presets": [
    {
      "name": "Dubai essentials grid"
    }
  ]
}
{% endschema %}
