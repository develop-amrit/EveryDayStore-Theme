<section class="ep-wrap ep-contact ep-section" aria-labelledby="ep-contact-title"><h1 id="ep-contact-title">{{ 'ep7.contact_title' | t }}</h1><div class="ep-contact-card"><p><strong>{{ 'ep7.email_us' | t }}</strong> <a href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }}</a></p>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'ep7.order_help' | t }}</a>{% endif %}{% if settings.social_whatsapp_link != blank %}<a href="{{ settings.social_whatsapp_link }}">WhatsApp</a>{% endif %}</div>
{% form 'contact', id: 'EPContactForm' %}{% if form.posted_successfully? %}<div class="ep-contact-success" role="status" tabindex="-1">{{ 'ep7.success' | t }}</div>{% else %}{{ form.errors | default_errors }}
<div class="ep-contact-field"><label for="ep-contact-topic">{{ 'commerce.contact_topic' | t }}</label><select id="ep-contact-topic" name="contact[Topic]">{% assign topics = 'general,product,delivery,order,feedback' | split: ',' %}{% for topic in topics %}{% assign key = 'commerce.contact_' | append: topic %}<option>{{ key | t }}</option>{% endfor %}</select></div>
{% assign fields = 'name,email,phone' | split: ',' %}{% for field in fields %}{% assign key = 'ep7.' | append: field %}<div class="ep-contact-field"><label for="ep-contact-{{ field }}">{{ key | t }}{% unless field == 'phone' %} *{% endunless %}</label><input id="ep-contact-{{ field }}" name="contact[{{ field }}]" type="{% if field == 'email' %}email{% elsif field == 'phone' %}tel{% else %}text{% endif %}" autocomplete="{% if field == 'phone' %}tel{% else %}{{ field }}{% endif %}" value="{{ form[field] | escape }}"{% unless field == 'phone' %} required{% else %} placeholder="+971"{% endunless %} aria-describedby="ep-contact-{{ field }}-error"><small id="ep-contact-{{ field }}-error" class="ep-contact-error" aria-live="polite"></small></div>{% endfor %}
<div class="ep-contact-field"><label for="ep-contact-message">{{ 'ep7.message' | t }} *</label><textarea id="ep-contact-message" name="contact[body]" required aria-describedby="ep-contact-message-error">{{ form.body | escape }}</textarea><small id="ep-contact-message-error" class="ep-contact-error" aria-live="polite"></small></div><button class="button" type="submit" data-sending="{{ 'ep7.sending' | t }}">{{ 'ep7.send' | t }}</button>{% endif %}{% endform %}</section>
{% schema %}{"name":"Contact us","settings":[],"presets":[{"name":"Contact us"}]}{% endschema %}
