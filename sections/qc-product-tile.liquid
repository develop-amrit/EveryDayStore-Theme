{% if product.available or product.metafields.custom.show_when_sold_out.value == true %}<div data-product-tile>{% render 'qc-product-card', product: product %}{% capture item_data %}{"handle":{{ product.handle | json }},"title":{{ product.title | json }},"price":{{ product.price | money_without_currency | prepend: ' ' | prepend: shop.currency | json }},"pack":{{ product.metafields.custom.pack_size.value | default: product.selected_or_first_available_variant.title | json }},"specs":{{ product.metafields.custom.specifications.value | json }},"features":{{ product.metafields.custom.features.value | json }},"attributes":{{ product.metafields.custom.category_attributes.value | json }}}{% endcapture %}<script type="application/json" data-product-meta>{{ item_data | replace: '<', '\u003c' }}</script></div>{% endif %}
{% schema %}
{
  "name": "product tile",
  "settings": [],
  "presets": [
    {
      "name": "product tile"
    }
  ]
}
{% endschema %}
