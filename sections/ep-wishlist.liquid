<section class="ep-wrap ep-section ep-wishlist" data-saved-page="wishlist" data-ep-wishlist-page aria-labelledby="ep-wishlist-title"><h1 id="ep-wishlist-title">{{ 'ep7.wishlist_title' | t }}</h1><p data-wishlist-total aria-live="polite"></p><p data-saved-notice role="status"></p><div class="ep-collection-products" data-saved-products></div><div data-wishlist-empty hidden>{% render 'qc-icon', name: 'heart' %}<h2>{{ 'ep7.wishlist_empty' | t }}</h2><p>{{ 'ep7.wishlist_hint' | t }}</p><a class="button" href="{{ routes.collections_url }}">{{ 'ep7.browse' | t }}</a></div><script type="application/json" data-wishlist-labels>{"one":{{ 'ep7.item_one' | t | json }},"many":{{ 'ep7.item_many' | t | json }},"remove":{{ 'ep7.remove' | t | json }},"removed":{{ 'ep7.removed' | t | json }},"undo":{{ 'ep7.undo' | t | json }},"unavailable":{{ 'ep7.unavailable' | t | json }}}</script></section>
{% schema %}{"name":"Wishlist","settings":[],"presets":[{"name":"Wishlist"}]}{% endschema %}
