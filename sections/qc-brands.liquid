{% if section.blocks.size > 0 or request.design_mode %}
<section class="qc-section qc-wrap qc-reveal"><h2 class="qc-small-heading">{% render 'ep-money-copy', text: section.settings.heading %}</h2>{% if section.blocks.size > 0 %}<div class="qc-marquee"><div class="qc-marquee-track">{% for repeat in (1..2) %}<div class="qc-brand-set"{% if repeat == 2 %} aria-hidden="true" inert{% endif %}>{% for block in section.blocks %}<a href="{{ block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '180, 360, 540, 750, 1000', sizes: '130px' }}{% else %}<span>{% render 'ep-money-copy', text: block.settings.name %}</span>{% endif %}</a>{% endfor %}</div>{% endfor %}</div></div>{% elsif request.design_mode %}<p class="qc-empty">{{ 'qc.brands_empty' | t }}</p>{% endif %}</section>
{% endif %}
{% schema %}
{
  "name": "Brand logo marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Familiar names. Everyday favourites."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand logo",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Brand logo marquee"
    }
  ]
}
{% endschema %}

