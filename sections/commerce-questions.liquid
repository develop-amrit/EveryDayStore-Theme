<section class="page-width dc-section" data-help-group><div class="dc-questions"><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></div><div>{% for block in section.blocks %}<details data-help-question {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% stylesheet %}
.dc-questions{display:grid;grid-template-columns:1fr 1.6fr;gap:5rem;padding:3rem 0;border-top:1px solid #e5e8dc}.dc-questions h2{font-size:3rem;margin:0 0 1rem}.dc-questions p{font-size:1.4rem;line-height:1.7;max-width:60ch}.dc-questions details{border-bottom:1px solid #e5e8dc}.dc-questions summary{display:flex;justify-content:space-between;align-items:center;gap:2rem;cursor:pointer;min-height:5.6rem;font-weight:650;list-style:none;padding:1rem 0}.dc-questions summary::-webkit-details-marker{display:none}.dc-questions summary span{font-size:2rem}.dc-questions details[open] summary span{transform:rotate(45deg)}.dc-questions .rte{padding-bottom:1rem}@media(max-width:749px){.dc-questions{grid-template-columns:1fr;gap:1rem;padding:2rem 0}.dc-questions h2{font-size:2.5rem}}
{% endstylesheet %}
{% schema %}
{"name": "Commerce questions", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "textarea", "id": "intro", "label": "Introduction"}], "max_blocks": 10, "blocks": [{"type": "question", "name": "Question", "settings": [{"type": "text", "id": "question", "label": "Question"}, {"type": "richtext", "id": "answer", "label": "Answer"}]}], "presets": [{"name": "Commerce questions"}]}
{% endschema %}