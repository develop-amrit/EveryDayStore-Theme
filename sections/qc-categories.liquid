{% assign category_menu = section.settings.menu | default: settings.qc_catalog_menu %}
<section class="qc-section qc-wrap qc-reveal"><div id="qc-categories" class="qc-section-heading"><h2>{% render 'ep-money-copy', text: section.settings.heading %}</h2></div><div class="qc-category-rail" tabindex="0">{% for link in category_menu.links %}<a href="{{ link.url }}" class="qc-category"><span>{% if link.object.featured_image != blank %}{{ link.object.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '180, 360, 540, 750, 1000', sizes: '100px' }}{% elsif link.object.image != blank %}{{ link.object.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '180, 360, 540, 750, 1000', sizes: '100px' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'qc-placeholder' }}{% endif %}</span><strong>{{ link.title | escape }}</strong></a>{% else %}{% for block in section.blocks %}{% assign category = block.settings.collection %}{% if category != blank %}<a href="{{ category.url }}" class="qc-category" {{ block.shopify_attributes }}><span>{% if category.featured_image %}{{ category.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '180, 360, 540, 750, 1000', sizes: '100px' }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'qc-placeholder' }}{% endif %}</span><strong>{{ category.title | escape }}</strong></a>{% endif %}{% endfor %}{% if section.blocks.size == 0 %}<p class="qc-empty">{{ 'qc.menu_empty' | t }}</p>{% endif %}{% endfor %}</div></section>
{% schema %}
{
  "name": "Category rail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What’s on your list?"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Categories menu"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collection category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category rail"
    }
  ]
}
{% endschema %}


