    "faq": {
      "type": "qc-faq",
      "blocks": {
        "b0": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Order today for next-day delivery in supported Dubai areas. Your available delivery date is confirmed during checkout.</p>"
          }
        },
        "b1": {
          "type": "question",
          "settings": {
            "question": "What is the order cut-off time?",
            "answer": "<p>Check the delivery information shown at checkout for the current cut-off. Orders received after the applicable cut-off move to the next available delivery day.</p>"
          }
        },
        "b2": {
          "type": "question",
          "settings": {
            "question": "Which areas of Dubai do you deliver to?",
            "answer": "<p>Choose your area in the header. Final service availability is confirmed using your full delivery address at checkout.</p>"
          }
        },
        "b3": {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "<p>Cash on Delivery is available only when it is offered as a payment method at checkout. Otherwise, choose one of the secure online payment methods shown there.</p>"
          }
        },
        "b4": {
          "type": "question",
          "settings": {
            "question": "How much does delivery cost?",
            "answer": "<p>Delivery fees depend on your basket total. See the current tiers below; your final fee is confirmed at checkout.</p>",
            "show_fees": true
          }
        },
        "b5": {
          "type": "question",
          "settings": {
            "question": "What if something is not right with my order?",
            "answer": "<p>Please contact our support team using the contact page with your order number and details. Our published returns policy explains eligibility and the next steps.</p>"
          }
        },
        "bnpl": {
          "type": "question",
          "settings": {
            "question": "Can I pay in instalments?",
            "answer": "<p>Eligible instalment options are offered only if an approved provider is available at checkout. Provider eligibility and terms apply.</p>"
          }
        }
      },
      "block_order": [
        "b0",
