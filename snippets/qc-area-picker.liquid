{% doc %}Shared Dubai delivery-area selection; checkout validates the complete address.{% enddoc %}
<label class="qc-location">{% render 'qc-icon', name: 'pin' %}<span><small>{{ 'qc.delivery_to' | t }}</small><select data-area aria-label="{{ 'qc.select_area' | t }}"><option value="">{{ 'qc.select_area' | t }}</option>{% assign areas = settings.qc_areas | split: ',' %}{% for area in areas %}{% assign area_name = area | strip %}<option value="{{ area_name | escape }}"{% if cart.attributes['Delivery area'] == area_name %} selected{% endif %}>{{ area_name | escape }}</option>{% endfor %}</select></span></label>
