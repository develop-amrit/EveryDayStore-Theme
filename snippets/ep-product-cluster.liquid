{% doc %}Real product cluster with merchant art override and homepage tag exclusions.
@param {collection} collection - Source collection.
@param {image} [image] - Uploaded override.
@param {number} count - Maximum product images.
@param {string} [exclude_tags] - Comma-separated excluded tags.
@param {string} [title] - Alt fallback.
@param {string} [icon] - Empty state icon.
@param {boolean} [eager] - First visible cluster image priority.
{% enddoc %}
{% assign excluded_tags = exclude_tags | split: ',' %}{% if image %}{% assign alt = image.alt | default: title %}{{ image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '180, 300, 450, 600', sizes: '(min-width:990px) 300px, 45vw', alt: alt, class: 'ep-cluster-override' }}{% else %}{% assign shown = 0 %}{% for product in collection.products %}{% assign excluded = false %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and product.tags contains cleaned_tag %}{% assign excluded = true %}{% endif %}{% endfor %}{% if product.featured_image and excluded == false %}{% assign alt = product.featured_image.alt | default: product.title %}{% assign priority = 'auto' %}{% assign loading = 'lazy' %}{% if eager and shown == 0 %}{% assign priority = 'high' %}{% assign loading = 'eager' %}{% endif %}<span class="ep-cluster-item" data-ep-cluster-product="{{ product.handle }}">{{ product.featured_image | image_url: width: 270, format: 'webp' | image_tag: loading: loading, fetchpriority: priority, widths: '90, 180, 270', sizes: '(min-width:990px) 100px, 22vw', alt: alt }}</span>{% assign shown = shown | plus: 1 %}{% if shown >= count %}{% break %}{% endif %}{% endif %}{% endfor %}{% if shown == 0 %}{% render 'ep-soon', icon: icon %}{% endif %}{% endif %}