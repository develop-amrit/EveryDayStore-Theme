{% enddoc %}
{% if image %}{% render 'ep-auto-image', image: image, title: title, eager: eager %}{% else %}{% assign chosen = nil %}{% assign shown = 0 %}{% assign seen_products = '|' %}{% capture handles %}{{ collection.handle }}|{% for parent in settings.qc_catalog_menu.links %}{% if parent.object.id == collection.id %}{% for child in parent.links %}{{ child.object.handle }}|{% for leaf in child.links %}{{ leaf.object.handle }}|{% endfor %}{% endfor %}{% endif %}{% endfor %}{% endcapture %}{% assign handles = handles | split: '|' | uniq %}{% capture candidates %}[{% for handle in handles %}{% if shown == 20 %}{% break %}{% endif %}{% assign source = collections[handle] %}{% if source == blank %}{% continue %}{% endif %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.featured_image == blank or candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture marker %}|{{ candidate.id }}|{% endcapture %}{% if seen_products contains marker %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign seen_products = seen_products | append: marker %}{% if chosen == nil %}{% assign chosen = candidate %}{% endif %}{% if shown > 0 %},{% endif %}{"id":{{ candidate.id | json }},"title":{{ candidate.title | json }},"url":{{ candidate.featured_image | image_url: width: 240 | json }}}{% assign shown = shown | plus: 1 %}{% if shown == 20 %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endfor %}]{% endcapture %}
