{% doc %}AI interface only; all answers, verification, tickets and actions need the configured backend.{% enddoc %}
{% if settings.ai_endpoint != blank or settings.qc_support_phone != blank or request.design_mode %}<button type="button" class="qc-chat-launcher" data-chat-open aria-label="{{ 'qc.ai_launcher' | t }}">{% render 'qc-icon', name: 'account' %}<span>{{ 'qc.ai_title' | t }}</span></button>
<dialog id="qc-chat" class="qc-chat-dialog" aria-labelledby="qc-chat-title"><div class="qc-dialog-heading"><h2 id="qc-chat-title">{{ 'qc.ai_title' | t }}</h2><button type="button" data-dialog-close aria-label="{{ 'qc.close' | t }}">×</button></div><p>{{ 'qc.ai_greeting' | t }}</p>{% if settings.ai_endpoint == blank %}<p class="qc-integration-note">{{ 'qc.ai_disconnected' | t }}</p>{% endif %}<div class="qc-chat-quick"><button type="button" data-chat-quick>{{ 'qc.ai_quick_delivery' | t }}</button><button type="button" data-chat-quick>{{ 'qc.ai_quick_shopping' | t }}</button><button type="button" data-chat-quick>{{ 'qc.ai_quick_order' | t }}</button></div><ol class="qc-chat-log" role="log" aria-live="polite" data-chat-messages></ol><div data-chat-actions></div><form class="qc-form" data-chat-form method="post" action="{{ routes.root_url }}"><label>{{ 'qc.ai_message' | t }}<textarea name="message" maxlength="2000" required></textarea></label><label class="qc-check"><input name="consent" type="checkbox" required>{{ 'qc.ai_consent' | t }}</label><button class="qc-button"{% if settings.ai_endpoint == blank %} disabled{% endif %}>{{ 'qc.ai_send' | t }}</button><p role="status"></p></form><details><summary>{{ 'qc.ai_evidence' | t }}</summary><form class="qc-form" data-chat-evidence method="post" action="{{ routes.root_url }}" enctype="multipart/form-data"><label>{{ 'qc.ai_evidence' | t }}<input type="file" name="file" accept="image/jpeg,image/png,image/webp" required></label><button class="qc-button"{% if settings.ai_endpoint == blank %} disabled{% endif %}>{{ 'qc.ai_upload' | t }}</button><p role="status"></p></form></details><details data-chat-verification><summary>{{ 'qc.ai_verify' | t }}</summary><form class="qc-form" data-chat-challenge method="post" action="{{ routes.root_url }}"><label>{{ 'qc.order_number' | t }}<input name="order_number" maxlength="50" required autocomplete="off"></label><label>{{ 'qc.order_contact' | t }}<input name="contact" maxlength="150" required autocomplete="off"></label><button class="qc-button"{% if settings.ai_endpoint == blank %} disabled{% endif %}>{{ 'qc.send_code' | t }}</button><p role="status"></p></form><form class="qc-form" data-chat-verify method="post" action="{{ routes.root_url }}" hidden><label>{{ 'qc.verification_code' | t }}<input name="code" pattern="[0-9]{6}" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required></label><button class="qc-button">{{ 'qc.verify' | t }}</button><p role="status"></p></form></details><p class="qc-integration-note">{{ 'qc.ai_policy_notice' | t }} <a href="{{ shop.privacy_policy.url | default: '/pages/privacy-policy' }}">{{ 'qc.privacy' | t }}</a></p>{% if settings.qc_support_phone != blank %}<a class="qc-text-link" href="tel:{{ settings.qc_support_phone | remove: ' ' | escape }}">{{ 'qc.ai_human' | t }}: {{ settings.qc_support_phone | escape }}</a>{% endif %}</dialog>

{% endif %}
