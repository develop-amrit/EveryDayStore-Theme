{% doc %}A collection sidebar link; never hides an empty collection.
@param {collection} target - Linked collection.
@param {string} label - Label.
@param {string} icon - Department icon.
@param {boolean} active - Current second-level item.
{% enddoc %}
{% assign image = target.image %}{% if image == blank %}{% paginate target.products by 250 %}{% for product in target.products limit: 250 %}{% unless product.available %}{% continue %}{% endunless %}{% capture ep_visible %}{% render 'ep-content-visible', item: product %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% if product.featured_image %}{% assign image = product.featured_image %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}
{% capture ep_visible %}{% render 'ep-content-visible', item: target, kind: 'collection', title: label %}{% endcapture %}{% if ep_visible == '1' %}<a class="ep-rail-item" data-ep-collection-link href="{% render 'ep-stock-url', url: target.url %}"{% if active %} aria-current="page"{% endif %}><span class="ep-rail-photo">{% if image %}{% assign alt = image.alt | default: label %}{% capture image_markup %}{{ image | image_url: width: 112 | image_tag: loading: 'lazy', widths: '56, 112', sizes: '48px', alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}<span class="ep-soon-art">{% render 'ep-icon', name: icon %}</span>{% endif %}</span><span class="ep-rail-label{% if label.size > 30 %} ep-label-small{% endif %}">{{ label | escape }}</span></a>{% endif %}
