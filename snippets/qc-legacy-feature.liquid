{% doc %}Preserve older page routes without the retired competing commerce runtime.
@param {string} feature - Existing feature-page setting.{% enddoc %}
{% case feature %}{% when 'gifting' %}<form class="qc-form" action="{{ routes.cart_url }}" method="post" data-gift-note><label>{{ 'qc.gift_note' | t }}<textarea name="attributes[gift_message]" maxlength="500">{{ cart.attributes.gift_message | escape }}</textarea></label><p>{{ 'qc.gift_note_hint' | t }}</p><button class="qc-button">{{ 'qc.gift_note_save' | t }}</button><p role="status"></p></form>{% when 'occasions' %}{% render 'qc-menu', mobile: true %}{% when 'delivery' %}{% render 'qc-delivery-picker' %}{% render 'qc-delivery-tiers' %}{% when 'wishlist' %}<a class="qc-button" href="{{ pages['wishlist'].url | default: '/pages/wishlist' }}">{{ 'qc.wishlist' | t }}</a>{% when 'compare' %}<a class="qc-button" href="{{ pages['compare'].url | default: '/pages/compare' }}">{{ 'qc.compare' | t }}</a>{% when 'account' %}<a class="qc-button" href="{{ pages['buy-again'].url | default: routes.account_url }}">{{ 'qc.buy_again' | t }}</a>{% else %}<a class="qc-text-link" href="{{ pages['track-order'].url | default: '/pages/track-order' }}">{{ 'qc.track_order' | t }}</a><button type="button" class="qc-button" data-chat-open>{{ 'qc.ai_title' | t }}</button>{% endcase %}
