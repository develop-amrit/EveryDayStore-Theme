{% doc %}Collection tile with explicit collection image, real product fallback and designed empty state.
@param {link} link - Second-level menu link.
@param {section} section - Category grid section.
@param {string} group_heading - Group heading.
@param {string} icon - Parent outline icon.
@param {string} tint - Tint token suffix.
@param {boolean} [eager] - Load images in the first two department groups eagerly.
{% enddoc %}
{% capture has_stock %}{% render 'ep-has-stock', collection: link.object, exclude_tags: section.settings.exclude_tags %}{% endcapture %}{% assign tile_image = link.object.image %}{% if tile_image == blank %}{% assign excluded_tags = section.settings.exclude_tags | split: ',' %}{% paginate link.object.products by 250 %}{% for candidate in link.object.products limit: 250 %}{% unless candidate.available %}{% continue %}{% endunless %}{% capture ep_visible %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% assign excluded = false %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and candidate.tags contains cleaned_tag %}{% assign excluded = true %}{% endif %}{% endfor %}{% if excluded %}{% continue %}{% endif %}{% if candidate.featured_image != blank %}{% assign tile_image = candidate.featured_image %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}{% for override in section.blocks %}{% if override.type == 'image_override' and override.settings.link == link.url %}{% if override.settings.group_heading == blank or override.settings.group_heading == group_heading %}{% if override.settings.image != blank %}{% assign tile_image = override.settings.image %}{% endif %}{% endif %}{% endif %}{% endfor %}{% capture ep_visible %}{% render 'ep-content-visible', item: link.object, kind: 'collection', title: link.title, hide_prefix: section.settings.hide_title_prefix, hidden_handles: section.settings.hidden_collection_handles %}{% endcapture %}{% if ep_visible == '1' %}<a class="ep-tile ep-tint-{{ tint }}{% if tile_image == blank %} ep-tile--soon{% endif %}" href="{% render 'ep-stock-url', url: link.url %}"><span class="ep-tile-art">{% if tile_image %}{% assign alt = tile_image.alt | default: link.title %}{% assign tile_loading = 'lazy' %}{% if eager %}{% assign tile_loading = 'eager' %}{% endif %}{% capture image_markup %}{{ tile_image | image_url: width: 240 | image_tag: loading: tile_loading, decoding: 'async', widths: '120, 180, 240', sizes: '(min-width:990px) 120px, 23vw', alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}{% assign show_soon = section.settings.show_coming_soon %}{% if has_stock == '1' %}{% assign show_soon = false %}{% endif %}{% render 'ep-soon', icon: icon, show_badge: show_soon %}{% endif %}{% if tile_image and has_stock == '0' and section.settings.show_coming_soon != false %}{% unless template.name == 'index' or template.name == 'list-collections' %}{% endunless %}{% endif %}</span><span class="ep-tile-label{% if link.title.size > 30 %} ep-label-small{% endif %}">{{ link.title | escape }}</span></a>{% endif %}
