{% doc %}Collection tile with explicit collection image, real product fallback and designed empty state.
@param {link} link - Second-level menu link.
@param {section} section - Category grid section.
@param {string} group_heading - Group heading.
@param {string} icon - Parent outline icon.
@param {string} tint - Tint token suffix.
{% enddoc %}
{% assign tile_image = link.object.image %}{% if tile_image == blank %}{% assign excluded_tags = section.settings.exclude_tags | split: ',' %}{% for candidate in link.object.products %}{% capture ep_visible %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% assign excluded = false %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and candidate.tags contains cleaned_tag %}{% assign excluded = true %}{% endif %}{% endfor %}{% if excluded %}{% continue %}{% endif %}{% if candidate.featured_image != blank %}{% assign tile_image = candidate.featured_image %}{% break %}{% endif %}{% endfor %}{% endif %}{% for override in section.blocks %}{% if override.type == 'image_override' and override.settings.link == link.url %}{% if override.settings.group_heading == blank or override.settings.group_heading == group_heading %}{% assign tile_image = override.settings.image %}{% endif %}{% endif %}{% endfor %}{% capture ep_visible %}{% render 'ep-content-visible', item: link.object, kind: 'collection', title: link.title, hide_prefix: section.settings.hide_title_prefix, hidden_handles: section.settings.hidden_collection_handles %}{% endcapture %}{% if ep_visible == '1' %}<a class="ep-tile ep-tint-{{ tint }}{% if tile_image == blank %} ep-tile--soon{% endif %}" href="{{ link.url }}"><span class="ep-tile-art">{% if tile_image %}{% assign alt = tile_image.alt | default: link.title %}{% capture image_markup %}{{ tile_image | image_url: width: 270 | image_tag: loading: 'lazy', widths: '90, 180, 270', sizes: '(min-width:990px) 120px, 23vw', alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}{% assign show_soon = section.settings.show_coming_soon %}{% if link.object.all_products_count > 0 %}{% assign show_soon = false %}{% endif %}{% render 'ep-soon', icon: icon, show_badge: show_soon %}{% endif %}{% if tile_image and link.object.all_products_count == 0 and section.settings.show_coming_soon != false %}<span class="ep-soon-pill">{{ 'ep.soon' | t }}</span>{% endif %}</span><span class="ep-tile-label">{{ link.title | escape }}</span></a>{% endif %}
