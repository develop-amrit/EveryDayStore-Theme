{% doc %}Collection tile with explicit collection image, real product fallback and designed empty state.
@param {link} link - Second-level menu link.
@param {section} section - Category grid section.
@param {string} group_heading - Group heading.
@param {string} icon - Parent outline icon.
@param {string} tint - Tint token suffix.
{% enddoc %}
{% assign tile_image = link.object.image %}{% if tile_image == blank %}{% assign excluded_tags = section.settings.exclude_tags | split: ',' %}{% for candidate in link.object.products %}{% assign excluded = false %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and candidate.tags contains cleaned_tag %}{% assign excluded = true %}{% endif %}{% endfor %}{% if excluded %}{% continue %}{% endif %}{% if candidate.featured_image != blank %}{% assign tile_image = candidate.featured_image %}{% break %}{% endif %}{% endfor %}{% endif %}{% for override in section.blocks %}{% if override.type == 'image_override' and override.settings.link == link.url %}{% if override.settings.group_heading == blank or override.settings.group_heading == group_heading %}{% assign tile_image = override.settings.image %}{% endif %}{% endif %}{% endfor %}<a class="ep-tile ep-tint-{{ tint }}{% if tile_image == blank %} ep-tile--soon{% endif %}" href="{{ link.url }}"><span class="ep-tile-art">{% if tile_image %}{% assign alt = tile_image.alt | default: link.title %}{% capture image_markup %}{{ tile_image | image_url: width: 270 | image_tag: loading: 'lazy', widths: '90, 180, 270', sizes: '(min-width:990px) 120px, 23vw', alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}{% render 'ep-soon', icon: icon, show_badge: section.settings.show_coming_soon %}{% endif %}</span><span class="ep-tile-label">{{ link.title | escape }}</span></a>
