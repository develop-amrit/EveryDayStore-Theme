{% if variant != blank %}{% doc %}@param {variant} variant - Currently selected Shopify variant.{% enddoc %}<div class="qc-main-price"><strong>{{ variant.price | money_without_currency | prepend: ' ' | prepend: shop.currency }}</strong>{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money_without_currency | prepend: ' ' | prepend: shop.currency }}</s>{% assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round %}<span class="qc-tag">{{ discount }}% {{ 'qc.off' | t }}</span>{% endif %}</div>
{% else %}<p>{{ 'qc.out' | t }}</p>{% endif %}
