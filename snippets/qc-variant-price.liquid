{% if variant != blank %}{% doc %}@param {variant} variant - Currently selected Shopify variant.{% enddoc %}<div class="qc-main-price"><strong>{% assign ep_money_amount = variant.price %}{% render 'ep-money', amount: ep_money_amount %}</strong>{% if variant.compare_at_price > variant.price %}<s>{% assign ep_money_amount = variant.compare_at_price %}{% render 'ep-money', amount: ep_money_amount %}</s>{% assign discount = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round %}<span class="qc-tag">{{ discount }}% {{ 'qc.off' | t }}</span>{% endif %}</div>
{% else %}<p>{{ 'qc.out' | t }}</p>{% endif %}
