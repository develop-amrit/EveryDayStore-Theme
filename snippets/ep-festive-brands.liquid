{% doc %}Only vendors stocked in the merchant-selected Festive source collections.
@param {section} section - Brand strip settings.
{% enddoc %}
{% assign seen_vendors = '|' %}{% assign shown = 0 %}
{% capture tiles %}{% for source in section.settings.festive_collections %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% if shown == 8 %}{% break %}{% endif %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.featured_image == blank or candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign vendor_key = candidate.vendor | strip | downcase %}{% if vendor_key == blank %}{% continue %}{% endif %}{% capture marker %}|{{ vendor_key }}|{% endcapture %}{% if seen_vendors contains marker %}{% continue %}{% endif %}{% assign seen_vendors = seen_vendors | append: marker %}{% assign shown = shown | plus: 1 %}<a class="ep-brand-tile" href="{{ routes.collections_url }}/vendors?q={{ candidate.vendor | url_encode }}&amp;filter.v.availability=1"><span class="ep-ad ep-auto-well">{{ candidate.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', decoding: 'async', widths: '120, 180, 240', sizes: '40vw', alt: candidate.title }}</span><strong>{{ candidate.vendor | escape }}</strong></a>{% endfor %}{% endpaginate %}{% if shown == 8 %}{% break %}{% endif %}{% endfor %}{% endcapture %}{% assign tiles = tiles | strip %}{% if tiles != blank %}<section class="ep-section color-{{ section.settings.color_scheme }}" aria-labelledby="ep-heading-{{ section.id }}" style="--ep-top:{{ section.settings.padding_top }}px;--ep-bottom:{{ section.settings.padding_bottom }}px"><div class="ep-wrap"><h2 class="ep-brand-heading" id="ep-heading-{{ section.id }}">{{ section.settings.title | escape }}</h2></div><div class="ep-ads ep-rail ep-brand-rail">{{ tiles }}</div></section>{% endif %}
