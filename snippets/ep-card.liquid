{% doc %}
Shared homepage card, without compare controls.
@param {product} product - Shopify product.
@param {string} variant - compact, grid or rated.
{% enddoc %}
{% assign item = product.selected_or_first_available_variant %}{% assign add_style = 'plus' %}{% if variant != 'compact' %}{% assign add_style = 'add' %}{% endif %}
<article class="ep-card ep-card--{{ variant }}" data-ep-product="{{ product.id }}">
<div class="ep-image-well"><a class="ep-image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{% assign image_alt = product.featured_image.alt | default: product.title %}{{ product.featured_image | image_url: width: 480, format: 'webp' | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480', sizes: '(min-width: 990px) 180px, (min-width: 750px) 22vw, 30vw', alt: image_alt }}{% endif %}</a>{% render 'ep-price', item: item, badge: true %}<button class="ep-wish" type="button" data-wishlist="{{ product.handle | escape }}" aria-label="{{ 'ep.wishlist_product' | t: title: product.title | escape }}" aria-pressed="false">{% render 'qc-icon', name: 'heart' %}</button>{% render 'ep-add-button', product: product, item: item, style: add_style %}</div>
<div class="ep-card-copy">{% if variant == 'rated' and product.vendor != blank %}<span class="ep-vendor">{{ product.vendor | escape }}</span>{% endif %}{% unless variant == 'rated' %}{% render 'ep-price', item: item %}{% endunless %}<h3><a href="{{ product.url }}">{{ product.metafields.custom.card_title.value | default: product.title | escape }}</a></h3><p class="ep-pack">{% if product.metafields.custom.pack_size.value != blank %}{{ product.metafields.custom.pack_size.value | escape }}{% elsif product.has_only_default_variant == false %}{{ item.title | escape }}{% endif %}</p>{% if variant == 'rated' %}{% if product.metafields.custom.spec_tag.value != blank %}<span class="ep-spec">{{ product.metafields.custom.spec_tag.value | escape }}</span>{% endif %}{% render 'ep-price', item: item %}{% if product.metafields.reviews.rating.value.rating != blank and product.metafields.reviews.rating_count.value != blank %}<span class="ep-rating" aria-label="{{ 'ep.rating_label' | t: rating: product.metafields.reviews.rating.value.rating, count: product.metafields.reviews.rating_count.value | escape }}"><span aria-hidden="true">★</span> {{ product.metafields.reviews.rating.value.rating }} ({{ product.metafields.reviews.rating_count.value }})</span>{% endif %}{% endif %}<p class="ep-error" role="status" data-ep-error></p></div></article>
