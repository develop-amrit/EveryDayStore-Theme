{% doc %}Stock-only department suggestions, topped up with store best sellers.
@param {collection} department - Department source.
@param {string} department_title - Display name.
{% enddoc %}
{% assign shown = 0 %}{% assign selected = ',' %}{% assign own_count = 0 %}{% capture cards %}{% for pass in (1..2) %}{% assign source = department %}{% if pass == 2 %}{% if shown >= 4 %}{% break %}{% endif %}{% assign source = collections.all %}{% endif %}{% if source != blank %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% unless allowed == '1' %}{% continue %}{% endunless %}{% assign marker = candidate.id | prepend: ',' | append: ',' %}{% if selected contains marker %}{% continue %}{% endif %}{% render 'ep-card', product: candidate, variant: 'grid', eager: true %}{% assign selected = selected | append: candidate.id | append: ',' %}{% assign shown = shown | plus: 1 %}{% if pass == 1 %}{% assign own_count = own_count | plus: 1 %}{% endif %}{% if shown >= 8 %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}{% endfor %}{% endcapture %}{% if shown > 0 %}<div class="ep-empty-suggestions"><h2>{% if shown == own_count and own_count > 0 %}{{ 'ep3.popular_department' | t: department: department_title }}{% else %}{{ 'ep3.popular' | t }}{% endif %}</h2><div class="ep-collection-products ep-recommendations">{{ cards }}</div></div>{% endif %}
