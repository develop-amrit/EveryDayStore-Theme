{%- doc -%}Available real discounts ranked by percentage, largest first, within a 250-product batch.
@param {product[]} products - Products from the enclosing pagination.
@param {number} [limit] - Maximum cards.
@param {string} [variant] - Product card style.
@param {string} [exclude_tags] - Comma separated tags to exclude.
{%- enddoc -%}
{%- assign excluded_tags = exclude_tags | default: 'homepage-hide' | split: ',' -%}
{%- capture ranked -%}{%- for candidate in products limit: 250 -%}
{%- unless candidate.available -%}{%- continue -%}{%- endunless -%}
{%- assign item = candidate.selected_or_first_available_variant -%}{%- unless item.compare_at_price > item.price -%}{%- continue -%}{%- endunless -%}
{%- capture visible -%}{% render 'ep-content-visible', item: candidate %}{%- endcapture -%}{%- if visible == '0' -%}{%- continue -%}{%- endif -%}
{%- assign excluded = false -%}{%- for tag in excluded_tags -%}{%- assign tag = tag | strip -%}{%- if tag != blank and candidate.tags contains tag -%}{%- assign excluded = true -%}{%- endif -%}{%- endfor -%}{%- if excluded -%}{%- continue -%}{%- endif -%}
{%- assign score = item.compare_at_price | minus: item.price | times: 100000000 | divided_by: item.compare_at_price | prepend: '0000000000' | slice: -10, 10 -%}{{- score -}}|{{- candidate.handle -}},
{%- endfor -%}{%- endcapture -%}
{%- assign ranks = ranked | split: ',' | sort | reverse -%}{%- assign cap = limit | default: 250 -%}{%- assign shown = 0 -%}
{%- for rank in ranks limit: cap -%}{%- assign selected_handle = rank | split: '|' | last -%}{%- if selected_handle == blank -%}{%- continue -%}{%- endif -%}
{%- for candidate in products limit: 250 -%}{%- if candidate.handle == selected_handle -%}{%- assign eager = false -%}{%- if shown < 6 -%}{%- assign eager = true -%}{%- endif -%}{% render 'ep-card', product: candidate, variant: variant, eager: eager %}{%- assign shown = shown | plus: 1 -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- endfor -%}
