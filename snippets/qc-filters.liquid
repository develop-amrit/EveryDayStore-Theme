{% doc %}Native Shopify storefront filters and sort choices.
@param {object} results - Collection or search object.{% enddoc %}
<form method="get" class="qc-filters"><input type="hidden" name="filter.v.availability" value="1"><h2>{{ 'qc.filters' | t }}</h2>{% if template.name == 'search' %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="options[fields]" value="title,vendor,product_type,tag"><input type="hidden" name="options[prefix]" value="last"><input type="hidden" name="type" value="product">{% endif %}<div class="qc-filter-row">{% for filter in results.filters %}{% if filter.param_name == 'filter.v.availability' %}{% continue %}{% endif %}<details><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="qc-filter-values">{% if filter.type == 'price_range' %}<label>{{ 'qc.from' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'qc.to' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% else %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% endif %}</div></details>{% endfor %}<label class="qc-sort">{{ 'qc.sort' | t }}<select name="sort_by">{% assign selected_sort = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label><button class="qc-button">{{ 'qc.apply' | t }}</button>{% if template.name == 'search' %}<a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&amp;type=product&amp;filter.v.availability=1">{{ 'qc.reset' | t }}</a>{% else %}<a href="{% render 'ep-stock-url', url: collection.url %}">{{ 'qc.reset' | t }}</a>{% endif %}</div></form>
