{% doc %}Department icons for collection links without an image.
@param {string} [handle] - Collection handle; custom categories use a grid icon.{% enddoc %}
{% assign department = handle | split: '-' | first %}
<svg class="qc-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% case department %}
    {% when 'grocery' %}<path d="m3 9 2 12h14l2-12H3Zm4 0 5-7 5 7M9 13v4m6-4v4"/>
    {% when 'baby' %}<path d="M4 5c4 2 12 2 16 0l2 5-4 10H6L2 10l2-5Zm1 5h14M7 12c3 1 4 5 3 8m7-8c-3 1-4 5-3 8"/>
    {% when 'gifting' %}<path d="M3 8h18v5H3zM5 13v8h14v-8M12 8v13"/><path d="M12 8C3 8 5 0 9 3c2 1 3 5 3 5Zm0 0c9 0 7-8 3-5-2 1-3 5-3 5Z"/>
    {% when 'bath' %}<path d="M12 2c-2 5-8 9-8 13a8 8 0 0 0 16 0c0-4-6-8-8-13Z"/><path d="M8 15a4 4 0 0 0 4 4"/>
    {% when 'home' %}<path d="m2 11 10-8 10 8M5 10v11h14V10M10 21v-7h4v7"/>
    {% when 'pet' %}<ellipse cx="5" cy="9" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="5" rx="2" ry="3"/><ellipse cx="21" cy="10" rx="2" ry="3"/><path d="M6 17c0-3 4-6 6-6s6 3 6 6c0 5-4 2-6 2s-6 3-6-2Z"/>
    {% when 'office' %}<path d="M4 3h13v18H4zM8 3v18m3-13h3m-3 4h3m6-8 2 2-6 10-3 1v-3l7-10Z"/>
    {% else %}<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>
  {% endcase %}
</svg>
