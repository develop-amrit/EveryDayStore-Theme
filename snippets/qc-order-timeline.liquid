{% doc %}Authenticated storefront fallback; hosted new-account detail needs an extension.
@param {order} order - Order from the authenticated customer's order collection.{% enddoc %}
{% if customer and order != blank %}{% if order.cancelled %}<p>{{ 'qc.order_cancelled' | t }}</p>{% else %}{% assign state = order.metafields.custom.delivery_status.value | default: 'confirmed' %}{% assign steps = 'confirmed,processing,packed,out_for_delivery,delivered' | split: ',' %}<ol class="qc-timeline" aria-label="{{ 'qc.delivery_tracking' | t }}">{% for step in steps %}<li{% if step == state %} aria-current="step"{% endif %}>{% if step == 'confirmed' %}{{ 'qc.order_confirmed' | t }}{% else %}{% assign key = 'qc.' | append: step %}{{ key | t }}{% endif %}</li>{% endfor %}</ol>{% endif %}{% endif %}
