{% doc %}Uploaded art wins; otherwise use a real available product image or a neutral placeholder.
@param {image} [image] - Uploaded image.
@param {collection} [collection] - Collection fallback.
@param {product} [product] - Optional selected vendor product.
@param {string} [title] - Alt fallback.
@param {boolean} [eager] - Above-fold image priority.
@param {boolean} [discounted] - Choose only a real discounted product.
{% enddoc %}
{% assign auto_image = image %}{% if auto_image == blank %}{% assign auto_product = product %}{% if auto_product == blank and collection != blank %}{% for candidate in collection.products %}{% if candidate.available and candidate.featured_image != blank %}{% if discounted %}{% assign variant = candidate.selected_or_first_available_variant %}{% if variant.compare_at_price <= variant.price %}{% continue %}{% endif %}{% endif %}{% assign auto_product = candidate %}{% break %}{% endif %}{% endfor %}{% endif %}{% assign auto_image = auto_product.featured_image %}{% endif %}{% if auto_image %}{% assign alt = auto_image.alt | default: title %}{% if eager %}{{ auto_image | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '120, 240, 400, 600, 800', sizes: '(min-width:990px) 420px, 40vw', alt: alt }}{% else %}{{ auto_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '90, 180, 300, 450, 600', sizes: '(min-width:990px) 240px, 30vw', alt: alt }}{% endif %}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}