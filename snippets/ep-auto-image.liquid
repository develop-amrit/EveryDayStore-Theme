{% doc %}Uploaded art wins; otherwise use a real available product image or a neutral placeholder.
@param {string} [exclude_tags] - Comma separated homepage-only exclusion tags.
@param {image} [image] - Uploaded image.
@param {collection} [collection] - Collection fallback.
@param {product} [product] - Optional selected vendor product.
@param {string} [title] - Alt fallback.
@param {boolean} [eager] - Above-fold image priority.
@param {string} [vendor] - Restrict vendor fallback images.
@param {string} [icon] - Empty collection parent icon.
@param {string} [image_sizes] - Actual rendered image slot sizes.
@param {boolean} [discounted] - Choose only a real discounted product.
{% enddoc %}
{% assign lazy_sizes = image_sizes | default: '(min-width:990px) 160px, 25vw' %}{% assign eager_sizes = image_sizes | default: '(min-width:990px) 420px, 40vw' %}{% assign excluded_tags = exclude_tags | default: 'homepage-hide' | split: ',' %}{% capture has_stock %}{% render 'ep-has-stock', collection: collection, exclude_tags: exclude_tags %}{% endcapture %}{% assign auto_image = image %}{% if auto_image == blank and vendor == blank %}{% assign auto_image = collection.image %}{% endif %}{% if auto_image == blank %}{% assign auto_product = product %}{% unless auto_product.available %}{% assign auto_product = nil %}{% endunless %}{% if vendor != blank and auto_product.vendor != vendor %}{% assign auto_product = nil %}{% endif %}{% if auto_product != blank %}{% capture ep_visible %}{% render 'ep-content-visible', item: auto_product %}{% endcapture %}{% if ep_visible == '0' %}{% assign auto_product = nil %}{% endif %}{% endif %}{% if request.page_type == 'index' and auto_product != blank %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and auto_product.tags contains cleaned_tag %}{% assign auto_product = nil %}{% endif %}{% endfor %}{% endif %}{% if auto_product == nil %}{% paginate collection.products by 250 %}{% for candidate in collection.products limit: 250 %}{% unless candidate.available %}{% continue %}{% endunless %}{% capture ep_visible %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% if vendor != blank and candidate.vendor != vendor %}{% continue %}{% endif %}{% assign exclude_product = false %}{% if request.page_type == 'index' %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and candidate.tags contains cleaned_tag %}{% assign exclude_product = true %}{% endif %}{% endfor %}{% endif %}{% if exclude_product %}{% continue %}{% endif %}{% if candidate.featured_image != blank %}{% if discounted %}{% assign variant = candidate.selected_or_first_available_variant %}{% if variant.compare_at_price <= variant.price %}{% continue %}{% endif %}{% endif %}{% assign auto_product = candidate %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% endif %}{% assign auto_image = auto_product.featured_image %}{% endif %}{% if auto_image %}{% assign alt = auto_image.alt | default: title %}{% if eager %}{% capture image_markup %}{{ auto_image | image_url: width: 480 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '120, 180, 240, 360, 480', sizes: eager_sizes, alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% else %}{% capture image_markup %}{{ auto_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480', sizes: lazy_sizes, alt: alt }}{% endcapture %}{% render 'ep-deferred-image', image_markup: image_markup %}{% endif %}{% if has_stock == '0' and collection != blank %}{% unless template.name == 'index' %}<span class="ep-soon-pill">{{ 'ep.soon' | t }}</span>{% endunless %}{% endif %}{% else %}{% assign show_soon = true %}{% if has_stock == '1' %}{% assign show_soon = false %}{% endif %}{% render 'ep-soon', icon: icon, show_badge: show_soon %}{% endif %}