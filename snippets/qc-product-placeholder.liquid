{% doc %}Neutral illustration for products without photography, never a product photograph.
@param {product} product - Shopify product providing its type and vendor.{% enddoc %}
<div class="qc-product-placeholder" role="img" aria-label="{{ 'qc.image_pending' | t }}">
  <span class="qc-placeholder-vendor">{{ product.type | default: product.vendor | escape }}</span>
  {% if product.type contains 'Diaper' or product.type contains 'Pants' %}
    <svg viewBox="0 0 160 140" width="160" height="140" fill="none" aria-hidden="true"><path d="M30 31c25 8 75 8 100 0l8 31-17 43c-6 17-76 17-82 0L22 62Z" fill="currentColor" opacity=".08"/><path d="M30 31c25 8 75 8 100 0l8 31-17 43c-6 17-76 17-82 0L22 62Z" stroke="currentColor" stroke-width="3"/><path d="M28 52c30 10 74 10 104 0M44 68c19 4 19 31 12 47M116 68c-19 4-19 31-12 47M72 76l8 8 13-17" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><rect x="18" y="42" width="25" height="16" rx="6" fill="currentColor"/><rect x="117" y="42" width="25" height="16" rx="6" fill="currentColor"/></svg>
  {% else %}{% render 'qc-icon', name: 'bag' %}{% endif %}
  <small>{{ 'qc.image_pending' | t }}</small>
</div>
