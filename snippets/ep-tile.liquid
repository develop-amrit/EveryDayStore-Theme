{% doc %}
Shared category and store tile.
@param {string} title - Label.
@param {image} [image] - Merchant image.
@param {string} [link] - Destination.
@param {boolean} [wide] - Double-width tile.
@param {string} [background] - Optional tile colour.
@param {block} [block] - Editor block.
{% enddoc %}
<a class="ep-tile{% if wide %} ep-tile--wide{% endif %}"{% if link != blank %} href="{{ link }}"{% endif %}{% if background != blank %} style="--ep-tile-bg:{{ background }}"{% endif %}{% if block %} {{ block.shopify_attributes }}{% endif %}><span class="ep-tile-art">{% if image %}{% assign alt = image.alt | default: title %}{{ image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '90, 180, 270, 360', sizes: '(min-width:990px) 120px, 23vw', alt: alt }}{% elsif request.design_mode %}{{ 'collection-1' | placeholder_svg_tag }}{% else %}{% render 'qc-icon', name: 'bag' %}{% endif %}</span><span class="ep-tile-label">{{ title | escape }}</span></a>
