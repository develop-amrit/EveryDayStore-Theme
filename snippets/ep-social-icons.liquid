{% doc %}Footer social links, hidden when no merchant URL is configured.{% enddoc %}
{%- capture socials -%}
{%- assign networks = 'instagram,twitter,facebook,tiktok,linkedin,whatsapp' | split: ',' -%}
{%- for network in networks -%}{%- assign key = 'social_' | append: network | append: '_link' -%}{%- assign destination = settings[key] -%}{%- if destination != blank -%}<li><a href="{{ destination }}" rel="noopener">{% case network %}{% when 'linkedin' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h4v12H3Zm6 0h4v2c1-3 8-3 8 3v7h-4v-7c0-3-4-3-4 0v7H9Z"/></svg><span class="visually-hidden">{{ 'ep.linkedin' | t }}</span>{% when 'whatsapp' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 18a9 9 0 1 1 3 3l-5 1Z"/><path d="M8 7c-2 4 4 10 8 8l-2-3-2 1-2-2 1-2Z"/></svg><span class="visually-hidden">{{ 'ep.whatsapp' | t }}</span>{% else %}{% assign icon_file = 'icon-' | append: network | append: '.svg' %}{{ icon_file | inline_asset_content }}{% assign label_key = 'general.social.links.' | append: network %}<span class="visually-hidden">{{ label_key | t }}</span>{% endcase %}</a></li>{%- endif -%}{%- endfor -%}
{%- endcapture -%}{% if socials != blank %}<ul class="ep-social-list">{{ socials }}</ul>{% endif %}
