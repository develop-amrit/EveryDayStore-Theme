{% doc %}Delivery preference UI. Only a backend can reserve/enforce slot capacity.{% enddoc %}
<details class="qc-delivery-picker"><summary>{{ 'qc.delivery_preferences' | t }}</summary><form class="qc-form" data-delivery-form method="post" action="{{ routes.cart_url }}">{% if settings.slots_endpoint != blank or settings.qc_mock_slots %}<label>{{ 'qc.delivery_date' | t }}<input type="date" name="delivery_date" value="{{ cart.attributes.delivery_date | escape }}" data-delivery-date></label><label>{{ 'qc.delivery_slot' | t }}<select name="delivery_slot" data-delivery-slot disabled><option value="">{{ 'qc.slot_choose' | t }}</option></select></label><p class="qc-integration-note" data-slot-status>{% if settings.slots_endpoint == blank %}{{ 'qc.slot_disconnected' | t }}{% endif %}</p>{% endif %}<label>{{ 'qc.delivery_instructions' | t }}<textarea name="note" maxlength="500">{{ cart.note | escape }}</textarea></label><button type="submit" class="qc-button">{{ 'qc.delivery_save' | t }}</button><p role="status"></p></form></details>
