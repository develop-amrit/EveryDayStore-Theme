{% doc %}Stocked cart-collection recommendations, excluding products already in the basket.{% enddoc %}
{% assign selected = ',' %}{% for line in cart.items %}{% assign selected = selected | append: line.product_id | append: ',' %}{% endfor %}{% assign shown = 0 %}{% capture cards %}{% assign handles = '' %}{% for line in cart.items %}{% for source in line.product.collections %}{% assign handles = handles | append: source.handle | append: ',' %}{% endfor %}{% endfor %}{% assign handles = handles | append: 'all' | split: ',' | uniq %}{% for source_handle in handles %}{% if source_handle == blank %}{% continue %}{% endif %}{% assign source = collections[source_handle] %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign marker = candidate.id | prepend: ',' | append: ',' %}{% if selected contains marker %}{% continue %}{% endif %}{% render 'ep-card', product: candidate, variant: 'compact' %}{% assign selected = selected | append: candidate.id | append: ',' %}{% assign shown = shown | plus: 1 %}{% if shown >= 10 %}{% break %}{% endif %}{% endfor %}{% endpaginate %}{% if shown >= 10 %}{% break %}{% endif %}{% endfor %}{% endcapture %}<section class="ep-cart-suggestions" data-ep-cart-region="suggestions"{% if shown < 2 %} hidden{% endif %}><h2>{% if cart.item_count == 0 %}{{ 'eps.bestsellers' | t }}{% else %}{{ 'ep4.suggestions' | t }}{% endif %}</h2><div class="ep-rail">{{ cards }}</div></section>
