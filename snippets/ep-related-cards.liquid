{% doc %}Unique stocked department products, then real store-wide products.
@param {product} product - Product to exclude.
@param {collection} [fallback] - Merchant fallback collection.
{% enddoc %}
{% assign department = blank %}{% for parent in settings.qc_catalog_menu.links %}{% for source in product.collections %}{% if parent.object.id == source.id %}{% assign department = parent %}{% break %}{% endif %}{% for child in parent.links %}{% if child.object.id == source.id %}{% assign department = parent %}{% break %}{% endif %}{% for leaf in child.links %}{% if leaf.object.id == source.id %}{% assign department = parent %}{% break %}{% endif %}{% endfor %}{% if department != blank %}{% break %}{% endif %}{% endfor %}{% if department != blank %}{% break %}{% endif %}{% endfor %}{% if department != blank %}{% break %}{% endif %}{% endfor %}
{% assign fallback = fallback | default: collections.all %}{% capture handles %}{{ department.object.handle }}|{% for child in department.links %}{{ child.object.handle }}|{% for leaf in child.links %}{{ leaf.object.handle }}|{% endfor %}{% endfor %}{{ fallback.handle }}|{% for parent in settings.qc_catalog_menu.links %}{{ parent.object.handle }}|{% for child in parent.links %}{{ child.object.handle }}|{% for leaf in child.links %}{{ leaf.object.handle }}|{% endfor %}{% endfor %}{% endfor %}{% endcapture %}{% assign handles = handles | split: '|' | uniq %}{% assign shown = 0 %}{% capture seen %}|{{ product.id }}|{% endcapture %}
{% for handle in handles %}{% if shown == 8 %}{% break %}{% endif %}{% assign source = collections[handle] %}{% if source == blank %}{% continue %}{% endif %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% if shown == 8 %}{% break %}{% endif %}{% unless candidate.available %}{% continue %}{% endunless %}{% if candidate.tags contains 'homepage-hide' %}{% continue %}{% endif %}{% capture marker %}|{{ candidate.id }}|{% endcapture %}{% if seen contains marker %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% render 'ep-card', product: candidate, variant: 'compact' %}{% assign shown = shown | plus: 1 %}{% assign seen = seen | append: marker %}{% endfor %}{% endpaginate %}{% endfor %}
