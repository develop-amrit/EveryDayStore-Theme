{% doc %}Native collection facet and sort forms, progressively enhanced as sheets.
@param {collection} collection - Current filtered collection.
@param {number} active_count - Number of active filters.
@param {string} id - Section identifier.
@param {number} [count_override] - Native search result count.
{% enddoc %}
{% assign filter_url = collection.url | default: routes.search_url %}{% if request.page_type == 'search' %}{% assign query = search.terms | url_encode %}{% assign filter_url = filter_url | append: '?q=' | append: query %}{% endif %}{% capture visible_count %}{% if count_override != nil %}{{ count_override }}{% else %}{% render 'ep-visible-product-count', collection: collection, section: section %}{% endif %}{% endcapture %}<div class="ep-filter-bar">{% if template.suffix == 'ep-deals' %}<span class="ep-filter-chip">{{ 'eps.biggest_discount' | t }}</span>{% else %}<button type="button" class="ep-filter-chip" data-ep-sheet="ep-sort-{{ id }}">{{ 'epc.sort' | t }}{% assign selected_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}{% if option.value == selected_sort %}: {% case option.value %}{% when 'price-ascending' %}{{ 'epcf.price_up' | t }}{% when 'price-descending' %}{{ 'epcf.price_down' | t }}{% when 'title-ascending' %}A–Z{% when 'title-descending' %}Z–A{% when 'created-descending' %}{{ 'epcf.newest' | t }}{% when 'created-ascending' %}{{ 'epcf.oldest' | t }}{% else %}{{ option.name | escape }}{% endcase %}{% endif %}{% endfor %} {{ 'icon-caret.svg' | inline_asset_content }}</button>{% endif %}<button type="button" class="ep-filter-chip" data-ep-sheet="ep-filters-{{ id }}">{% render 'qc-icon', name: 'filter' %}{{ 'epc.filters' | t }}{% if active_count > 0 %}<span class="ep-filter-count">{{ active_count }}</span>{% endif %}</button><span class="ep-result-total">{{ 'epc.product_count' | t: count: visible_count }}</span></div>
<dialog class="ep-browse-sheet" id="ep-sort-{{ id }}" aria-labelledby="ep-sort-title-{{ id }}"><span class="ep-drag-handle" aria-hidden="true"></span><div class="ep-sheet-heading"><h2 id="ep-sort-title-{{ id }}">{{ 'epc.sort' | t }}</h2><button type="button" data-ep-sheet-close aria-label="{{ 'qc.close' | t }}">×</button></div><form method="get" action="{{ filter_url }}" data-ep-sort-form><input type="hidden" name="filter.v.availability" value="1">{% if request.page_type == 'search' %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product,page">{% endif %}{% if template.suffix == 'ep-deals' %}<input type="hidden" name="view" value="ep-deals">{% endif %}{% for filter in collection.filters %}{% unless filter.param_name == 'filter.v.availability' %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{% endfor %}{% endunless %}{% if filter.type == 'price_range' %}{% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{% endif %}{% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endif %}{% endif %}{% endfor %}{% assign selected_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<label class="ep-radio-row"><input type="radio" name="sort_by" value="{{ option.value }}"{% if option.value == selected_sort %} checked{% endif %}>{{ option.name | escape }}</label>{% endfor %}</form></dialog>
<dialog class="ep-browse-sheet" id="ep-filters-{{ id }}" aria-labelledby="ep-filter-title-{{ id }}"><span class="ep-drag-handle" aria-hidden="true"></span><div class="ep-sheet-heading"><h2 id="ep-filter-title-{{ id }}">{{ 'epc.filters' | t }}</h2><button type="button" data-ep-sheet-close aria-label="{{ 'qc.close' | t }}">×</button></div><form method="get" action="{{ filter_url }}" data-ep-filter-form><input type="hidden" name="filter.v.availability" value="1">{% if request.page_type == 'search' %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product,page">{% endif %}{% if template.suffix == 'ep-deals' %}<input type="hidden" name="view" value="ep-deals">{% endif %}<input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">{% for filter in collection.filters %}{% if filter.type == 'price_range' or filter.param_name == 'filter.p.vendor' or filter.param_name == 'filter.p.product_type' %}<fieldset><legend>{{ filter.label | escape }}</legend>{% if filter.type == 'price_range' %}<div class="ep-price-fields"><label>{{ 'qc.from' | t }}<input type="number" inputmode="decimal" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'qc.to' | t }}<input type="number" inputmode="decimal" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>{% else %}{% for value in filter.values %}<label class="ep-radio-row"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}>{{ value.label | escape }} <small>({{ value.count }})</small></label>{% endfor %}{% endif %}</fieldset>{% endif %}{% endfor %}<div class="ep-sheet-footer">{% if active_count > 0 %}<a data-ep-clear href="{% render 'ep-stock-url', url: filter_url %}">{{ 'epc.clear_filters' | t }}</a>{% endif %}<button class="ep-sheet-apply" type="submit" data-ep-result-count>{% if template.suffix == 'ep-deals' %}{{ 'eps.apply_filters' | t }}{% else %}{{ 'epc.show_results' | t: count: visible_count }}{% endif %}</button></div></form></dialog>
<noscript><form method="get" action="{{ filter_url }}"><input type="hidden" name="filter.v.availability" value="1"><label>{{ 'epc.sort' | t }}<select name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}">{{ option.name }}</option>{% endfor %}</select></label><button type="submit">{{ 'epc.apply_sort' | t }}</button></form>{% render 'qc-filters', results: collection %}</noscript>
