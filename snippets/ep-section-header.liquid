{% doc %}
Shared section heading.
@param {string} title - Heading text.
@param {string} [subtitle] - Supporting text.
@param {string} [link_url] - Optional destination.
@param {string} [link_label] - Optional label.
@param {string} [heading_id] - Accessible heading ID.
{% enddoc %}
<div class="ep-heading"><div><h2 id="{{ heading_id }}">{{ title | escape }}</h2>{% if subtitle != blank %}<p>{{ subtitle | escape }}</p>{% endif %}</div>{% if link_url != blank %}<a href="{% render 'ep-stock-url', url: link_url %}">{% if link_label != blank %}{{ link_label | escape }}{% else %}{{ 'ep.see_all' | t }}{% endif %}<span aria-hidden="true">&nbsp;›</span></a>{% endif %}</div>
