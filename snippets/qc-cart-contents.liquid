{% doc %}Shared cart contents for page and drawer, refreshed through Section Rendering API.{% enddoc %}
<div data-cart-render><div class="qc-cart-items">{% for item in cart.items %}<article class="qc-cart-item">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px' }}{% else %}{% render 'qc-product-placeholder', product: item.product %}{% endif %}<div><a href="{{ item.url }}">{{ item.product.metafields.custom.card_title.value | default: item.product.title | remove_first: '[TEST] ' | escape }}</a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% if item.product.metafields.custom.pack_size.value != blank %}<small>{{ item.product.metafields.custom.pack_size.value | escape }}</small>{% endif %}<strong>{% assign ep_money_amount = item.final_line_price %}{% render 'ep-money', amount: ep_money_amount %}</strong>{% for discount in item.line_level_discount_allocations %}<small>{{ discount.discount_application.title | escape }} (−{% assign ep_money_amount = discount.amount %}{% render 'ep-money', amount: ep_money_amount %})</small>{% endfor %}{% assign stock_limited = false %}{% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}{% assign stock_limited = true %}{% endif %}<div class="qc-stepper"{% if stock_limited %} data-max="{{ item.variant.inventory_quantity | at_least: 0 }}"{% endif %}><button type="button" data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'qc.decrease' | t }}">−</button><span>{{ item.quantity }}</span><button type="button" data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'qc.increase' | t }}"{% if stock_limited %} data-max="{{ item.variant.inventory_quantity | at_least: 0 }}"{% if item.quantity >= item.variant.inventory_quantity %} disabled aria-disabled="true"{% else %} aria-disabled="false"{% endif %}{% endif %}>+</button></div><button type="button" class="qc-remove" data-line-key="{{ item.key }}" data-quantity="0">{{ 'qc.remove' | t }}</button></div></article>{% else %}<div class="qc-empty">{% render 'qc-icon', name: 'bag' %}<h3>{{ 'qc.empty_cart' | t }}</h3><a href="{{ routes.collections_url }}" class="qc-button">{{ 'qc.continue' | t }}</a></div>{% endfor %}</div>
{% if cart.item_count > 0 %}{% capture fee %}{% render 'ep-delivery-fee', subtotal: cart.total_price %}{% endcapture %}{% assign fee = fee | plus: 0 %}{% render 'ep-delivery-progress', cart: cart %}
<p class="qc-basket-delivery">{% render 'qc-icon', name: 'truck' %}{{ 'qc.next_day_promise' | t }}</p><div class="qc-cart-total"><span>{{ 'qc.subtotal' | t }}</span><strong>{% assign ep_money_amount = cart.total_price %}{% render 'ep-money', amount: ep_money_amount %}</strong></div><div class="qc-cart-total qc-estimated-fee"><span>{{ 'qc.delivery_fee' | t }}</span><strong>{% if fee == 0 %}{{ 'epcf.free' | t }}{% else %}{% render 'ep-money', amount: fee %}{% endif %}</strong></div><div class="qc-cart-total qc-cart-estimate"><span>{{ 'qc.estimated_total' | t }}</span><strong>{% assign ep_money_amount = cart.total_price | plus: fee %}{% render 'ep-money', amount: ep_money_amount %}</strong></div><p class="qc-muted">{{ settings.qc_vat_note | escape }}. {{ 'qc.delivery_final' | t }}</p><div class="qc-cart-area">{% render 'qc-area-picker' %}</div>{% render 'qc-delivery-picker' %}<p class="qc-integration-note" data-zone-status></p>
<form action="{{ routes.cart_url }}" method="post" class="qc-checkout-form" data-checkout-form><label class="qc-checkout-terms"><input type="checkbox" name="attributes[terms_accepted]" value="yes" data-terms required><span>{{ 'qc.terms_prefix' | t }} {% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">{{ 'qc.terms_link' | t }}</a>{% else %}{{ 'qc.terms_link' | t }}{% endif %}</span></label><p class="qc-terms-error" role="status"></p><button name="checkout" class="qc-button qc-checkout">{{ 'qc.checkout' | t }} ↗</button></form><div class="qc-policy-links">{% render 'qc-policy-links' %}</div>{% endif %}</div>
