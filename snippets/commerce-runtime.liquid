<div class="dc-sticky-cart" data-sticky-cart {% if cart.item_count == 0 %}hidden{% endif %}>
  <button type="button" data-open-cart><span data-cart-count>{{ cart.item_count }}</span> {{ 'commerce_experience.items' | t }} · <strong data-cart-total>{% assign ep_money_amount = cart.total_price %}{% render 'ep-money', amount: ep_money_amount %}</strong><span>{{ 'commerce_experience.view_basket' | t }} →</span></button>
  <div class="dc-free-progress" role="progressbar" aria-label="{{ 'commerce_experience.free_progress' | t }}" aria-valuemin="0" aria-valuemax="9900" aria-valuenow="{{ cart.total_price | at_most: 9900 }}"><span data-progress-fill style="transform:scaleX({{ cart.total_price | times: 1.0 | divided_by: 9900 | at_most: 1 }})"></span></div>
  <p data-delivery-status aria-live="polite"></p>
</div>
<dialog class="dc-dialog" id="dc-dialog" aria-labelledby="dc-dialog-title"><div class="dc-dialog__heading"><h2 id="dc-dialog-title"></h2><button type="button" data-close-dialog aria-label="{{ 'accessibility.close' | t }}">×</button></div><div data-dialog-content></div></dialog>
<div class="dc-toast" role="status" hidden><span data-toast-message></span><button type="button" data-undo hidden>{{ 'commerce_experience.undo' | t }}</button></div>
<aside class="dc-cookie" aria-label="{{ 'commerce_experience.cookies' | t }}" hidden><p>{{ 'commerce_experience.cookie_copy' | t }} <a href="{{ pages['privacy'].url }}">{{ 'commerce_experience.privacy' | t }}</a></p><button type="button" data-consent="necessary">{{ 'commerce_experience.necessary' | t }}</button><button type="button" data-consent="all">{{ 'commerce_experience.accept_all' | t }}</button></aside>
<button class="dc-chat-launcher" type="button" data-feature="support">{% render 'commerce-icon', name: 'chat' %}<span>{{ 'commerce_experience.help' | t }}</span></button>
