{% doc %}Consent-based restock UI. A configured backend/app must store subscriptions and send alerts.
@param {product} product - The currently unavailable, explicitly retained product.{% enddoc %}
<details class="qc-notify"><summary>{{ 'qc.notify' | t }}</summary><form method="post" action="{{ settings.restock_endpoint | default: routes.root_url }}" class="qc-form" data-restock data-product-handle="{{ product.handle | escape }}" data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}"><label>{{ 'qc.email' | t }}<input type="email" name="email" required autocomplete="email"></label><label class="qc-check"><input type="checkbox" name="email_consent" required>{{ 'qc.email_consent' | t }}</label><label>{{ 'qc.phone' | t }}<input type="tel" name="phone" autocomplete="tel"></label><label class="qc-check"><input type="checkbox" name="phone_consent">{{ 'qc.phone_consent' | t }}</label><small>{{ 'qc.restock_details' | t }}</small><button class="qc-button"{% if settings.restock_endpoint == blank %} disabled{% endif %}>{{ 'qc.notify' | t }}</button><p role="status">{% if settings.restock_endpoint == blank %}{{ 'qc.restock_unconnected' | t }}{% endif %}</p><noscript>{{ 'qc.enable_js' | t }}</noscript></form></details>

