{% doc %}Visible dirham price, with an ISO name for screen readers.
@param {number} [amount] - Price in cents.
@param {number} [value] - Backward compatible price in cents.
@param {string} [class] - Optional CSS class.
{% enddoc %}
{%- assign cents = amount | default: value | default: 0 -%}
{%- capture formatted -%}{% render 'ep-money-number', amount: cents %}{%- endcapture -%}
<span class="ep-money {{ class | escape }}"><span class="ep-dh-slot" aria-hidden="true"><span class="ep-dh">&#x20C3;</span></span>&#x202F;<span class="visually-hidden">AED </span>{{ formatted }}</span>
