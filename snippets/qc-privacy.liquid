{% doc %}Consent recorded through Shopify Customer Privacy API only; no tracking scripts.{% enddoc %}
<aside class="qc-cookie-banner" data-cookie-banner aria-labelledby="qc-cookie-title"><h2 id="qc-cookie-title">{{ 'qc.cookie_title' | t }}</h2><p>{{ 'qc.cookie_text' | t }} <a href="{{ shop.privacy_policy.url | default: '/pages/privacy-policy' }}">{{ 'qc.privacy' | t }}</a></p><div class="qc-cookie-actions"><button type="button" data-cookie-accept>{{ 'qc.cookie_accept' | t }}</button><button type="button" data-cookie-reject>{{ 'qc.cookie_reject' | t }}</button><button type="button" data-cookie-manage>{{ 'qc.cookie_manage' | t }}</button></div><p role="status" data-cookie-status></p></aside>
<dialog id="qc-cookie-dialog" class="qc-variant-dialog" aria-labelledby="qc-cookie-manage-title"><div class="qc-dialog-heading"><h2 id="qc-cookie-manage-title">{{ 'qc.cookie_title' | t }}</h2><button type="button" data-dialog-close aria-label="{{ 'qc.close' | t }}">×</button></div><form class="qc-form" data-cookie-form method="post" action="{{ routes.root_url }}"><label class="qc-check"><input type="checkbox" name="analytics">{{ 'qc.cookie_analytics' | t }}</label><label class="qc-check"><input type="checkbox" name="marketing">{{ 'qc.cookie_marketing' | t }}</label><label class="qc-check"><input type="checkbox" name="preferences">{{ 'qc.cookie_preferences' | t }}</label><label class="qc-check"><input type="checkbox" name="sale_of_data">{{ 'qc.cookie_sale' | t }}</label><button class="qc-button">{{ 'qc.cookie_save' | t }}</button><p role="status"></p></form></dialog>
