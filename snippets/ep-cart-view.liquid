{% doc %}Cart page regions rendered from the same cart as the bundled drawer section.{% enddoc %}
{% assign product_savings = 0 %}{% assign unavailable = 0 %}{% for line in cart.items %}{% if line.variant.compare_at_price > line.original_price %}{% assign saved = line.variant.compare_at_price | minus: line.original_price | times: line.quantity %}{% assign product_savings = product_savings | plus: saved %}{% endif %}{% unless line.variant.available %}{% assign unavailable = unavailable | plus: 1 %}{% endunless %}{% endfor %}{% assign savings = product_savings | plus: cart.total_discount %}{% assign mrp_total = cart.original_total_price | plus: product_savings %}{% capture fee %}{% render 'ep-delivery-fee', subtotal: cart.total_price %}{% endcapture %}{% assign fee = fee | plus: 0 %}{% assign to_pay = cart.total_price | plus: fee %}
<div data-ep-cart-page-render data-count="{{ cart.item_count }}" data-unavailable="{{ unavailable }}" data-product-savings="{{ product_savings }}">
<div class="ep-cart-empty" data-ep-cart-region="empty"{% if cart.item_count > 0 %} hidden{% endif %}>{% render 'qc-icon', name: 'bag' %}<h2>{{ 'ep4.empty' | t }}</h2><a class="ep-cta" href="{{ routes.collections_url }}">{{ 'ep4.browse' | t }}</a></div>
<div data-ep-cart-populated{% if cart.item_count == 0 %} hidden{% endif %}>
<div class="ep-cart-saving" data-ep-cart-region="savings"{% if savings == 0 %} hidden{% endif %}>{% capture saving_amount %}{% render 'ep-money', amount: savings %}{% endcapture %}{{ 'ep4.saving_html' | t: amount: saving_amount }}</div>
<section class="ep-cart-card ep-cart-delivery"><h2>{{ 'qc.next_day_promise' | t }}</h2><div class="ep-cart-area"><span>{{ 'ep.delivering_to' | t }} <b data-ep-cart-area>{{ cart.attributes.delivery_zone | escape }}</b></span><button type="button" data-ep-cart-area-open>{{ 'ep4.change' | t }}</button></div><div data-ep-cart-region="progress">{% render 'ep-delivery-progress', cart: cart %}</div></section>
<section class="ep-cart-card ep-cart-lines" data-ep-cart-region="items"><h2>{{ 'ep4.basket' | t }}</h2>{% for line in cart.items %}<article class="ep-cart-line{% unless line.variant.available %} ep-unavailable{% endunless %}" data-ep-cart-line data-key="{{ line.key | escape }}" data-variant="{{ line.variant_id }}"{% if line.variant.inventory_management == 'shopify' and line.variant.inventory_policy == 'deny' %} data-max="{{ line.variant.inventory_quantity | at_least: 0 }}"{% endif %}><a class="ep-cart-thumbnail" href="{{ line.url }}">{% if line.image %}{{ line.image | image_url: width: 192 | image_tag: loading: 'eager', widths: '64, 128, 192', sizes: '64px', alt: line.product.title }}{% endif %}</a><div class="ep-cart-line-copy"><a href="{{ line.url }}">{{ line.product.title | escape }}</a><p>{% assign pack = line.product.metafields.custom.pack_size.value | default: line.variant.title %}{% unless pack == 'Default Title' %}{% render 'ep-pack-size', value: pack %}{% endunless %}</p><div class="ep-cart-line-price">{% render 'ep-money', amount: line.final_line_price %}{% if line.variant.compare_at_price > line.original_price %}<s>{% assign compare_line = line.variant.compare_at_price | times: line.quantity %}{% render 'ep-money', amount: compare_line %}</s>{% endif %}</div>{% unless line.variant.available %}<span class="ep-cart-stock-error">{{ 'ep4.out_of_stock' | t }}</span><button type="button" data-ep-cart-remove>{{ 'ep4.remove' | t }}</button>{% endunless %}</div><div class="ep-cart-line-stepper"><button type="button" data-ep-cart-quantity="{{ line.quantity | minus: 1 }}" aria-label="{{ 'ep4.decrease' | t }}">−</button><output>{{ line.quantity }}</output><button type="button" data-ep-cart-quantity="{{ line.quantity | plus: 1 }}" aria-label="{{ 'ep4.increase' | t }}"{% if line.variant.inventory_management == 'shopify' and line.variant.inventory_policy == 'deny' %} data-max="{{ line.variant.inventory_quantity | at_least: 0 }}"{% if line.quantity >= line.variant.inventory_quantity %} disabled aria-disabled="true"{% endif %}{% endif %}>+</button></div></article>{% endfor %}<div class="ep-cart-add-more">{{ 'ep4.more_items' | t }} <a href="{{ routes.collections_url }}">{{ 'ep4.add_more' | t }}</a></div></section>
</div>
{% render 'ep-cart-suggestions' %}
<div data-ep-cart-secondary{% if cart.item_count == 0 %} hidden{% endif %}>
<section class="ep-cart-card"><details class="ep-cart-coupon"><summary>{{ 'ep4.coupon' | t }}</summary><form data-ep-coupon><label class="visually-hidden" for="ep-coupon-code">{{ 'ep4.coupon' | t }}</label><input id="ep-coupon-code" name="discount" type="text" autocomplete="off"><button type="submit">{{ 'ep4.apply' | t }}</button></form></details><p data-ep-coupon-status role="status"></p><button type="button" data-ep-coupon-remove hidden>{{ 'ep4.remove' | t }}</button></section>
<section class="ep-cart-card ep-cart-bill" id="ep-cart-bill" tabindex="-1" data-ep-cart-region="bill"><h2>{{ 'ep4.bill' | t }}</h2><dl><div><dt>{{ 'ep4.item_total' | t }}</dt><dd>{% if mrp_total > cart.original_total_price %}<s>{% render 'ep-money', amount: mrp_total %}</s>{% endif %}<span data-ep-bill-item>{% render 'ep-money', amount: cart.original_total_price %}</span></dd></div>{% if product_savings > 0 %}<div class="ep-cart-green"><dt>{{ 'ep4.product_savings' | t }}</dt><dd>{% render 'ep-money', amount: product_savings %}</dd></div>{% endif %}{% if cart.total_discount > 0 %}<div class="ep-cart-green"><dt>{{ 'ep4.coupon_discount' | t }}</dt><dd>−{% render 'ep-money', amount: cart.total_discount %}</dd></div>{% endif %}<div><dt>{{ 'ep4.delivery_fee' | t }}</dt><dd data-ep-bill-fee>{% if fee == 0 %}<s>{% assign struck_fee = settings.qc_fee_mid | default: '3.99' | times: 100 | round %}{% render 'ep-money', amount: struck_fee %}</s><span class="ep-cart-green">{{ 'ep4.free' | t }}</span>{% else %}{% render 'ep-money', amount: fee %}{% endif %}</dd></div><div class="ep-cart-to-pay"><dt>{{ 'ep4.to_pay' | t }}</dt><dd data-ep-bill-pay>{% render 'ep-money', amount: to_pay %}</dd></div></dl><p>{% if cart.taxes_included %}{{ 'ep4.vat_included' | t }}{% else %}{{ 'ep4.vat_checkout' | t }}{% endif %} · {{ 'ep4.final_checkout' | t }}</p></section>
<section class="ep-cart-card"><h2>{{ 'ep4.instructions' | t }}</h2><div class="ep-cart-instruction-chips">{% assign instruction_keys = 'leave_door,avoid_call,no_bell,call_arrival,security' | split: ',' %}{% for key in instruction_keys %}{% assign translation = 'ep4.' | append: key %}{% assign instruction = translation | t %}<button type="button" data-ep-instruction="{{ instruction | escape }}" aria-pressed="{% if cart.attributes['Delivery instructions'] contains instruction %}true{% else %}false{% endif %}">{{ instruction }}</button>{% endfor %}</div><details><summary>{{ 'ep4.rider_note' | t }}</summary><label class="visually-hidden" for="ep-rider-note">{{ 'ep4.rider_note' | t }}</label><textarea id="ep-rider-note" rows="3" data-ep-rider-note>{{ cart.note | escape }}</textarea></details></section>
<section class="ep-cart-card ep-cart-payment"><h2>{{ 'ep4.payment_policy' | t }}</h2><ul class="ep-cart-payment-icons" role="list">{% for payment in shop.enabled_payment_types %}<li>{{ payment | payment_type_svg_tag }}</li>{% endfor %}</ul>{% if settings.qc_cod %}<p>{{ 'ep4.cod' | t }}</p>{% endif %}<nav class="ep-cart-policy-links"><a href="{{ pages['payment-options'].url }}">{{ 'ep4.payment_options' | t }}</a>{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'ep4.refund_policy' | t }}</a>{% endif %}{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'ep4.delivery_policy' | t }}</a>{% endif %}</nav><form action="{{ routes.cart_url }}" method="post" data-checkout-form class="ep-cart-checkout-form"><label class="ep-cart-terms" id="ep-cart-terms"><input type="checkbox" data-terms name="attributes[terms_accepted]" value="yes" required{% if cart.attributes.terms_accepted == 'yes' %} checked{% endif %}><span>{{ 'ep4.terms_prefix' | t }} {% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">{{ 'ep4.terms' | t }}</a>{% else %}{{ 'ep4.terms' | t }}{% endif %} {{ 'ep4.and' | t }} {% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'ep4.privacy' | t }}</a>{% else %}{{ 'ep4.privacy' | t }}{% endif %}</span></label><p class="qc-terms-error" role="status"></p><button type="submit" name="checkout" class="ep-cart-native-checkout">{{ 'ep4.checkout' | t }}</button></form></section>
</div>
<div class="ep-cart-sticky" data-ep-cart-region="sticky"{% if cart.item_count == 0 %} hidden{% endif %}><div><strong data-ep-sticky-total>{% render 'ep-money', amount: to_pay %}</strong><button type="button" data-ep-view-bill>{{ 'ep4.view_bill' | t }}</button></div><button class="ep-cart-checkout" type="button" data-ep-checkout>{% if unavailable > 0 %}{{ 'ep4.remove_unavailable' | t }}{% elsif cart.attributes.delivery_zone == blank %}{{ 'ep4.choose_area' | t }}{% else %}{{ 'ep4.checkout' | t }}{% endif %}</button></div>
</div>
