{% doc %}
Price from the selected Shopify variant.
@param {variant} item - Variant.
@param {boolean} [badge] - Render only the discount badge.
{% enddoc %}
{% assign discount = 0 %}{% if item.compare_at_price > item.price %}{% assign discount = item.compare_at_price | minus: item.price | times: 100.0 | divided_by: item.compare_at_price | floor %}{% endif %}
{% if badge %}{% if discount >= 5 %}<span class="ep-discount">{{ 'ep.discount' | t: amount: discount }}</span>{% endif %}{% else %}<div class="ep-price">{% if item.compare_at_price > item.price %}<strong class="ep-sale">{% if request.page_type == 'index' %}{% render 'ep-money', value: item.price %}{% else %}{{ item.price | money_without_trailing_zeros }}{% endif %}</strong><s><span class="visually-hidden">{{ 'ep.regular_price' | t }} </span>{% if request.page_type == 'index' %}{% render 'ep-money', value: item.compare_at_price %}{% else %}{{ item.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>{% else %}<strong>{% if request.page_type == 'index' %}{% render 'ep-money', value: item.price %}{% else %}{{ item.price | money_without_trailing_zeros }}{% endif %}</strong><span class="ep-compare-space" aria-hidden="true"></span>{% endif %}</div>{% endif %}
