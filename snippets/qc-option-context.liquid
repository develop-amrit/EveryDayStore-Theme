{% doc %}Option-value-based picker avoids enumerating a capped variant array.
@param {product} product - Current Shopify product.
@param {string} section_id - Section Rendering API context.{% enddoc %}
{% assign current_variant = product.selected_or_first_available_variant %}<div data-option-context><div data-main-price>{% render 'qc-variant-price', variant: current_variant %}</div><p class="qc-muted">{{ settings.qc_vat_note | escape }}</p><p>{% if product.metafields.custom.pack_size.value != blank %}{{ product.metafields.custom.pack_size.value | escape }}{% elsif current_variant.weight > 0 %}{{ current_variant.weight | weight_with_unit }}{% endif %}</p><p class="qc-delivery-chip">{% render 'qc-icon', name: 'truck' %}{{ 'qc.next_day_product' | t }}</p><small>{{ settings.qc_cutoff | escape }}</small>{% render 'qc-delivery-tiers' %}{% if settings.qc_bnpl %}<p class="qc-integration-note">{{ settings.qc_bnpl_text | escape }}</p>{% endif %}
<form class="qc-form" action="{{ routes.cart_add_url }}" method="post" data-main-product-form data-product-url="{{ product.url }}" data-section-id="{{ section_id }}"><input type="hidden" name="id" value="{{ current_variant.id }}">{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<label>{{ option.name | escape }}<select data-option-select data-option-position="{{ option.position }}">{% for value in option.values %}<option value="{{ value.id }}" data-product-url="{{ value.product_url }}"{% if value.selected %} selected{% endif %}>{{ value | escape }}{% unless value.available %} · {{ 'qc.out' | t }}{% endunless %}</option>{% endfor %}</select></label>{% endfor %}{% endunless %}<label>{{ 'qc.quantity' | t }}<input name="quantity" type="number" min="1" step="1" value="1" required></label><button class="qc-button" data-main-add{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'qc.add' | t }}{% else %}{{ 'qc.out' | t }}{% endif %}</button><p role="status"></p></form>{% if current_variant.featured_image %}<template data-variant-hero>{{ current_variant.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}</template>{% endif %}</div>
