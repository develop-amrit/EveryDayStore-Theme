{% doc %}Business fee tiers displayed from one setting source. Admin shipping rates remain authoritative.{% enddoc %}
{% assign lower = settings.qc_mid_threshold | default: 49 | times: 100 %}{% assign upper = settings.qc_free_delivery | default: 99 | times: 100 %}{% assign low_fee = settings.qc_fee_low | default: '5.99' | times: 100 | round %}{% assign middle_fee = settings.qc_fee_mid | default: '3.99' | times: 100 | round %}
{% assign lower_money = lower | money_without_currency | prepend: ' ' | prepend: shop.currency %}{% assign upper_money = upper | money_without_currency | prepend: ' ' | prepend: shop.currency %}{% assign low_money = low_fee | money_without_currency | prepend: ' ' | prepend: shop.currency %}{% assign middle_money = middle_fee | money_without_currency | prepend: ' ' | prepend: shop.currency %}
{% if request.page_type == 'index' %}{% capture lower_money %}{% render 'ep-money', value: lower %}{% endcapture %}{% capture upper_money %}{% render 'ep-money', value: upper %}{% endcapture %}{% capture low_money %}{% render 'ep-money', value: low_fee %}{% endcapture %}{% capture middle_money %}{% render 'ep-money', value: middle_fee %}{% endcapture %}{% endif %}<ul class="qc-fee-tiers" role="list"><li>{{ 'qc.delivery_below' | t: threshold: lower_money, fee: low_money }}</li><li>{{ 'qc.delivery_middle' | t: threshold: lower_money, fee: middle_money }}</li><li>{{ 'qc.delivery_free' | t: threshold: upper_money }}</li></ul>
