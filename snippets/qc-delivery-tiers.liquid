{% doc %}Business fee tiers displayed from one setting source. Admin shipping rates remain authoritative.{% enddoc %}
{% assign lower = settings.qc_mid_threshold | default: 49 | times: 100 %}{% assign upper = settings.qc_free_delivery | default: 99 | times: 100 %}{% assign low_fee = settings.qc_fee_low | default: '5.99' | times: 100 | round %}{% assign middle_fee = settings.qc_fee_mid | default: '3.99' | times: 100 | round %}
{% capture lower_money %}{% assign ep_money_amount = lower %}{% render 'ep-money', amount: ep_money_amount %}{% endcapture %}{% capture upper_money %}{% assign ep_money_amount = upper %}{% render 'ep-money', amount: ep_money_amount %}{% endcapture %}{% capture low_money %}{% assign ep_money_amount = low_fee %}{% render 'ep-money', amount: ep_money_amount %}{% endcapture %}{% capture middle_money %}{% assign ep_money_amount = middle_fee %}{% render 'ep-money', amount: ep_money_amount %}{% endcapture %}
<ul class="qc-fee-tiers" role="list"><li>{{ 'qc.delivery_below_html' | t: threshold: lower_money, fee: low_money }}</li><li>{{ 'qc.delivery_middle_html' | t: threshold: lower_money, fee: middle_money }}</li><li>{{ 'qc.delivery_free_html' | t: threshold: upper_money }}</li></ul>
