{% doc %}Compute a genuine starting price from the configured collection’s products.
@param {string} [exclude_tags] - Homepage exclusions.
@param {collection} collection - Source collection.
{% enddoc %}
{% if collection.all_products_count > 0 %}{% assign minimum_price = blank %}{% assign excluded_tags = exclude_tags | split: ',' %}{% for product in collection.products %}{% capture ep_visible %}{% render 'ep-content-visible', item: product %}{% endcapture %}{% if ep_visible == '0' %}{% continue %}{% endif %}{% assign excluded = false %}{% for tag in excluded_tags %}{% assign cleaned_tag = tag | strip %}{% if cleaned_tag != blank and product.tags contains cleaned_tag %}{% assign excluded = true %}{% endif %}{% endfor %}{% if excluded %}{% continue %}{% endif %}{% if minimum_price == blank or product.price_min < minimum_price %}{% assign minimum_price = product.price_min %}{% endif %}{% endfor %}{% if minimum_price != blank %}{% capture price %}{% render 'ep-money', value: minimum_price %}{% endcapture %}<span class="ep-from-price">{{ 'ep.from_price_html' | t: price: price }}</span>{% endif %}{% endif %}