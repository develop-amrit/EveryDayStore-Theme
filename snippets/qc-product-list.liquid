{% doc %}@param {collection} collection - Source collection.
@param {number} limit - Maximum visible products.{% enddoc %}
{% assign shown = 0 %}{% if collection != blank %}{% for product in collection.products limit: 50 %}{% if product.available or product.metafields.custom.show_when_sold_out.value == true %}{% render 'qc-product-card', product: product %}{% assign shown = shown | plus: 1 %}{% if shown >= limit %}{% break %}{% endif %}{% endif %}{% endfor %}{% endif %}{% if shown == 0 %}<div class="qc-empty"><div class="qc-empty-art">{{ 'product-1' | placeholder_svg_tag: 'qc-placeholder' }}</div><h3>{{ 'qc.empty_collection' | t }}</h3><p>{{ 'qc.empty_collection_help' | t }}</p>{% unless collection.handle == 'all' %}<a class="qc-text-link" href="{{ routes.collections_url }}">{{ 'qc.choose_products' | t }}</a>{% endunless %}{% if request.design_mode %}<p>{{ 'qc.empty_hint' | t }}</p>{% endif %}</div>{% endif %}
