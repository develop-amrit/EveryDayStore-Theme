{% doc %}Theme safety net for merchant-marked internal content. Emits 1 or 0.
@param {object} item - Product or collection.
@param {string} [kind] - collection for handle exclusions.
@param {string} [hide_prefix] - Optional section prefix, blank disables.
@param {string} [hidden_handles] - Optional collection handles.
@param {string} [title] - Link label fallback.
@param {string} [handle] - Link handle fallback.
{% enddoc %}
{%- assign prefix = hide_prefix -%}{%- if prefix == nil -%}{%- assign prefix = settings.ep_hidden_title_prefix -%}{%- endif -%}
{%- assign label = item.title | default: title -%}{%- assign start = label | slice: 0, prefix.size -%}
{%- assign visible = true -%}{%- if prefix != blank and start == prefix -%}{%- assign visible = false -%}{%- endif -%}
{%- if kind == 'collection' -%}{%- assign handles = hidden_handles -%}{%- if handles == nil -%}{%- assign handles = settings.ep_hidden_collection_handles -%}{%- endif -%}{%- assign handle_value = item.handle | default: handle -%}{%- assign list = handles | newline_to_br | replace: '<br />', ',' | split: ',' -%}{%- for value in list -%}{%- assign value = value | strip -%}{%- if value != blank and value == handle_value -%}{%- assign visible = false -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- if visible -%}1{%- else -%}0{%- endif -%}
