{% doc %}Cart subtotal shared by navigation pages and collection listings.{% enddoc %}
{% unless request.page_type == 'cart' %}<ep-cart-pill class="ep-cart-pill" data-one="{{ 'epc.cart_one' | t }}" data-many="{{ 'epc.cart_many' | t }}"{% if cart.item_count == 0 %} hidden{% endif %}><a href="{% render 'ep-stock-url', url: routes.cart_url %}"{% unless settings.cart_type == 'page' %} data-cart-open{% endunless %}>{% render 'qc-icon', name: 'cart' %}<strong data-ep-pill-label>{{ 'epc.cart_many' | t | replace: '__COUNT__', cart.item_count }}</strong><span data-ep-pill-total>{% render 'ep-money', amount: cart.total_price %}</span><span aria-hidden="true">›</span></a></ep-cart-pill>{% endunless %}
