{% doc %}Grocery vendors from unique available products across the configured department tree.
@param {collection} department - Grocery department.
@param {link[]} links - Department child links.
@param {section} section - Merchant brand overrides.
{% enddoc %}
{% capture handles %}{{ department.handle }}|{% for child in links %}{{ child.object.handle }}|{% for leaf in child.links %}{{ leaf.object.handle }}|{% endfor %}{% endfor %}{% endcapture %}
{% assign handles = handles | split: '|' | uniq %}{% assign eligible = '' | split: ',' %}{% assign seen = '|' %}
{% for handle in handles %}{% assign source = collections[handle] %}{% if source != blank %}{% paginate source.products by 250 %}{% for candidate in source.products %}{% unless candidate.available %}{% continue %}{% endunless %}{% capture marker %}|{{ candidate.id }}|{% endcapture %}{% if seen contains marker %}{% continue %}{% endif %}{% capture allowed %}{% render 'ep-content-visible', item: candidate, hide_prefix: section.settings.hide_title_prefix %}{% endcapture %}{% if allowed == '0' %}{% continue %}{% endif %}{% assign single = source.products | where: 'id', candidate.id %}{% assign eligible = eligible | concat: single %}{% assign seen = seen | append: marker %}{% endfor %}{% endpaginate %}{% endif %}{% endfor %}
{% assign overrides = section.blocks | where: 'type', 'brand_slide' %}
{% capture slides %}{% if overrides.size > 0 %}{% for brand in overrides limit: 8 %}{% assign vendor_key = brand.settings.vendor | strip | downcase %}{% assign count = 0 %}{% for candidate in eligible %}{% assign key = candidate.vendor | strip | downcase %}{% if key == vendor_key %}{% assign count = count | plus: 1 %}{% endif %}{% endfor %}{% if count > 0 %}{% render 'ep-grocery-brand-slide', vendor: brand.settings.vendor, vendor_key: vendor_key, products: eligible, count: count, image: brand.settings.image, index: forloop.index0 %}{% endif %}{% endfor %}{% else %}
{% assign vendors_seen = '|' %}{% capture ranks %}{% for candidate in eligible %}{% assign key = candidate.vendor | strip | downcase %}{% if key == blank %}{% continue %}{% endif %}{% capture marker %}|{{ key }}|{% endcapture %}{% if vendors_seen contains marker %}{% continue %}{% endif %}{% assign vendors_seen = vendors_seen | append: marker %}{% assign count = 0 %}{% for other in eligible %}{% assign other_key = other.vendor | strip | downcase %}{% if other_key == key %}{% assign count = count | plus: 1 %}{% endif %}{% endfor %}{% assign rank = 99999 | minus: count | prepend: '00000' | slice: -5, 5 %}{{ rank }}~{{ key | replace: '|', '' | replace: '~', '' }}~{{ candidate.handle }}|{% endfor %}{% endcapture %}{% assign ranks = ranks | split: '|' | sort %}
{% assign rendered = 0 %}{% for rank in ranks %}{% if rank == blank %}{% continue %}{% endif %}{% if rendered == 8 %}{% break %}{% endif %}{% assign pieces = rank | split: '~' %}{% assign representative = eligible | where: 'handle', pieces.last | first %}{% assign vendor_key = representative.vendor | strip | downcase %}{% assign count = pieces.first | plus: 0 %}{% assign count = 99999 | minus: count %}{% render 'ep-grocery-brand-slide', vendor: representative.vendor, vendor_key: vendor_key, products: eligible, count: count, index: rendered %}{% assign rendered = rendered | plus: 1 %}{% endfor %}
{% endif %}{% endcapture %}{% assign slides = slides | strip %}{% assign count = slides | split: 'data-grocery-slide' | size | minus: 1 %}
{% if count > 0 %}<ep-grocery-carousel class="ep-grocery-carousel" role="region" aria-roledescription="{{ 'ep6.carousel' | t }}" aria-label="{{ 'ep6.grocery_brands' | t }}"><div class="ep-grocery-slides" data-grocery-track>{{ slides }}</div>{% if count > 1 %}<div class="ep-grocery-dots">{% for i in (1..count) %}<button type="button" data-grocery-dot="{{ forloop.index0 }}" aria-label="{{ 'ep6.slide_number' | t: number: i, count: count }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>{% endfor %}</div><button type="button" class="ep-grocery-pause" data-grocery-pause data-pause="{{ 'ep6.pause' | t }}" data-play="{{ 'ep6.play' | t }}" aria-pressed="false">{{ 'ep6.pause' | t }}</button>{% endif %}</ep-grocery-carousel>{% endif %}
