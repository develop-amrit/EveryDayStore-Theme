{%- doc -%}Real in-stock cards from up to 250 department products, with child-collection fallback.
@param {collection} collection - Primary source.
@param {number} limit - Maximum cards.
@param {string} [hide_prefix] - Section internal-title prefix override.
@param {string} [hidden_handles] - Child collection exclusions.
@param {string} [variant] - Card variant.
@param {linklist} [menu] - Department menu.
@param {string} [exclude_tags] - Merchant tags to exclude.
@param {boolean} [discounted] - Require a real compare-at discount.
@param {number} [exclude_id] - Current product to omit.
{%- enddoc -%}
{%- assign shown = 0 -%}{%- assign selected = ',' -%}{%- assign excluded_tags = exclude_tags | default: 'homepage-hide' | split: ',' -%}{%- assign catalogue = menu | default: settings.qc_catalog_menu -%}
{%- if collection != blank -%}{%- paginate collection.products by 250 -%}{%- for candidate in collection.products limit: 250 -%}
{%- unless candidate.available -%}{%- continue -%}{%- endunless -%}{%- if discounted -%}{%- assign item = candidate.selected_or_first_available_variant -%}{%- unless item.compare_at_price > item.price -%}{%- continue -%}{%- endunless -%}{%- endif -%}{%- if candidate.id == exclude_id -%}{%- continue -%}{%- endif -%}
{%- capture allowed -%}{% render 'ep-content-visible', item: candidate, hide_prefix: hide_prefix %}{%- endcapture -%}{%- if allowed == '0' -%}{%- continue -%}{%- endif -%}
{%- assign excluded = false -%}{%- for tag in excluded_tags -%}{%- assign tag = tag | strip -%}{%- if tag != blank and candidate.tags contains tag -%}{%- assign excluded = true -%}{%- endif -%}{%- endfor -%}{%- if excluded -%}{%- continue -%}{%- endif -%}
{%- assign eager = false -%}{%- if shown < 6 -%}{%- assign eager = true -%}{%- endif -%}{% render 'ep-card', product: candidate, variant: variant, eager: eager %}{%- assign shown = shown | plus: 1 -%}{%- assign selected = selected | append: candidate.id | append: ',' -%}{%- if shown >= limit -%}{%- break -%}{%- endif -%}
{%- endfor -%}{%- endpaginate -%}{%- endif -%}
{%- if shown < 4 -%}{%- assign children = blank -%}{%- for parent in catalogue.links -%}{%- if parent.object.id == collection.id -%}{%- assign children = parent.links -%}{%- endif -%}{%- for child in parent.links -%}{%- if child.object.id == collection.id -%}{%- assign children = parent.links -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
{%- for child in children -%}{%- if child.type != 'collection_link' -%}{%- continue -%}{%- endif -%}{%- capture allowed -%}{% render 'ep-content-visible', item: child.object, kind: 'collection', hide_prefix: hide_prefix, hidden_handles: hidden_handles %}{%- endcapture -%}{%- if allowed == '0' -%}{%- continue -%}{%- endif -%}
{%- paginate child.object.products by 250 -%}{%- for candidate in child.object.products limit: 250 -%}
{%- unless candidate.available -%}{%- continue -%}{%- endunless -%}{%- if discounted -%}{%- assign item = candidate.selected_or_first_available_variant -%}{%- unless item.compare_at_price > item.price -%}{%- continue -%}{%- endunless -%}{%- endif -%}{%- if candidate.id == exclude_id -%}{%- continue -%}{%- endif -%}{%- assign marker = candidate.id | prepend: ',' | append: ',' -%}{%- if selected contains marker -%}{%- continue -%}{%- endif -%}
{%- capture allowed -%}{% render 'ep-content-visible', item: candidate, hide_prefix: hide_prefix %}{%- endcapture -%}{%- if allowed == '0' -%}{%- continue -%}{%- endif -%}{%- assign excluded = false -%}{%- for tag in excluded_tags -%}{%- assign tag = tag | strip -%}{%- if tag != blank and candidate.tags contains tag -%}{%- assign excluded = true -%}{%- endif -%}{%- endfor -%}{%- if excluded -%}{%- continue -%}{%- endif -%}
{%- assign eager = false -%}{%- if shown < 6 -%}{%- assign eager = true -%}{%- endif -%}{% render 'ep-card', product: candidate, variant: variant, eager: eager %}{%- assign shown = shown | plus: 1 -%}{%- assign selected = selected | append: candidate.id | append: ',' -%}{%- if shown >= limit -%}{%- break -%}{%- endif -%}
{%- endfor -%}{%- endpaginate -%}{%- if shown >= limit -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
