{% doc %}Accessible delivery area sheet preserving the existing cart attribute and local storage key.
@param {string} areas - Newline separated areas.
@param {string} delivery_text - Delivery promise.
@param {string} picker_id - Unique section identifier.
{% enddoc %}
{% assign area_lines = areas | newline_to_br | split: '<br />' %}<ep-area-picker data-initial="{{ cart.attributes.delivery_zone | escape }}" data-toast="{{ 'ep.area_toast' | t: area: '__AREA__' | escape }}" data-no-match="{{ 'ep.area_no_match' | t: query: '__QUERY__' | escape }}"><button type="button" class="ep-area-trigger" aria-haspopup="dialog" aria-controls="ep-area-{{ picker_id }}">{% render 'qc-icon', name: 'truck' %}<span><strong>{{ delivery_text | escape }}</strong><span class="ep-area-line"><span data-area-prefix{% if cart.attributes.delivery_zone == blank %} hidden{% endif %}>{{ 'ep.delivering_to' | t }} </span><b data-area-name>{{ cart.attributes.delivery_zone | default: '' | escape }}</b><span data-area-empty{% if cart.attributes.delivery_zone != blank %} hidden{% endif %}>{{ 'ep.choose_area' | t }}</span>{{ 'icon-caret.svg' | inline_asset_content }}</span></span></button><dialog id="ep-area-{{ picker_id }}" class="ep-area-dialog" aria-modal="true" aria-labelledby="ep-area-title-{{ picker_id }}"><span class="ep-drag-handle" aria-hidden="true"></span><div class="ep-area-heading"><h2 id="ep-area-title-{{ picker_id }}">{{ 'ep.area_title' | t }}</h2><button type="button" data-area-close aria-label="{{ 'qc.close' | t }}">×</button></div><label class="visually-hidden" for="ep-area-search-{{ picker_id }}">{{ 'ep.area_search' | t }}</label><input type="search" id="ep-area-search-{{ picker_id }}" data-area-filter placeholder="{{ 'ep.area_search' | t }}" autocomplete="off"><div class="ep-area-list" role="group" aria-label="{{ 'qc.select_area' | t }}">{% for area in area_lines %}{% assign name = area | strip %}{% if name != blank %}<button type="button" data-area-option="{{ name | escape }}" aria-pressed="{% if cart.attributes.delivery_zone == name %}true{% else %}false{% endif %}"><span>{{ name | escape }}</span><span class="ep-area-tick" aria-hidden="true"></span></button>{% endif %}{% endfor %}</div><div data-area-unlisted hidden><p data-area-no-match></p>{% if settings.social_whatsapp_link != blank %}<a href="{{ settings.social_whatsapp_link }}">{{ 'ep.contact_us' | t }}</a>{% endif %}</div><p class="ep-area-note">{{ 'ep.area_note' | t }}</p><p role="alert" data-area-error></p></dialog><p class="ep-area-toast" role="status" hidden></p><noscript><form action="{{ routes.cart_update_url }}" method="post"><label>{{ 'qc.select_area' | t }}<select name="attributes[delivery_zone]">{% for area in area_lines %}{% assign name = area | strip %}<option{% if cart.attributes.delivery_zone == name %} selected{% endif %}>{{ name | escape }}</option>{% endfor %}</select></label><button>{{ 'general.save' | t }}</button></form></noscript></ep-area-picker>