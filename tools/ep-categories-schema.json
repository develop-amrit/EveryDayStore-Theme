{
  "name": "t:epc.categories_section",
  "tag": "div",
  "settings": [
    {
      "type": "link_list",
      "id": "catalogue_menu",
      "label": "t:epc.catalogue_menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:ep.colour_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:ep.top_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:ep.bottom_padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_coming_soon",
      "label": "t:ep.final_show_coming_soon_for_empty_collections",
      "default": true
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "t:ep.polish_exclude_products_tagged",
      "default": "homepage-hide"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:ep.category_group",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:ep.heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:ep.category_menu"
        },
        {
          "type": "collection",
          "id": "department",
          "label": "t:ep.department_source"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.see_all_link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:ep.polish_parent_category_icon",
          "options": [
            {
              "value": "basket",
              "label": "t:ep.polish_basket"
            },
            {
              "value": "bottle",
              "label": "t:ep.polish_bottle"
            },
            {
              "value": "gift",
              "label": "t:ep.polish_gift"
            },
            {
              "value": "soap",
              "label": "t:ep.polish_soap"
            },
            {
              "value": "home",
              "label": "t:ep.polish_home"
            },
            {
              "value": "paw",
              "label": "t:ep.polish_paw"
            },
            {
              "value": "pencil",
              "label": "t:ep.polish_pencil"
            }
          ],
          "default": "basket"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "t:ep.polish_coming_soon_tint",
          "options": [
            {
              "value": "blue",
              "label": "t:ep.polish_blue"
            },
            {
              "value": "cream",
              "label": "t:ep.polish_cream"
            },
            {
              "value": "green",
              "label": "t:ep.polish_green"
            },
            {
              "value": "pink",
              "label": "t:ep.polish_pink"
            },
            {
              "value": "lilac",
              "label": "t:ep.polish_lilac"
            },
            {
              "value": "peach",
              "label": "t:ep.polish_peach"
            }
          ],
          "default": "cream"
        }
      ]
    },
    {
      "type": "image_override",
      "name": "t:ep.tile_image_override",
      "settings": [
        {
          "type": "text",
          "id": "group_heading",
          "label": "t:ep.target_group_heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:ep.target_link_url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:ep.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:epc.categories_section",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "heading": "Baby Products",
            "menu": "catalogue",
            "department": "baby-products",
            "link": "/collections/baby-products",
            "icon": "bottle",
            "tint": "blue"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Gifting",
            "menu": "catalogue",
            "department": "gifting",
            "link": "/collections/gifting",
            "icon": "gift",
            "tint": "cream"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Grocery",
            "menu": "catalogue",
            "department": "grocery",
            "link": "/collections/grocery",
            "icon": "basket",
            "tint": "green"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Bath & Body",
            "menu": "catalogue",
            "department": "bath-and-body",
            "link": "/collections/bath-and-body",
            "icon": "soap",
            "tint": "pink"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Home",
            "menu": "catalogue",
            "department": "home",
            "link": "/collections/home",
            "icon": "home",
            "tint": "lilac"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Pet",
            "menu": "catalogue",
            "department": "pet",
            "link": "/collections/pet",
            "icon": "paw",
            "tint": "peach"
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Office Supplies",
            "menu": "catalogue",
            "department": "office-supplies",
            "link": "/collections/office-supplies",
            "icon": "pencil",
            "tint": "cream"
          }
        }
      ]
    }
  ]
}