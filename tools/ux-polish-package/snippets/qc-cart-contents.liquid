{% doc %}Shared cart contents for page and drawer, refreshed through Section Rendering API.{% enddoc %}
<div data-cart-render><div class="qc-cart-items">{% for item in cart.items %}<article class="qc-cart-item">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px' }}{% else %}{% render 'qc-product-placeholder', product: item.product %}{% endif %}<div><a href="{{ item.url }}">{{ item.product.metafields.custom.card_title.value | default: item.product.title | remove_first: '[TEST] ' | escape }}</a>{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}{% if item.product.metafields.custom.pack_size.value != blank %}<small>{{ item.product.metafields.custom.pack_size.value | escape }}</small>{% endif %}<strong>{{ item.final_line_price | money_without_currency | prepend: ' ' | prepend: shop.currency }}</strong>{% for discount in item.line_level_discount_allocations %}<small>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money_without_currency | prepend: ' ' | prepend: shop.currency }})</small>{% endfor %}<div class="qc-stepper"><button type="button" data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'qc.decrease' | t }}">−</button><span>{{ item.quantity }}</span><button type="button" data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'qc.increase' | t }}">+</button></div><button type="button" class="qc-remove" data-line-key="{{ item.key }}" data-quantity="0">{{ 'qc.remove' | t }}</button></div></article>{% else %}<div class="qc-empty">{% render 'qc-icon', name: 'bag' %}<h3>{{ 'qc.empty_cart' | t }}</h3><a href="{{ routes.all_products_collection_url }}" class="qc-button">{{ 'qc.continue' | t }}</a></div>{% endfor %}</div>
{% if cart.item_count > 0 %}{% assign lower = settings.qc_mid_threshold | default: 49 | times: 100 %}{% assign upper = settings.qc_free_delivery | default: 99 | times: 100 %}{% assign fee = settings.qc_fee_low | default: '5.99' | times: 100 | round %}{% if cart.total_price >= upper %}{% assign fee = 0 %}{% elsif cart.total_price >= lower %}{% assign fee = settings.qc_fee_mid | default: '3.99' | times: 100 | round %}{% endif %}
{% if upper > 0 %}{% assign progress = cart.total_price | times: 100.0 | divided_by: upper | at_most: 100 %}<div class="qc-free-delivery">{% if cart.total_price >= upper %}<p>{{ 'qc.free' | t }}</p>{% else %}{% assign remaining = upper | minus: cart.total_price | money_without_currency | prepend: ' ' | prepend: shop.currency %}<p>{{ 'qc.until_free' | t: amount: remaining }}</p>{% endif %}<div class="qc-progress" role="progressbar" aria-label="{{ 'qc.free' | t }}" aria-valuenow="{{ progress | round }}" aria-valuemin="0" aria-valuemax="100"><span style="transform:scaleX({{ progress | divided_by: 100.0 }})"></span></div>{% if cart.total_price < lower %}{% assign next_remaining = lower | minus: cart.total_price | money_without_currency | prepend: ' ' | prepend: shop.currency %}{% assign middle_fee = settings.qc_fee_mid | default: '3.99' | times: 100 | round | money_without_currency | prepend: ' ' | prepend: shop.currency %}<p>{{ 'qc.free_next_tier' | t: amount: next_remaining, fee: middle_fee }}</p>{% endif %}</div>{% endif %}
<p class="qc-basket-delivery">{% render 'qc-icon', name: 'truck' %}{{ 'qc.next_day_promise' | t }}</p><div class="qc-cart-total"><span>{{ 'qc.subtotal' | t }}</span><strong>{{ cart.total_price | money_without_currency | prepend: ' ' | prepend: shop.currency }}</strong></div><div class="qc-cart-total qc-estimated-fee"><span>{{ 'qc.delivery_fee' | t }}</span><strong>{{ fee | money_without_currency | prepend: ' ' | prepend: shop.currency }}</strong></div><div class="qc-cart-total qc-cart-estimate"><span>{{ 'qc.estimated_total' | t }}</span><strong>{{ cart.total_price | plus: fee | money_without_currency | prepend: ' ' | prepend: shop.currency }}</strong></div><p class="qc-muted">{{ settings.qc_vat_note | escape }}. {{ 'qc.delivery_final' | t }}</p><div class="qc-cart-area">{% render 'qc-area-picker' %}</div>{% render 'qc-delivery-picker' %}<p class="qc-integration-note" data-zone-status></p>
<form action="{{ routes.cart_url }}" method="post" class="qc-checkout-form" data-checkout-form><label class="qc-checkout-terms"><input type="checkbox" name="attributes[terms_accepted]" value="yes" data-terms required><span>{{ 'qc.terms_prefix' | t }} <a href="{{ shop.terms_of_service.url | default: '/pages/terms-conditions' }}">{{ 'qc.terms_link' | t }}</a></span></label><p class="qc-terms-error" role="status"></p><button name="checkout" class="qc-button qc-checkout">{{ 'qc.checkout' | t }} ↗</button></form><div class="qc-policy-links">{% render 'qc-policy-links' %}</div>{% endif %}</div>
